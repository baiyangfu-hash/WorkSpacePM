TEST_CASE "TC_Interlock_SafetyDoor"
    SET GlobalVars.stGlobal.bPowerOn := TRUE;
    SET GlobalVars.stGlobal.bSafetyLight := FALSE;
    WAIT_CYCLES 2;
    ASSERT GlobalVars.stGlobal.bSafetyLight = FALSE;
END_TEST_CASE
