# Taskfile - 常用任务集合
# 使用方式: 安装 go-task (https://taskfile.dev) 后执行 task --list
# 也可直接使用对应命令，Taskfile 仅作便捷入口

version: "3"

tasks:
  default:
    desc: 列出所有可用任务
    cmds:
      - task --list

  install:
    desc: 开发模式安装（含 dev 依赖）
    cmds:
      - pip install -e ".[dev]"

  test:
    desc: 运行测试套件
    cmds:
      - pytest

  test-cov:
    desc: 运行测试并生成覆盖率报告
    cmds:
      - pytest --cov-report=html:coverage/html --cov-report=term

  lint:
    desc: 代码检查（ruff）
    cmds:
      - ruff check .

  format:
    desc: 代码格式化（ruff format）
    cmds:
      - ruff format .

  typecheck:
    desc: 类型检查（mypy）
    cmds:
      - mypy {{ package_name }}

  check:
    desc: 综合检查（lint + typecheck + test）
    cmds:
      - task lint
      - task typecheck
      - task test

  pre-commit:
    desc: 安装 pre-commit hooks
    cmds:
      - pre-commit install

  pre-commit-run:
    desc: 运行 pre-commit（所有文件）
    cmds:
      - pre-commit run --all-files
