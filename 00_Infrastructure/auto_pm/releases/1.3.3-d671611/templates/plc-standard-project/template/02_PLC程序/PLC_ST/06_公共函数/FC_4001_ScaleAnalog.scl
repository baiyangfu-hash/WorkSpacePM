// ============================================================================
// FC_4001_ScaleAnalog.scl - 模拟量原始值换算为工程量 (最小示例)
// ============================================================================
// 描述:
//   把模拟量输入模块的原始值 (0..27648, 对应标准 0..10V 或 4..20mA) 线性换算为工程量.
//   纯函数: 只读输入参数、只返回结果, 不读写任何全局变量, 与调用者零耦合.
//   这是模板自带的 FC 示例, 默认没有被任何块调用; 需要时在工位 FB 内部调用.
// ============================================================================

FUNCTION FC_4001_ScaleAnalog : REAL

VAR_INPUT
    i_iRawValue     : INT;      // 模拟量模块原始值 (0..27648)
    i_rEngLow       : REAL;     // 工程量下限 (原始值 0 对应)
    i_rEngHigh      : REAL;     // 工程量上限 (原始值 27648 对应)
END_VAR

VAR_TEMP
    t_rRaw          : REAL;     // 限幅后的原始值 (REAL)
END_VAR

BEGIN
    // 限幅: 超出 0..27648 的原始值按边界处理, 不外推
    IF i_iRawValue < 0 THEN
        t_rRaw := 0.0;
    ELSIF i_iRawValue > 27648 THEN
        t_rRaw := 27648.0;
    ELSE
        t_rRaw := INT_TO_REAL(i_iRawValue);
    END_IF;

    // 线性换算: 工程量 = 下限 + 原始值 / 27648 * (上限 - 下限)
    FC_4001_ScaleAnalog := i_rEngLow + (t_rRaw / 27648.0) * (i_rEngHigh - i_rEngLow);
END_FUNCTION
