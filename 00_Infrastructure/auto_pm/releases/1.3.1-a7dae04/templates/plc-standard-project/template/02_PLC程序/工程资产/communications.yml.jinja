project_id: "{{ project_id }}"
project_type: "{{ project_type or 'single_machine' }}"
channels:
  - name: "HMI"
    protocol: "ethernet"
    role: "人机界面"
    endpoint: "{{ plc_vendor or '待填写' }} {{ plc_model or '待填写' }}"
    notes: "补齐 IP、端口和变量映射"
  - name: "UpstreamDevice"
    protocol: "hardwired"
    role: "上游设备"
    endpoint: "待填写"
    notes: "请求送料、暂停、急停等联锁信号"
  - name: "DownstreamDevice"
    protocol: "hardwired"
    role: "下游设备"
    endpoint: "待填写"
    notes: "允许抓料、取料完成、复位请求等信号"
