"""应用上下文 - 持有 CLI 命令所需的全局对象"""

from __future__ import annotations

import os

from {{ package_name }} import __app_name__
from {{ package_name }}.config.app_config import AppConfig
from {{ package_name }}.logging.logging import setup_logger


class AppContext:
    """Holds all the objects needed by commands"""

    def __init__(self, workspace_root: str = "") -> None:
        self.app_config = AppConfig(app_name=__app_name__)
        self.logger = setup_logger(log_level=self.app_config.log_level, app_name=__app_name__)
        # 工作空间根目录（项目库所在目录）
        self.workspace_root: str = workspace_root or os.getcwd()
