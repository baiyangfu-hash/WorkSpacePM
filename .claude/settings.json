{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/.claude/**)",
      "Edit(**/.auto-pm/continuity.db*)",
      "Edit(**/.git/hooks/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --delete *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)"
    ]
  }
}
