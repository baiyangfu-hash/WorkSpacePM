FUNCTION FC_3003_CheckModuleId : WORD
(* ==============================================================================
 * FC_3003_CheckModuleId - 组件 ID 合格检查 (CARD-DJ-2026-009-003, 规则 R5)
 * 项目: DJ-2026-009 汇川换型改造
 * 返回: 16#0000 = 合格; 其他 = 不合格原因位
 * 现在只判空 (用户 2026-10-20 答复). 以后加长度、格式检查或和 MES 核对, 只在这里加,
 * 每种原因占一个位. ID 样例 L06A20261020165232 (线别 + 班次 + 时间戳到秒, 18 个字符).
 * ============================================================================== *)
VAR_INPUT
    i_sModuleId         : STRING[32];   // 待检查的组件 ID
END_VAR

VAR CONSTANT
    ID_OK               : WORD := 16#0000;  // 合格
    ID_ERR_EMPTY        : WORD := 16#0001;  // ID 为空
END_VAR
