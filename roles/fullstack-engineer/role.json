  "receipt_fields": [
    "PASS",
    "FAIL",
    "NOT_RUN",
    "既有债务",
    "checkpoint_id"
  ],
  "owned_paths_patterns": [
    "**/*.py",
    "**/*.qml",
    "**/tests/**"
  ],
