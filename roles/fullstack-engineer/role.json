{
  "schema_version": 1,
  "id": "fullstack-engineer",
  "title": "编程工程师（Python 上位机）",
  "kind": "engineer",
  "domain": "python",
  "legacy_names": [],
  "required_specs": [
    "DEV-300",
    "DEV-210",
    "DEV-216",
    "DEV-218"
  ],
  "allowed_commands": [
    "pm resume",
    "python check",
    "pytest",
    "ruff check",
    "mypy",
    "gate precheck",
    "gate start",
    "gate status",
    "continuity checkpoint",
    "pm handoff"
  ],
  "gates": [
    "main.py python check <PID>",
    "python -m pytest --no-cov -q",
    "python -m ruff check <owned_paths>",
    "python -m mypy --platform win32 --no-incremental --no-sqlite-cache --cache-dir=/dev/null <owned_paths>",
    "main.py gate precheck --worktree <W>",
    "main.py gate start --worktree <W> [--full]"
  ],
  "receipt_fields": [
    "PASS",
    "FAIL",
    "NOT_RUN",
    "既有债务",
    "checkpoint_id"
  ],
  "owned_paths_patterns": [
    "**/*.py",
    "**/*.qml",
    "**/tests/**"
  ],
  "owned_paths_note": "仅为申请范围的上限，实际可改范围以 Work 的 owned paths 为准",
  "enforcement": {
    "role_json": "能力边界与门禁元数据声明",
    "runtime": "实际硬拦截由 AGENTS.md、驾驶舱门禁与提交钩子执行（适配多平台）"
  },
  "legacy": {
    "retired": true,
    "note": "旧技能副本已于 2026-10-31 换成 .trae/skills 下的指路牌，正本只在 roles/"
  }
}
