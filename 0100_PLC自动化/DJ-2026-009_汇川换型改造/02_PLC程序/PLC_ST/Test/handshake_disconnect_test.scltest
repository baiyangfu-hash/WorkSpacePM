    SET GlobalVars.stExternal.stDownstream.bDownstream_AllowOutfeed := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_OutfeedArrived := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstreamComFault := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := TRUE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := TRUE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 20;
    SET GlobalVars.stStation1.stControl.bAutoEnable := FALSE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 20;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 0;
    ASSERT (GlobalVars.fbExternalDevice.q_wErrorCode AND 16#0004) = 16#0000;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bAutoEnable := TRUE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep <> 0;
END_TEST_CASE

// 复位按住不松: 断线中按下并一直按着, 网线接回来后锁仍在; 松开再按一次才清 (审计 59 复核)
TEST_CASE "TC_HD_Auto_ResetHeld_KeepLock"
    SET GlobalVars.bModbusEnable := TRUE;
    SET GlobalVars.bModbusUpLinkOK := FALSE;
    SET GlobalVars.bModbusDownLinkOK := FALSE;
    SET GlobalVars.stExternal.bEmergencyStop := TRUE;
    SET GlobalVars.stStation1.stControl.bAutoEnable := TRUE;
    SET GlobalVars.fbStation1.s_iStep := 0;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stSensors.bInPosSensor := FALSE;
    SET GlobalVars.stStation1.stSensors.bWorkPosSensor := FALSE;
    SET GlobalVars.stExternal.stUpstream.sRcvModuleID := 'L06A20261020165232';
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedArrivedAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_RcvModuleIdAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_AllowOutfeed := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_OutfeedArrived := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstreamComFault := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bAutoEnable := TRUE;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := TRUE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := TRUE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 20;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 0;
    WAIT_CYCLES 2;
    SET GlobalVars.stStation1.stControl.bReset := TRUE;
    WAIT_CYCLES 2;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := FALSE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 0;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_ReadyIn = FALSE;
    ASSERT (GlobalVars.fbExternalDevice.q_wErrorCode AND 16#0004) = 16#0004;
    SET GlobalVars.stStation1.stControl.bReset := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := FALSE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep <> 0;
    ASSERT (GlobalVars.fbExternalDevice.q_wErrorCode AND 16#0004) = 16#0000;
END_TEST_CASE
