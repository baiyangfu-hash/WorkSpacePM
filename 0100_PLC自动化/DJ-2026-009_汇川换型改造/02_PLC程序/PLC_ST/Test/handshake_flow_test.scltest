// R4: 握手第 20 步起中止, ID 待人工核对 16#0080; 复位不清, HMI 拷入后清
TEST_CASE "TC_HF_Abort_IdCheckAlarm"
    SET GlobalVars.bModbusEnable := TRUE;
    SET GlobalVars.bModbusUpLinkOK := FALSE;
    SET GlobalVars.bModbusDownLinkOK := FALSE;
    SET GVL_SafetyIO.SAFETY_FAULT := FALSE;
