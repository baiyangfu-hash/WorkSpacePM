// ============================================================================
// handshake_flow_test.scltest - 汇川换型改造 握手全流程、组件 ID 三格存储与接线测试
// ============================================================================
// 项目: DJ-2026-009 汇川换型改造
// 实施卡: CARD-DJ-2026-009-003 (草稿, 预做分支 claude/dj009-card003) 验收第 3 项
// 被测: OB1 接线 + FB_3001_ExternalInteraction + FB_1001_Station1 状态位 + FC_3003_CheckModuleId
// 做法: Modbus 映射层使能但两条链路都置为断开 (FB_3002 链路断开时不刷新读侧), 直接置对方的握手变量; 本机一侧全部走 OB1 正常接线
//   (OB1 的握手运行许可 = fbSafety.q_bSafeToRun AND bModbusEnable (Codex 评审 #77), 所以不能再用“Modbus 不使能”来置对方变量)
//   (运行许可 = FB_1030 实例 fbSafety (用例直接置 s_iState := 4 并给齐安全点), 自动 = stStation1.stControl.bAutoEnable, 复位 = stStation1.stControl.bReset,
//    进料就绪 = 工位“等待来料”, 出料就绪 = 工位出料步且气缸已缩回, 进料到位 = bInPosSensor,
//    有产品 = 工位块判断 (入料到位/加工到位/arrProductSens 任一路)).
// 计时: 共享库 FB_TON 目前按扫描次数计数, 本文件的时间参数和 WAIT_CYCLES 按“1 ms = 1 个扫描周期”写;
//   共享库定时器修复成真实毫秒后, 带计时的用例 (TC_HF_Outfeed_ProductLeft_ClearDownId, TC_HF_Idle_AutoClear_MachineId,
//   TC_HF_Heartbeat_SquareWave) 的等待周期数要按扫描周期重算.
// ============================================================================

// R1: 进料 8 步走通; 到位时上游 ID -> 本机 ID; 完成信号只保持一个扫描周期
TEST_CASE "TC_HF_Infeed_FullFlow_IdTakeover"
    SET GlobalVars.bModbusEnable := TRUE;
    SET GlobalVars.bModbusUpLinkOK := FALSE;
    SET GlobalVars.bModbusDownLinkOK := FALSE;
    SET GVL_SafetyIO.SAFETY_FAULT := FALSE;
    SET GVL_SafetyIO.FIELDBUS_OK := TRUE;
    SET GVL_SafetyIO.DOOR1_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR2_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR3_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR4_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR5_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR6_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR7_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR8_LOCKED := TRUE;
    SET GlobalVars.fbSafety.s_iState := 4;   // 测试捷径: 直接置“运行中”, 两次复位+启动流程见 safety_manager 用例
    SET GlobalVars.stStation1.stControl.bAutoEnable := TRUE;
    SET GlobalVars.fbStation1.s_iStep := 0;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stSensors.bInPosSensor := FALSE;
    SET GlobalVars.stStation1.stSensors.bWorkPosSensor := FALSE;
    SET GlobalVars.stExternal.stUpstream.sRcvModuleID := 'L06A20261020165232';
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedArrivedAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_RcvModuleIdAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_AllowOutfeed := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_OutfeedArrived := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstreamComFault := FALSE;
    SET GlobalVars.stModuleIdHmi.dLeaveTimeMs := 0;
    SET GlobalVars.stModuleIdHmi.dIdleClearMs := 0;
    SET GlobalVars.stModuleIdHmi.sManualId := '';
    SET GlobalVars.stModuleIdHmi.bCmdCopyFromUp := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdManualEntry := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdRelease := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdClear := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := TRUE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := TRUE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 10;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_ReadyIn = TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := TRUE;
    WAIT_CYCLES 2;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 20;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_RcvModuleIdAck = TRUE;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_AllowInfeed = TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 30;
    ASSERT GlobalVars.fbExternalDevice.q_bAllowInfeedAct = TRUE;
    ASSERT GlobalVars.bExtAllowInfeedAct = TRUE;
    ASSERT GlobalVars.sMachineModuleID = '';
    SET GlobalVars.stStation1.stSensors.bInPosSensor := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 40;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_InfeedArrived = TRUE;
    ASSERT GlobalVars.fbExternalDevice.q_bAllowInfeedAct = FALSE;
    ASSERT GlobalVars.sMachineModuleID = 'L06A20261020165232';
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedArrivedAck := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 0;
    ASSERT GlobalVars.bExtUpstreamDone = TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.bExtUpstreamDone = FALSE;
    ASSERT GlobalVars.sMachineModuleID = 'L06A20261020165232';
END_TEST_CASE

// R5: 上游 ID 为空不允许进料并报警 16#0040; HMI 放行后本次进料继续
TEST_CASE "TC_HF_Infeed_EmptyId_Release"
    SET GlobalVars.bModbusEnable := TRUE;
    SET GlobalVars.bModbusUpLinkOK := FALSE;
    SET GlobalVars.bModbusDownLinkOK := FALSE;
    SET GVL_SafetyIO.SAFETY_FAULT := FALSE;
    SET GVL_SafetyIO.FIELDBUS_OK := TRUE;
    SET GVL_SafetyIO.DOOR1_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR2_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR3_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR4_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR5_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR6_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR7_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR8_LOCKED := TRUE;
    SET GlobalVars.fbSafety.s_iState := 4;   // 测试捷径: 直接置“运行中”, 两次复位+启动流程见 safety_manager 用例
    SET GlobalVars.stStation1.stControl.bAutoEnable := TRUE;
    SET GlobalVars.fbStation1.s_iStep := 0;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stSensors.bInPosSensor := FALSE;
    SET GlobalVars.stStation1.stSensors.bWorkPosSensor := FALSE;
    SET GlobalVars.stExternal.stUpstream.sRcvModuleID := 'L06A20261020165232';
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedArrivedAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_RcvModuleIdAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_AllowOutfeed := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_OutfeedArrived := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstreamComFault := FALSE;
    SET GlobalVars.stModuleIdHmi.dLeaveTimeMs := 0;
    SET GlobalVars.stModuleIdHmi.dIdleClearMs := 0;
    SET GlobalVars.stModuleIdHmi.sManualId := '';
    SET GlobalVars.stModuleIdHmi.bCmdCopyFromUp := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdManualEntry := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdRelease := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdClear := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stExternal.stUpstream.sRcvModuleID := '';
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := TRUE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := TRUE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 10;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_ReadyIn = TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := TRUE;
    WAIT_CYCLES 2;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 20;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_RcvModuleIdAck = TRUE;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_AllowInfeed = FALSE;
    ASSERT (GlobalVars.fbExternalDevice.q_wErrorCode AND 16#0040) = 16#0040;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 20;
    ASSERT GlobalVars.fbExternalDevice.q_bAllowInfeedAct = FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdRelease := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stModuleIdHmi.bCmdRelease = FALSE;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_AllowInfeed = TRUE;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 30;
    ASSERT (GlobalVars.fbExternalDevice.q_wErrorCode AND 16#0040) = 16#0000;
    SET GlobalVars.stStation1.stSensors.bInPosSensor := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 40;
    ASSERT GlobalVars.sMachineModuleID = '';
END_TEST_CASE

// R5: 上游 ID 为空时 HMI 补录; 补录空串无效, 补录合格 ID 后允许进料并成为本机 ID
TEST_CASE "TC_HF_Infeed_EmptyId_ManualEntry"
    SET GlobalVars.bModbusEnable := TRUE;
    SET GlobalVars.bModbusUpLinkOK := FALSE;
    SET GlobalVars.bModbusDownLinkOK := FALSE;
    SET GVL_SafetyIO.SAFETY_FAULT := FALSE;
    SET GVL_SafetyIO.FIELDBUS_OK := TRUE;
    SET GVL_SafetyIO.DOOR1_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR2_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR3_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR4_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR5_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR6_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR7_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR8_LOCKED := TRUE;
    SET GlobalVars.fbSafety.s_iState := 4;   // 测试捷径: 直接置“运行中”, 两次复位+启动流程见 safety_manager 用例
    SET GlobalVars.stStation1.stControl.bAutoEnable := TRUE;
    SET GlobalVars.fbStation1.s_iStep := 0;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stSensors.bInPosSensor := FALSE;
    SET GlobalVars.stStation1.stSensors.bWorkPosSensor := FALSE;
    SET GlobalVars.stExternal.stUpstream.sRcvModuleID := 'L06A20261020165232';
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedArrivedAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_RcvModuleIdAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_AllowOutfeed := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_OutfeedArrived := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstreamComFault := FALSE;
    SET GlobalVars.stModuleIdHmi.dLeaveTimeMs := 0;
    SET GlobalVars.stModuleIdHmi.dIdleClearMs := 0;
    SET GlobalVars.stModuleIdHmi.sManualId := '';
    SET GlobalVars.stModuleIdHmi.bCmdCopyFromUp := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdManualEntry := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdRelease := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdClear := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.stExternal.stUpstream.sRcvModuleID := '';
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := TRUE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := TRUE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 10;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_ReadyIn = TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := TRUE;
    WAIT_CYCLES 2;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 20;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_RcvModuleIdAck = TRUE;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_AllowInfeed = FALSE;
    SET GlobalVars.stModuleIdHmi.sManualId := '';
    SET GlobalVars.stModuleIdHmi.bCmdManualEntry := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stModuleIdHmi.bCmdManualEntry = FALSE;
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_AllowInfeed = FALSE;
    SET GlobalVars.stModuleIdHmi.sManualId := 'L06A20261021080000';
    SET GlobalVars.stModuleIdHmi.bCmdManualEntry := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stModuleIdHmi.bCmdManualEntry = FALSE;
    ASSERT GlobalVars.sMachineModuleID = 'L06A20261021080000';
    ASSERT GlobalVars.stExternal.stUpstream.bMachine_AllowInfeed = TRUE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stUpstream.iInfeedStep = 30;
    SET GlobalVars.stStation1.stSensors.bInPosSensor := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.sMachineModuleID = 'L06A20261021080000';
END_TEST_CASE

// R2/R3 第 1 种: 准备出料时本机 ID -> 下游 ID; 出料握手完成清下游 ID, 本机 ID 一起清
TEST_CASE "TC_HF_Outfeed_FullFlow_IdHandover"
    SET GlobalVars.bModbusEnable := TRUE;
    SET GlobalVars.bModbusUpLinkOK := FALSE;
    SET GlobalVars.bModbusDownLinkOK := FALSE;
    SET GVL_SafetyIO.SAFETY_FAULT := FALSE;
    SET GVL_SafetyIO.FIELDBUS_OK := TRUE;
    SET GVL_SafetyIO.DOOR1_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR2_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR3_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR4_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR5_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR6_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR7_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR8_LOCKED := TRUE;
    SET GlobalVars.fbSafety.s_iState := 4;   // 测试捷径: 直接置“运行中”, 两次复位+启动流程见 safety_manager 用例
    SET GlobalVars.stStation1.stControl.bAutoEnable := TRUE;
    SET GlobalVars.fbStation1.s_iStep := 0;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stSensors.bInPosSensor := FALSE;
    SET GlobalVars.stStation1.stSensors.bWorkPosSensor := FALSE;
    SET GlobalVars.stExternal.stUpstream.sRcvModuleID := 'L06A20261020165232';
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedArrivedAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_RcvModuleIdAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_AllowOutfeed := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_OutfeedArrived := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstreamComFault := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstreamComFault := FALSE;
    SET GlobalVars.stModuleIdHmi.dLeaveTimeMs := 0;
    SET GlobalVars.stModuleIdHmi.dIdleClearMs := 0;
    SET GlobalVars.stModuleIdHmi.sManualId := '';
    SET GlobalVars.stModuleIdHmi.bCmdCopyFromUp := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdManualEntry := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdRelease := FALSE;
    SET GlobalVars.stModuleIdHmi.bCmdClear := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := TRUE;
    WAIT_CYCLES 1;
    SET GlobalVars.stStation1.stControl.bReset := FALSE;
    WAIT_CYCLES 1;
    SET GlobalVars.sMachineModuleID := 'L06A20261020165232';
    SET GlobalVars.stStation1.stSensors.bWorkPosSensor := TRUE;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := TRUE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := TRUE;
    SET GlobalVars.fbStation1.s_iStep := 30;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stStation1.stStatus.bReadyOut = TRUE;
    ASSERT GlobalVars.stExternal.stDownstream.bMachine_ReadyOut = TRUE;
    ASSERT GlobalVars.stExternal.stDownstream.sSendModuleID = 'L06A20261020165232';
    ASSERT GlobalVars.stExternal.stDownstream.iOutfeedStep = 0;
    SET GlobalVars.stExternal.stDownstream.bDownstream_LineReady := TRUE;
    WAIT_CYCLES 2;
    ASSERT GlobalVars.stExternal.stDownstream.iOutfeedStep = 10;
    ASSERT GlobalVars.stExternal.stDownstream.bMachine_SendModuleId = TRUE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_RcvModuleIdAck := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stDownstream.iOutfeedStep = 20;
    SET GlobalVars.stExternal.stDownstream.bDownstream_AllowOutfeed := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stDownstream.iOutfeedStep = 30;
    ASSERT GlobalVars.stExternal.stDownstream.bMachine_OutfeedReq = TRUE;
    ASSERT GlobalVars.fbExternalDevice.q_bAllowOutfeedAct = TRUE;
    ASSERT GlobalVars.bExtAllowOutfeedAct = TRUE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_OutfeedArrived := TRUE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stDownstream.iOutfeedStep = 40;
    ASSERT GlobalVars.stExternal.stDownstream.bMachine_OutfeedArrivedAck = TRUE;
    ASSERT GlobalVars.fbExternalDevice.q_bAllowOutfeedAct = FALSE;
    ASSERT GlobalVars.stExternal.stDownstream.sSendModuleID = 'L06A20261020165232';
    SET GlobalVars.stExternal.stDownstream.bDownstream_OutfeedArrived := FALSE;
    WAIT_CYCLES 1;
    ASSERT GlobalVars.stExternal.stDownstream.iOutfeedStep = 0;
    ASSERT GlobalVars.bExtDownstreamDone = TRUE;
    ASSERT GlobalVars.stExternal.stDownstream.sSendModuleID = '';
    ASSERT GlobalVars.sMachineModuleID = '';
    SET GlobalVars.stStation1.stSensors.bWorkPosSensor := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_LineReady := FALSE;
END_TEST_CASE

// R3 第 2 种: 出料中本机持续检测不到产品超过设定时间 (这里设 5) 清下游 ID; 本机 ID 留给 R6
TEST_CASE "TC_HF_Outfeed_ProductLeft_ClearDownId"
    SET GlobalVars.bModbusEnable := TRUE;
    SET GlobalVars.bModbusUpLinkOK := FALSE;
    SET GlobalVars.bModbusDownLinkOK := FALSE;
    SET GVL_SafetyIO.SAFETY_FAULT := FALSE;
    SET GVL_SafetyIO.FIELDBUS_OK := TRUE;
    SET GVL_SafetyIO.DOOR1_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR2_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR3_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR4_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR5_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR6_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR7_LOCKED := TRUE;
    SET GVL_SafetyIO.DOOR8_LOCKED := TRUE;
    SET GlobalVars.fbSafety.s_iState := 4;   // 测试捷径: 直接置“运行中”, 两次复位+启动流程见 safety_manager 用例
    SET GlobalVars.stStation1.stControl.bAutoEnable := TRUE;
    SET GlobalVars.fbStation1.s_iStep := 0;
    SET GlobalVars.stStation1.stActuators.stCyl1.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stActuators.stCyl2.stSts.IsRetracted := FALSE;
    SET GlobalVars.stStation1.stSensors.bInPosSensor := FALSE;
    SET GlobalVars.stStation1.stSensors.bWorkPosSensor := FALSE;
    SET GlobalVars.stExternal.stUpstream.sRcvModuleID := 'L06A20261020165232';
    SET GlobalVars.stExternal.stUpstream.bUpstream_LineReady := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_SendModuleId := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedReq := FALSE;
    SET GlobalVars.stExternal.stUpstream.bUpstream_InfeedArrivedAck := FALSE;
    SET GlobalVars.stExternal.stDownstream.bDownstream_LineReady := FALSE;
