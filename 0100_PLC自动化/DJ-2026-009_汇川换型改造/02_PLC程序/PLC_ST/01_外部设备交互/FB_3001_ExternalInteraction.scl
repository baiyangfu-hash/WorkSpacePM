FUNCTION_BLOCK FB_3001_ExternalInteraction
(* ==============================================================================
 * FB_3001_ExternalInteraction - 通用外部设备交握与心跳监视功能块
 * 项目: DJ-2026-009 汇川换型改造
 * 遵循规范: STD-820 (8步握手 + 4s ON / 4s OFF 心跳)
 * ============================================================================== *)
VAR_INPUT
    i_bEnable           : BOOL;         // 功能块总使能
    i_bAutoMode         : BOOL;         // 自动运行模式
    i_bResetCmd         : BOOL;         // 故障复位指令
    i_bMachineReadyIn   : BOOL;         // 本机进料就绪 (工位空闲)
    i_bMachineReadyOut  : BOOL;         // 本机出料就绪 (加工完成)
    i_bInfeedArrivedSens: BOOL;         // 本机进料到位光电传感器
    i_sSendModuleID     : STRING[32];   // 本机待发出的组件 ID
END_VAR

VAR_OUTPUT
    q_bAllowInfeedAct   : BOOL;         // 触发本机进料动作输出
    q_bAllowOutfeedAct  : BOOL;         // 触发本机出料动作输出
    q_bUpstreamDone     : BOOL;         // 本次进料交握事务完成脉冲
    q_bDownstreamDone   : BOOL;         // 本次出料交握事务完成脉冲
    q_bComAlarm         : BOOL;         // 外部通讯中断综合报警
    q_wErrorCode        : WORD;         // 故障诊断字
END_VAR

VAR_IN_OUT
    io_stExternal       : ST_ExternalDevice;    // STD-820 通用外部对接数据总线
END_VAR

VAR
    // --- STD-820 心跳: 4s ON / 4s OFF 方波 + 12s 超时监视 (LSP-903: FB_TON + DINT 毫秒) ---
    s_dHeartbeatPulse   : DINT := 4000;    // 心跳半周期 4000ms
    s_dHbTimeoutMs      : DINT := 12000;   // 心跳超时阈值 12000ms
    s_tHbToggle         : FB_TON;          // 心跳翻转定时器
    s_tUpTimeout        : FB_TON;          // 上游心跳超时定时器
    s_tDownTimeout      : FB_TON;          // 下游心跳超时定时器

    s_bLastUpHeartbeat  : BOOL := FALSE;
    s_bLastDownHeartbeat: BOOL := FALSE;

    s_iInfeedStep       : INT  := 0;
    s_iOutfeedStep      : INT  := 0;
    s_wAbortLatch       : WORD := 16#0000; // 握手中途中止记录 (保持到复位)
    s_bInfeedLock       : BOOL := FALSE;   // 自动作业中进料被中止, 需人工复位才能重新握手
    s_bOutfeedLock      : BOOL := FALSE;   // 自动作业中出料被中止, 需人工复位才能重新握手
    s_bResetPrev        : BOOL := FALSE;   // 上一周期复位指令 (清锁只认上升沿)
END_VAR

VAR CONSTANT
    // --- q_wErrorCode 位定义 (CARD-DJ-2026-009-002) ---
    ERR_INFEED_ABORT    : WORD := 16#0001;  // 进料握手第 10~40 步因通讯故障中止 (保持到复位)
    ERR_OUTFEED_ABORT   : WORD := 16#0002;  // 出料握手第 10~40 步因通讯故障中止 (保持到复位)
    ERR_WAIT_RESET      : WORD := 16#0004;  // 自动作业中被中止, 等待人工复位 (复位后清)
    ERR_UP_COM          : WORD := 16#0010;  // 上游通讯故障 (实时)
    ERR_DOWN_COM        : WORD := 16#0020;  // 下游通讯故障 (实时)
END_VAR

BEGIN
    // --- 定时器顶部无条件批量调用 (LSP-906/903) ---
    s_tHbToggle(IN := s_tHbToggle.IN, PT := s_tHbToggle.PT,
                Q => s_tHbToggle.Q, ET => s_tHbToggle.ET);
    s_tUpTimeout(IN := s_tUpTimeout.IN, PT := s_tUpTimeout.PT,
                 Q => s_tUpTimeout.Q, ET => s_tUpTimeout.ET);
    s_tDownTimeout(IN := s_tDownTimeout.IN, PT := s_tDownTimeout.PT,
                   Q => s_tDownTimeout.Q, ET => s_tDownTimeout.ET);

    (* 0. 复位处理 *)
    IF i_bResetCmd THEN
        // 自动作业中断线留下的锁: 只有通讯已恢复 (上一周期无通讯故障) 时按下复位的那一下才清 (用户 2026-10-20 按建议批准)
        // 只认上升沿: 按住不松时网线接回来, 锁不会被清掉
        IF (NOT s_bResetPrev) AND (NOT io_stExternal.bAnyComFault) THEN
            s_bInfeedLock := FALSE;
            s_bOutfeedLock := FALSE;
        END_IF;
        io_stExternal.stUpstream.bUpstreamComFault := FALSE;
        io_stExternal.stDownstream.bDownstreamComFault := FALSE;
        io_stExternal.bAnyComFault := FALSE;
        q_wErrorCode := 16#0000;
        s_wAbortLatch := 16#0000;
        s_tUpTimeout.IN := FALSE;
        s_tDownTimeout.IN := FALSE;
    END_IF;

    s_bResetPrev := i_bResetCmd;

    IF NOT i_bEnable THEN
        io_stExternal.stUpstream.bMachine_ReadyIn := FALSE;
        io_stExternal.stUpstream.bMachine_AllowInfeed := FALSE;
        io_stExternal.stDownstream.bMachine_ReadyOut := FALSE;
        io_stExternal.stDownstream.bMachine_OutfeedReq := FALSE;
        io_stExternal.stUpstream.bMachine_HeartbeatToUp := FALSE;
        io_stExternal.stDownstream.bMachine_HeartbeatToDown := FALSE;
        s_tHbToggle.IN := FALSE;
        s_tUpTimeout.IN := FALSE;
        s_tDownTimeout.IN := FALSE;
        s_iInfeedStep := 0;
        s_iOutfeedStep := 0;
        RETURN;
    END_IF;

    (* 1. 心跳生成 (4s ON / 4s OFF) 与 12s 超时监视 *)
    // 心跳翻转: FB_TON 定时翻转, 输出 4s 方波
    s_tHbToggle.IN := NOT s_tHbToggle.Q;
    s_tHbToggle.PT := s_dHeartbeatPulse;
    io_stExternal.stUpstream.bMachine_HeartbeatToUp := s_tHbToggle.Q;
    io_stExternal.stDownstream.bMachine_HeartbeatToDown := s_tHbToggle.Q;

    // 上游心跳边沿检测 + 12s 超时监视
    IF io_stExternal.stUpstream.bUpstream_HeartbeatFromUp <> s_bLastUpHeartbeat THEN
        s_bLastUpHeartbeat := io_stExternal.stUpstream.bUpstream_HeartbeatFromUp;
        s_tUpTimeout.IN := FALSE;
        io_stExternal.stUpstream.bUpstreamComFault := FALSE;
    ELSE
        s_tUpTimeout.IN := TRUE;
    END_IF;
    s_tUpTimeout.PT := s_dHbTimeoutMs;
    IF s_tUpTimeout.Q THEN
        io_stExternal.stUpstream.bUpstreamComFault := TRUE;
    END_IF;

    // 下游心跳边沿检测 + 12s 超时监视
    IF io_stExternal.stDownstream.bDownstream_HeartbeatFromDown <> s_bLastDownHeartbeat THEN
        s_bLastDownHeartbeat := io_stExternal.stDownstream.bDownstream_HeartbeatFromDown;
        s_tDownTimeout.IN := FALSE;
        io_stExternal.stDownstream.bDownstreamComFault := FALSE;
    ELSE
        s_tDownTimeout.IN := TRUE;
    END_IF;
    s_tDownTimeout.PT := s_dHbTimeoutMs;
    IF s_tDownTimeout.Q THEN
        io_stExternal.stDownstream.bDownstreamComFault := TRUE;
    END_IF;

    io_stExternal.bAnyComFault := io_stExternal.stUpstream.bUpstreamComFault OR io_stExternal.stDownstream.bDownstreamComFault;
    q_bComAlarm := io_stExternal.bAnyComFault;

    (* 1.1 握手中途通讯故障: 当拍撤销允许信号和动作输出, 步序回 0 (验收项 A3, CARD-DJ-2026-009-002) *)
    //     上下游任一侧故障, 进料和出料都中止 (用户 2026-10-20 答复第 7 条)
    //     自动模式下中止的, 通讯恢复后也要人工复位才能重新握手; 不在作业中的, 通讯恢复即自动恢复 (第 8 条)
    IF (s_iInfeedStep <> 0) AND io_stExternal.bAnyComFault THEN
        IF i_bAutoMode THEN
            s_bInfeedLock := TRUE;
        END_IF;
        io_stExternal.stUpstream.bMachine_RcvModuleIdAck := FALSE;
        io_stExternal.stUpstream.bMachine_AllowInfeed := FALSE;
        io_stExternal.stUpstream.bMachine_InfeedArrived := FALSE;
        q_bAllowInfeedAct := FALSE;
        s_wAbortLatch := s_wAbortLatch OR ERR_INFEED_ABORT;
        s_iInfeedStep := 0;
    END_IF;
    IF (s_iOutfeedStep <> 0) AND io_stExternal.bAnyComFault THEN
        IF i_bAutoMode THEN
            s_bOutfeedLock := TRUE;
        END_IF;
        io_stExternal.stDownstream.bMachine_SendModuleId := FALSE;
        io_stExternal.stDownstream.bMachine_OutfeedReq := FALSE;
        io_stExternal.stDownstream.bMachine_OutfeedArrivedAck := FALSE;
        q_bAllowOutfeedAct := FALSE;
        s_wAbortLatch := s_wAbortLatch OR ERR_OUTFEED_ABORT;
        s_iOutfeedStep := 0;
    END_IF;
    q_wErrorCode := s_wAbortLatch;
    IF s_bInfeedLock OR s_bOutfeedLock THEN
        q_wErrorCode := q_wErrorCode OR ERR_WAIT_RESET;
    END_IF;
    IF io_stExternal.stUpstream.bUpstreamComFault THEN
        q_wErrorCode := q_wErrorCode OR ERR_UP_COM;
    END_IF;
    IF io_stExternal.stDownstream.bDownstreamComFault THEN
        q_wErrorCode := q_wErrorCode OR ERR_DOWN_COM;
    END_IF;

    (* 2. 上游进料 8 步闭环状态机 (STD-820) *)
    CASE s_iInfeedStep OF
        0: (* 待机态: 广播本机准备好进料 (1) *)
            io_stExternal.stUpstream.bMachine_ReadyIn := i_bMachineReadyIn AND NOT io_stExternal.bAnyComFault AND NOT s_bInfeedLock;
            io_stExternal.stUpstream.bMachine_RcvModuleIdAck := FALSE;
            io_stExternal.stUpstream.bMachine_AllowInfeed := FALSE;
            io_stExternal.stUpstream.bMachine_InfeedArrived := FALSE;
            IF io_stExternal.stUpstream.bMachine_ReadyIn AND io_stExternal.stUpstream.bUpstream_LineReady THEN
                s_iInfeedStep := 10;
            END_IF;

        10: (* 等待上游传组件 ID (3) *)
            IF io_stExternal.stUpstream.bUpstream_SendModuleId THEN
                io_stExternal.stUpstream.sRcvModuleID := io_stExternal.stUpstream.sRcvModuleID;
                io_stExternal.stUpstream.bMachine_RcvModuleIdAck := TRUE; (* (4) 确认收到ID *)
                s_iInfeedStep := 20;
            END_IF;

        20: (* 允许上游进料 (5) *)
            io_stExternal.stUpstream.bMachine_AllowInfeed := TRUE;
            IF io_stExternal.stUpstream.bUpstream_InfeedReq THEN (* (6) 上游请求入料 *)
                q_bAllowInfeedAct := TRUE;
                s_iInfeedStep := 30;
            END_IF;

        30: (* 检测工件进料到位 (7) *)
            IF i_bInfeedArrivedSens THEN
                io_stExternal.stUpstream.bMachine_InfeedArrived := TRUE;
                q_bAllowInfeedAct := FALSE;
                s_iInfeedStep := 40;
            END_IF;

        40: (* 等待上游回收确认 (8) *)
            IF io_stExternal.stUpstream.bUpstream_InfeedArrivedAck THEN
                q_bUpstreamDone := TRUE;
                s_iInfeedStep := 0; (* 完成闭环 *)
            END_IF;

        ELSE
            s_iInfeedStep := 0;
    END_CASE;
    io_stExternal.stUpstream.iInfeedStep := s_iInfeedStep;

    (* 3. 下游出料 8 步闭环状态机 (STD-820) *)
    CASE s_iOutfeedStep OF
        0: (* 待机态: 等待下游准备好 (1) 并广播本机准备好出料 (2) *)
            io_stExternal.stDownstream.bMachine_ReadyOut := i_bMachineReadyOut AND NOT io_stExternal.bAnyComFault AND NOT s_bOutfeedLock;
            io_stExternal.stDownstream.bMachine_SendModuleId := FALSE;
            io_stExternal.stDownstream.bMachine_OutfeedReq := FALSE;
            io_stExternal.stDownstream.bMachine_OutfeedArrivedAck := FALSE;
            IF io_stExternal.stDownstream.bMachine_ReadyOut AND io_stExternal.stDownstream.bDownstream_LineReady THEN
                s_iOutfeedStep := 10;
            END_IF;

        10: (* 发送组件 ID (3) *)
            io_stExternal.stDownstream.sSendModuleID := i_sSendModuleID;
            io_stExternal.stDownstream.bMachine_SendModuleId := TRUE;
            IF io_stExternal.stDownstream.bDownstream_RcvModuleIdAck THEN (* (4) 下游确认收到 *)
                s_iOutfeedStep := 20;
            END_IF;

        20: (* 等待下游允许出料 (5) 并发出出料请求 (6) *)
            IF io_stExternal.stDownstream.bDownstream_AllowOutfeed THEN
                io_stExternal.stDownstream.bMachine_OutfeedReq := TRUE;
                q_bAllowOutfeedAct := TRUE;
                s_iOutfeedStep := 30;
            END_IF;

        30: (* 等待下游进料到位 (7) *)
            IF io_stExternal.stDownstream.bDownstream_OutfeedArrived THEN
                io_stExternal.stDownstream.bMachine_OutfeedArrivedAck := TRUE; (* (8) 本机确认回收 *)
                q_bAllowOutfeedAct := FALSE;
                s_iOutfeedStep := 40;
            END_IF;

        40: (* 下游撤销到位信号，事务完成 *)
            IF NOT io_stExternal.stDownstream.bDownstream_OutfeedArrived THEN
                q_bDownstreamDone := TRUE;
                s_iOutfeedStep := 0; (* 完成闭环 *)
            END_IF;

        ELSE
            s_iOutfeedStep := 0;
    END_CASE;
    io_stExternal.stDownstream.iOutfeedStep := s_iOutfeedStep;

END_FUNCTION_BLOCK
