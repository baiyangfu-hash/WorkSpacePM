// ============================================================================
// ST_Station1.scl - 汇川换型改造 工位1 动作机构数据类型定义
// ============================================================================
// 描述:
//   定义 DJ-2026-009 汇川换型改造 工位1 的控制、状态、配置、传感器与执行器结构体.
//   遵循 LSP-905 命名与结构化规范, 支持结构体整块传递 (Struct Chunk Passing).
// ============================================================================

TYPE ST_Station1_Control :
STRUCT
    bAutoEnable     : BOOL;     // 自动运行使能
    bManualStart    : BOOL;     // 手动单步启动
    bReset          : BOOL;     // 故障复位
    bPause          : BOOL;     // 暂停
    bSingleStepMode : BOOL;     // 单步模式
    bSafeToRun      : BOOL;     // 运行许可, OB1 每扫描从 FB_1030 q_bSafeToRun 写入 (CARD-DJ-2026-009-004)
END_STRUCT;
END_TYPE

TYPE ST_Station1_Status :
STRUCT
    iStep           : DINT;     // 当前工步号
    bRunning        : BOOL;     // 运行中
    bDone           : BOOL;     // 本周期动作完成
    bAlarm          : BOOL;     // 站级报警
    iAlarmCode      : DINT;     // 报警代码 (101~199)
    bWaitMaterial   : BOOL;     // 等待来料
    bProcessing     : BOOL;     // 加工中
    bReadyOut       : BOOL;     // 加工完成可出料 (出料步且气缸已松开)
    bProductPresent : BOOL;     // 本工位有产品 (入料到位/加工到位/预留产品传感器任一路为 1)
    bFrozen         : BOOL;     // 安全停机, 步序冻结在断点等续跑 (CARD-DJ-2026-009-004)
    bMotionStopped  : BOOL;     // 动作完全停止: 电机无请求且不转, 气缸都在端点 (接 FB_1030 i_bMotionStopped)
END_STRUCT;
END_TYPE

TYPE ST_Station1_Config :
STRUCT
    dDebounceMs     : DINT;     // 光电消抖时间 (ms, 默认 100)
    dCylTimeoutMs   : DINT;     // 气缸动作超时时间 (ms, 默认 5000)
    dProcessTimeMs  : DINT;     // 工艺加工延时时间 (ms, 默认 2000)
END_STRUCT;
END_TYPE

TYPE ST_Station1_Sensors :
STRUCT
    bInPosSensor    : BOOL;     // 入料到位光电
    bWorkPosSensor  : BOOL;     // 加工到位光电
    arrProductSens  : ARRAY[0..7] OF BOOL; // 产品检测传感器预留 8 路 (未接的保持 0), 任一路为 1 即有产品
END_STRUCT;
END_TYPE

TYPE ST_Station1_Actuators :
STRUCT
    stMotorFwd      : ST_ConveyorMotor; // 进料输送电机
    stCyl1          : ST_Cylinder;      // 夹紧气缸
    stCyl2          : ST_Cylinder;      // 顶升气缸
END_STRUCT;
END_TYPE

TYPE ST_Station1 :
STRUCT
    stControl       : ST_Station1_Control;
    stStatus        : ST_Station1_Status;
    stConfig        : ST_Station1_Config;
    stSensors       : ST_Station1_Sensors;
    stActuators     : ST_Station1_Actuators;
END_STRUCT;
END_TYPE
