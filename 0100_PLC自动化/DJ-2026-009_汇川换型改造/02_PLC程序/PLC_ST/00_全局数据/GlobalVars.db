// ============================================================================
// GlobalVars.db - 汇川换型改造 全局变量数据块
// ============================================================================
// 功能说明:
//   DJ-2026-009 汇川换型改造的全部全局数据与功能块实例, 只做声明, 不含逻辑.
//   各数据以结构体整块经 VAR_IN_OUT 传给功能块 (OB1.scl 逐项引用).
//   名称与类型依据: PRD/接口文档_IFC-GlobalVars.md (stGlobal / stExternal) 与
//   OB1.scl、FB_3002_ModbusTcpClient 接口 (寄存器镜像数组下标 0..31).
//   接口文档里的 astServoAxis (ST_AxisPos) 在本项目没有对应类型定义,
//   OB1 与各功能块也未引用, 本文件不声明, 待类型落地后再补.
// ============================================================================

DATA_BLOCK GlobalVars

VAR
    // =========================================================================
    // 第一部分: 全局结构体数据
    // =========================================================================
    stGlobal            : ST_CommonAlarm;       // 全局系统控制与报警 (FB_2001 读写)
    stExternal          : ST_ExternalDevice;    // STD-820 外部交互总线 (上下游握手)
    stStation1          : ST_Station1;          // 工位1 动作机构交互结构体

    // =========================================================================
    // 第二部分: Modbus TCP 通道 (FB_3002 读写)
    // =========================================================================
    bModbusEnable       : BOOL;                 // Modbus 客户端总使能
    bModbusUpLinkOK     : BOOL;                 // 上游通道链路正常 (主站通道诊断)
    bModbusDownLinkOK   : BOOL;                 // 下游通道链路正常 (主站通道诊断)
    awModbusUpRead      : ARRAY[0..31] OF WORD; // 上游寄存器读镜像
    awModbusUpWrite     : ARRAY[0..31] OF WORD; // 上游寄存器写镜像
    awModbusDownRead    : ARRAY[0..31] OF WORD; // 下游寄存器读镜像
    awModbusDownWrite   : ARRAY[0..31] OF WORD; // 下游寄存器写镜像

    // =========================================================================
    // 第三部分: 功能块实例 (OB1 调用顺序)
    // =========================================================================
    fbModbusClient      : FB_3002_ModbusTcpClient;          // 上下游 Modbus TCP 数据映射
    fbExternalDevice    : FB_3001_ExternalInteraction;      // 外部设备握手与心跳监视
    fbStation1          : FB_1001_Station1;                 // 工位1 动作机构
    fbCommonAlarm       : FB_2001_CommonAlarm_AllStation;   // 公共报警 (最后调用)
END_VAR

END_DATA_BLOCK
