// ============================================================================
// OB1.scl - SysLib公共库FB测试套件主组织块
// ============================================================================
// 功能说明:
//   最小化测试壳, 仅调用被测FB实例, 不含业务逻辑.
//   测试信号通过GlobalVars中的变量注入, 由.scltest文件驱动.
//
// 调用顺序:
//   1. FB_ValveControl (回归参考)
//   2. FB_1011_CylinderControl (单线圈/双线圈气缸)
//   3. FB_1012_ConveyorMotor (输送电机)
//   4. FB_1014_StationConveyor (工站输送机)
//   5. FB_1030_SafetyManager (安全管理块, 2026-10-22)
//
// 变更记录:
//   V2.0.0 (2026-06-17): 重构为SysLib测试套件
//   V4.1.0 (2026-05-01): 初始版本(阀门控制+定时器)
// ============================================================================

ORGANIZATION_BLOCK OB1
BEGIN

// ============================================================================
// 第一部分: 阀门控制 (回归参考 - 保留原有逻辑)
// ============================================================================
GlobalVars.ValveCtrl(
    AutoManual  := GlobalVars.Hmibutton[0],
    OpenCmd     := GlobalVars.Hmibutton[1],
    CloseCmd    := GlobalVars.Hmibutton[2],
    OverCurrent := GlobalVars.Hmibutton[3],
    OpenLimit   := GlobalVars.Hmibutton[4],
    CloseLimit  := GlobalVars.Hmibutton[5],
    FaultReset  := GlobalVars.Hmibutton[6],
    FaultStatus => GlobalVars.FaultStatus,
    ValveOpen   => GlobalVars.ValveOpen,
    ValveClose  => GlobalVars.ValveClose,
    ValveState  => GlobalVars.ValveState
);

// 定时器A (回归参考)
IF GlobalVars.Hmibutton[7] THEN
    GlobalVars.Counter_A := GlobalVars.Counter_A + 1;
    IF GlobalVars.Counter_A >= 50 THEN
        GlobalVars.bOut_A := TRUE;
        GlobalVars.Counter_A := 50;
    END_IF;
ELSE
    GlobalVars.bOut_A := FALSE;
    GlobalVars.Counter_A := 0;
END_IF;

// 定时器B (回归参考)
IF GlobalVars.Hmibutton[8] THEN
    GlobalVars.Counter_B := GlobalVars.Counter_B + 1;
    IF GlobalVars.Counter_B >= 50 THEN
        GlobalVars.bOut_B := TRUE;
        GlobalVars.Counter_B := 50;
    END_IF;
ELSE
    GlobalVars.bOut_B := FALSE;
    GlobalVars.Counter_B := 0;
END_IF;

// ============================================================================
// 第二部分: FB_1011_CylinderControl (单线圈模式测试)
// ============================================================================
// 结构体接口: i_stCmd(ST_CylinderCmd) + q_stSts(ST_CylinderSts)
// 默认值保护: 确保TimeoutMs不为0(0=关闭超时检测)
IF GlobalVars.cyl_stCmd.TimeoutMs = 0 THEN
    GlobalVars.cyl_stCmd.TimeoutMs := 5000;
END_IF;
GlobalVars.CylinderSingle(
    i_stCmd := GlobalVars.cyl_stCmd,
    q_stSts => GlobalVars.cyl_stSts
);

// ============================================================================
// 第三部分: FB_1012_ConveyorMotor (输送电机测试)
// ============================================================================
GlobalVars.ConveyorMotor(
    i_bFwdCmd   := GlobalVars.conv_bFwdCmd,
    i_bRevCmd   := GlobalVars.conv_bRevCmd,
    i_bSlowCmd  := GlobalVars.conv_bSlowCmd,
    i_bVfdFault := GlobalVars.conv_bVfdFault,
    i_iCtrlMode := GlobalVars.conv_iCtrlMode,
    i_rSpeed    := GlobalVars.conv_rSpeed,
    q_bFwdOut   => GlobalVars.conv_bFwdOut,
    q_bRevOut   => GlobalVars.conv_bRevOut,
    q_bSlowOut  => GlobalVars.conv_bSlowOut,
    q_bRunning  => GlobalVars.conv_bRunning,
    q_bVfdAlarm => GlobalVars.conv_bVfdAlarm
);

// ============================================================================
// 第四部分: FB_1014_StationConveyor (工站输送机测试)
// ============================================================================
GlobalVars.StationConveyor(
    i_bAutoMode            := GlobalVars.st_bAutoMode,
    i_bUpstreamReq         := GlobalVars.st_bUpstreamReq,
    i_bDownstreamReq       := GlobalVars.st_bDownstreamReq,
    i_bSelected            := GlobalVars.st_bSelected,
    i_bProcessDone         := GlobalVars.st_bProcessDone,
    i_bStop                := GlobalVars.st_bStop,
    i_bPause               := GlobalVars.st_bPause,
    i_bSlowMode            := GlobalVars.st_bSlowMode,
    i_iMode                := GlobalVars.st_iMode,
    i_dInfeedDelayMs       := GlobalVars.st_dInfeedDelayMs,
    i_dDischargeDelayMs    := GlobalVars.st_dDischargeDelayMs,
    i_dAlignDelayMs        := GlobalVars.st_dAlignDelayMs,
    i_dDebounceMs          := GlobalVars.st_dDebounceMs,
    i_xInfeedStart         := GlobalVars.st_xInfeedStart,
    i_xPos1                := GlobalVars.st_xPos1,
    i_xPos2                := GlobalVars.st_xPos2,
    i_bInfeedIsExtended    := GlobalVars.st_bInfeedIsExtended,
    i_bInfeedIsRetracted   := GlobalVars.st_bInfeedIsRetracted,
    i_bAlignIsExtended     := GlobalVars.st_bAlignIsExtended,
    i_bAlignIsRetracted    := GlobalVars.st_bAlignIsRetracted,
    i_bDischargeIsExtended := GlobalVars.st_bDischargeIsExtended,
    i_bDischargeIsRetracted:= GlobalVars.st_bDischargeIsRetracted,
    i_bVfdAlarm            := GlobalVars.st_bVfdAlarm,
    q_bInfeedExtend        => GlobalVars.st_bInfeedExtend,
    q_bInfeedRetract       => GlobalVars.st_bInfeedRetract,
    q_bAlignExtend         => GlobalVars.st_bAlignExtend,
    q_bAlignRetract        => GlobalVars.st_bAlignRetract,
    q_bDischargeExtend     => GlobalVars.st_bDischargeExtend,
    q_bDischargeRetract    => GlobalVars.st_bDischargeRetract,
    q_bFwdCmd              => GlobalVars.st_bFwdCmd,
    q_bRevCmd              => GlobalVars.st_bRevCmd,
    q_bSlowCmd             => GlobalVars.st_bSlowCmd,
    q_bReplyUpstream       => GlobalVars.st_bReplyUpstream,
    q_bReplyDownstream     => GlobalVars.st_bReplyDownstream,
    q_iState               => GlobalVars.st_iState,
    q_dwProductionCount    => GlobalVars.st_dwProductionCount,
    q_bInfeedActive        => GlobalVars.st_bInfeedActive,
    q_bIntAlarmMem         => GlobalVars.st_bIntAlarmMem
);

// ============================================================================
// 第六部分: FB_1030_SafetyManager (安全管理块测试, 安全区)
// ============================================================================
GlobalVars.SafetyMgr(
    i_arrSafetyFault := GlobalVars.sm_arrSafetyFault,
    i_arrEStopOk     := GlobalVars.sm_arrEStopOk,
    i_arrCurtainOk   := GlobalVars.sm_arrCurtainOk,
    i_arrDoorClosed  := GlobalVars.sm_arrDoorClosed,
    i_bFieldbusOk    := GlobalVars.sm_bFieldbusOk,
    i_bResetBtn      := GlobalVars.sm_bResetBtn,
    i_bStartBtn      := GlobalVars.sm_bStartBtn,
    i_bAutoMode      := GlobalVars.sm_bAutoMode,
    i_bMotionStopped := GlobalVars.sm_bMotionStopped,
    i_arrDoorReqBtn  := GlobalVars.sm_arrDoorReqBtn,
    q_bSafeToRun     => GlobalVars.sm_bSafeToRun,
    q_bStopNow       => GlobalVars.sm_bStopNow,
    q_bRunResetPulse => GlobalVars.sm_bRunResetPulse,
    q_bStartPulse    => GlobalVars.sm_bStartPulse,
    q_iState         => GlobalVars.sm_iState,
    q_dwAlarm        => GlobalVars.sm_dwAlarm,
    q_arrDoorUnlock  => GlobalVars.sm_arrDoorUnlock,
    q_arrDoorLamp    => GlobalVars.sm_arrDoorLamp
);

END_ORGANIZATION_BLOCK
