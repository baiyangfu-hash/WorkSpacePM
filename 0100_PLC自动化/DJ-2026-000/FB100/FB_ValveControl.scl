// ============================================================================
// FB_ValveControl.scl - 阀门控制功能块
// ============================================================================
// 功能说明：
//   实现阀门的基本控制逻辑,包括：
//   1. 自动/手动模式切换
//   2. 开阀/关阀命令处理
//   3. 过流故障检测与锁存
//   4. 限位开关检测
//   5. 故障复位功能
//
// 接口说明：
//   - 输入: 模式控制、操作命令、传感器信号、复位按钮
//   - 输出: 故障状态、阀门动作状态
//
// 变更记录：
//   V1.0.0 (2026-05-02): 初始版本
//          - 基于测试用例需求重建功能块
//          - 支持自动模式下的开阀/关阀逻辑
//          - 实现过流故障锁存和复位功能
// ============================================================================

FUNCTION_BLOCK FB_ValveControl
VAR_INPUT
    // =========================================================================
    // 第一部分：模式控制
    // =========================================================================
    AutoManual  : BOOL := FALSE;  // [输入] 自动/手动模式切换 (TRUE=自动, FALSE=手动)

    // =========================================================================
    // 第二部分：操作命令
    // =========================================================================
    OpenCmd     : BOOL := FALSE;  // [输入] 开阀命令 (上升沿触发)
    CloseCmd    : BOOL := FALSE;  // [输入] 关阀命令 (下降沿或电平触发)

    // =========================================================================
    // 第三部分：传感器信号
    // =========================================================================
    OverCurrent : BOOL := FALSE;  // [输入] 过流检测信号 (TRUE=过流故障)
    OpenLimit   : BOOL := FALSE;  // [输入] 开到位限位开关 (TRUE=已开到位)
    CloseLimit  : BOOL := FALSE;  // [输入] 关到位限位开关 (TRUE=已关到位)

    // =========================================================================
    // 第四部分：故障管理
    // =========================================================================
    FaultReset  : BOOL := FALSE;  // [输入] 故障复位按钮 (脉冲或电平)
END_VAR

VAR_OUTPUT
    // =========================================================================
    // 第五部分：状态输出
    // =========================================================================
    FaultStatus : BOOL := FALSE;  // [输出] 当前是否有故障 (TRUE=有故障)
    ValveOpen   : BOOL := FALSE;  // [输出] 阀门是否正在打开（或已打开）
    ValveClose  : BOOL := FALSE;  // [输出] 阀门是否正在关闭（或关闭）
     ValveState  : INT := 0;       // [输出] 阀门当前状态机状态
                                  //   0=关闭中/已关, 1=打开中, 2=已打开, 3=关闭中
END_VAR

VAR
    // =========================================================================
    // 第六部分：内部状态变量
    // =========================================================================
    s_iValveState : INT := 0;     // [内部] 阀门当前状态机状态 (块内判断用; 输出 ValveState 在提前返回处和块末尾才赋值)
                                  //   0=关闭中/已关, 1=打开中, 2=已打开, 3=关闭中

    OpenCmd_R   : BOOL := FALSE;   // [内部] 开阀命令上升沿检测（上一周期值）
    CloseCmd_R  : BOOL := FALSE;   // [内部] 关阀命令上升沿检测（上一周期值）

    FaultLocked : BOOL := FALSE;   // [内部] 故障锁存标志（防止故障自动清除）
END_VAR

BEGIN
    // ============================================================================
    // 第一部分：故障检测与锁存逻辑（最高优先级）
    // ============================================================================

    // 过流检测：一旦检测到过流,立即锁存故障
    IF #OverCurrent THEN
        #FaultLocked := TRUE;
        #FaultStatus := TRUE;

        // 强制停止所有阀门动作
        #ValveOpen := FALSE;
        #ValveClose := FALSE;
        #s_iValveState := 0;
    END_IF;

    // 故障复位：按下复位按钮且无过流信号时,清除故障锁存
    IF #FaultReset AND NOT #OverCurrent THEN
        #FaultLocked := FALSE;
        #FaultStatus := FALSE;
    END_IF;

    // 如果存在故障锁存,不执行后续逻辑
    IF #FaultLocked THEN
        #ValveState := #s_iValveState;   // 提前返回前也要把状态送到输出
        RETURN;
    END_IF;

    // ============================================================================
    // 第二部分：自动模式下的阀门控制逻辑
    // ============================================================================

    IF #AutoManual THEN
        // -----------------------------------------------------------------------
        // 开阀命令处理（上升沿触发）
        // -----------------------------------------------------------------------
        // 检测开阀命令的上升沿（当前为 TRUE 且上一周期为 FALSE）
        IF #OpenCmd AND NOT #OpenCmd_R THEN
            // 只有在未完全打开时才执行开阀动作
            IF #s_iValveState <> 2 THEN
                #s_iValveState := 1;           // 切换到"打开中"状态
                #ValveOpen := TRUE;         // 启动开阀动作
                #ValveClose := FALSE;       // 停止关阀动作
            END_IF;
        END_IF;

        // -----------------------------------------------------------------------
        // 关阀命令处理
        // -----------------------------------------------------------------------
        IF #CloseCmd THEN
            // 只有在未完全关闭时才执行关阀动作
            IF #s_iValveState <> 0 THEN
                #s_iValveState := 3;           // 切换到"关闭中"状态
                #ValveClose := TRUE;        // 启动关阀动作
                #ValveOpen := FALSE;        // 停止开阀动作
            END_IF;
        END_IF;

        // -----------------------------------------------------------------------
        // 限位开关状态更新
        // -----------------------------------------------------------------------
        // 开到位检测：如果开到位限位触发,标记为已打开
        IF #OpenLimit AND (#s_iValveState = 1) THEN
            #s_iValveState := 2;               // 切换到"已打开"状态
            #ValveOpen := FALSE;            // 停止开阀动作（已到位）
        END_IF;

        // 关到位检测：如果关到位限位触发,标记为已关闭
        IF #CloseLimit AND (#s_iValveState = 3) THEN
            #s_iValveState := 0;               // 切换到"已关闭"状态
            #ValveClose := FALSE;           // 停止关阀动作（已到位）
        END_IF;

    ELSE
        // 手动模式下,保持当前状态或执行简单逻辑
        // （根据测试用例,手动模式暂不实现复杂逻辑）
        #ValveOpen := FALSE;
        #ValveClose := FALSE;
    END_IF;

    // ============================================================================
    // 第三部分：边沿检测寄存器更新（必须放在最后）
    // ============================================================================
    #OpenCmd_R := #OpenCmd;
    #CloseCmd_R := #CloseCmd;

    // 输出只在提前返回处和此处赋值, 块内不再读取输出参数 (TIA 对读输出参数报警)。
    #ValveState := #s_iValveState;

END_FUNCTION_BLOCK
