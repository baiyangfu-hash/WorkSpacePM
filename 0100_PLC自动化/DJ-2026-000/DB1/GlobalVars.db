// ============================================================================
// GlobalVars.db - SysLib公共库FB测试套件全局变量
// ============================================================================
// 功能说明:
//   1. 保留 FB_ValveControl 实例(回归参考)
//   2. 新增 FB_1011_CylinderControl 实例(气缸控制测试)
//   3. 新增 FB_1012_ConveyorMotor 实例(输送电机测试)
//   4. 新增 FB_1014_StationConveyor 实例(工站输送机测试)
//   6. 新增 FB_1030_SafetyManager 实例(安全管理块测试, 2026-10-22)
//   5. HMI按钮数组用于测试驱动信号注入
//
// 变更记录:
//   V2.0.0 (2026-06-17): 重构为SysLib测试套件
//          - 新增FB_1011/FB_1012/FB_1014实例
//          - 保留FB_ValveControl作回归参考
//   V4.1.0 (2026-05-01): 初始版本(阀门控制+定时器示例)
// ============================================================================

DATA_BLOCK GlobalVars
    VAR
        // =========================================================================
        // 第一部分: HMI接口变量(测试信号注入)
        // =========================================================================
        Hmibutton : ARRAY[0..9] OF BOOL;  // HMI按钮状态数组(测试驱动用)

        // =========================================================================
        // 第二部分: 阀门控制变量(回归参考 - 保留)
        // =========================================================================
        ValveState : INT;
        ValveOpen : BOOL;
        ValveClose : BOOL;
        FaultStatus : BOOL;
        FaultReset : BOOL;
        ValveCtrl : FB_ValveControl;

        // =========================================================================
        // 第三部分: 定时器示例变量(回归参考 - 保留)
        // =========================================================================
        Counter_A : DINT := 0;
        bStart_A : Bool;
        bOut_A : Bool;
        Counter_B : DINT := 0;
        bStart_B : Bool;
        bOut_B : Bool;

        // =========================================================================
        // 第四部分: FB_1011_CylinderControl 测试实例
        // =========================================================================
        // 气缸控制实例 - 单线圈模式
        CylinderSingle : FB_1011_CylinderControl;
        // 气缸控制实例 - 双线圈模式
        CylinderDual : FB_1011_CylinderControl;

        // FB_1011 命令输入结构体 (stCmd: ST_CylinderCmd)
        cyl_stCmd : ST_CylinderCmd;
        // FB_1011 状态输出结构体 (stSts: ST_CylinderSts)
        cyl_stSts : ST_CylinderSts;

        // =========================================================================
        // 第五部分: FB_1012_ConveyorMotor 测试实例
        // =========================================================================
        ConveyorMotor : FB_1012_ConveyorMotor;

        // FB_1012 测试输入信号
        conv_bFwdCmd : BOOL;
        conv_bRevCmd : BOOL;
        conv_bSlowCmd : BOOL;
        conv_bVfdFault : BOOL := FALSE;
        conv_iCtrlMode : INT := 0;
        conv_rSpeed : REAL := 100.0;

        // FB_1012 测试输出信号
        conv_bFwdOut : BOOL;
        conv_bRevOut : BOOL;
        conv_bSlowOut : BOOL;
        conv_bRunning : BOOL;
        conv_bVfdAlarm : BOOL;

        // =========================================================================
        // 第六部分: FB_1014_StationConveyor 测试实例
        // =========================================================================
        StationConveyor : FB_1014_StationConveyor;

        // FB_1014 测试输入信号
        st_bAutoMode : BOOL := FALSE;
        st_bUpstreamReq : BOOL := FALSE;
        st_bDownstreamReq : BOOL := FALSE;
        st_bSelected : BOOL := FALSE;
        st_bProcessDone : BOOL := FALSE;
        st_bStop : BOOL := FALSE;
        st_bPause : BOOL := FALSE;
        st_bSlowMode : BOOL := FALSE;
        st_iMode : INT := 1;
        st_dInfeedDelayMs : DINT := 1000;
        st_dDischargeDelayMs : DINT := 1000;
        st_dAlignDelayMs : DINT := 500;
        st_dDebounceMs : DINT := 200;
        st_xInfeedStart : BOOL := FALSE;
        st_xPos1 : BOOL := FALSE;
        st_xPos2 : BOOL := FALSE;
        st_bInfeedIsExtended : BOOL := FALSE;
        st_bInfeedIsRetracted : BOOL := FALSE;
        st_bAlignIsExtended : BOOL := FALSE;
        st_bAlignIsRetracted : BOOL := FALSE;
        st_bDischargeIsExtended : BOOL := FALSE;
        st_bDischargeIsRetracted : BOOL := FALSE;
        st_bVfdAlarm : BOOL := FALSE;

        // FB_1014 测试输出信号
        st_bInfeedExtend : BOOL;
        st_bInfeedRetract : BOOL;
        st_bAlignExtend : BOOL;
        st_bAlignRetract : BOOL;
        st_bDischargeExtend : BOOL;
        st_bDischargeRetract : BOOL;
        st_bFwdCmd : BOOL;
        st_bRevCmd : BOOL;
        st_bSlowCmd : BOOL;
        st_bReplyUpstream : BOOL;
        st_bReplyDownstream : BOOL;
        st_iState : INT;
        st_dwProductionCount : DWORD;
        st_bInfeedActive : BOOL;
        st_bIntAlarmMem : BOOL;

        // =========================================================================
        // 第七部分: FB_1030_SafetyManager 测试实例 (2026-10-22, 安全区, 分支 claude/safety-manager-card004)
        // =========================================================================
        SafetyMgr : FB_1030_SafetyManager;

        // FB_1030 测试输入信号 (默认: 继电器正常、急停/光栅/门正常、总线在线、手动)
        sm_arrSafetyFault : ARRAY[0..3] OF BOOL;
        sm_arrEStopOk : ARRAY[0..7] OF BOOL := [8(TRUE)];
        sm_arrCurtainOk : ARRAY[0..7] OF BOOL := [8(TRUE)];
        sm_arrDoorClosed : ARRAY[0..7] OF BOOL := [8(TRUE)];
        sm_bFieldbusOk : BOOL := TRUE;
        sm_bResetBtn : BOOL := FALSE;
        sm_bStartBtn : BOOL := FALSE;
        sm_bAutoMode : BOOL := FALSE;
        sm_bMotionStopped : BOOL := FALSE;
        sm_arrDoorReqBtn : ARRAY[0..7] OF BOOL;

        // FB_1030 测试输出信号
        sm_bSafeToRun : BOOL;
        sm_bStopNow : BOOL;
        sm_bRunResetPulse : BOOL;
        sm_bStartPulse : BOOL;
        sm_iState : INT;
        sm_dwAlarm : DWORD;
        sm_arrDoorUnlock : ARRAY[0..7] OF BOOL;
        sm_arrDoorLamp : ARRAY[0..7] OF BOOL;

    END_VAR
END_DATA_BLOCK
