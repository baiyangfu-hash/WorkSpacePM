(* ================================================================= *)
(*  功能块名称: FB_1003_PickPlace_BufferFraming                       *)
(*  功能描述:   取放料机构 S20~S25 状态机 (2 根 / 4 根模式, Z + X1)  *)
(*  版本号:     V15.1.0 (2026-10-24, 增加 2 根 / 4 根取料模式)        *)
(*                                                                   *)
(*  依据:                                                            *)
(*    - 详细设计说明书_DSN.md 6 / 3.3; 接口文档_INT.md 4.6 / 5 / 8   *)
(*    - 原程序 PDF 的取放料块 (S20 待料 ~ S25 松开)                  *)
(*  遵循规范: LSP-905; 定时器用 SysLib FB_TON (毫秒)                 *)
(*                                                                   *)
(*  轴: Z = io_arrAxis[1], X1 = io_arrAxis[2] (沿用现有 GlobalVars    *)
(*  轴编号, 与原程序的轴号不同, 以信号名为准)。                      *)
(*  夹爪 / 升降缸的 Y40~Y43 由本 FB 统一写出, 回原点、准备、手动     *)
(*  通过 stPP 的 *Req 字段提出要求 (FB_2002 汇入)。                  *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1003_PickPlace_BufferFraming

VAR_IN_OUT
    io_stPP             : ST_PickPlace;     // 取放料数据
    io_stBridge         : ST_Bridge;        // 站间中继 (读: 层请求 / A、B 请求 / Hold)
    io_stMachine        : ST_Machine;       // 模式
    io_stIo             : ST_Io;            // 物理输入输出
    io_stAlarm          : ST_Alarm;         // 报警 (本 FB 不直接写, 经 arrTrig 汇总)
    io_arrAxis          : ARRAY[1..3] OF ST_ServoAxis;  // 轴: 1 = Z, 2 = X1, 3 = X2
END_VAR

VAR
    (* 过程定时器 *)
    fb_tSettle          : FB_TON;       // 步入口窗口 / S25 松开计时
    s_bSettleIn         : BOOL := FALSE;
    s_bSettleQ          : BOOL := FALSE;
    s_dSettleEt         : DINT := 0;
    fb_tAB              : FB_TON;       // A 或 B 请求出现满 0.5 s
    s_bABIn             : BOOL := FALSE;
    s_bABQ              : BOOL := FALSE;
    s_dABEt             : DINT := 0;
    fb_tClamp           : FB_TON;       // 夹紧超时 (F106)
    s_bClampIn          : BOOL := FALSE;
    s_bClampQ           : BOOL := FALSE;
    s_dClampEt          : DINT := 0;

    (* 报警定时器: F30~F33, F66~F73, F74, F75 *)
    fb_tF30             : FB_TON;
    s_bF30In            : BOOL := FALSE;
    s_bF30Q             : BOOL := FALSE;
    s_dF30Et            : DINT := 0;
    fb_tF31             : FB_TON;
    s_bF31In            : BOOL := FALSE;
    s_bF31Q             : BOOL := FALSE;
    s_dF31Et            : DINT := 0;
    fb_tF32             : FB_TON;
    s_bF32In            : BOOL := FALSE;
    s_bF32Q             : BOOL := FALSE;
    s_dF32Et            : DINT := 0;
    fb_tF33             : FB_TON;
    s_bF33In            : BOOL := FALSE;
    s_bF33Q             : BOOL := FALSE;
    s_dF33Et            : DINT := 0;
    fb_tF66             : FB_TON;
    s_bF66In            : BOOL := FALSE;
    s_bF66Q             : BOOL := FALSE;
    s_dF66Et            : DINT := 0;
    fb_tF67             : FB_TON;
    s_bF67In            : BOOL := FALSE;
    s_bF67Q             : BOOL := FALSE;
    s_dF67Et            : DINT := 0;
    fb_tF68             : FB_TON;
    s_bF68In            : BOOL := FALSE;
    s_bF68Q             : BOOL := FALSE;
    s_dF68Et            : DINT := 0;
    fb_tF69             : FB_TON;
    s_bF69In            : BOOL := FALSE;
    s_bF69Q             : BOOL := FALSE;
    s_dF69Et            : DINT := 0;
    fb_tF70             : FB_TON;
    s_bF70In            : BOOL := FALSE;
    s_bF70Q             : BOOL := FALSE;
    s_dF70Et            : DINT := 0;
    fb_tF71             : FB_TON;
    s_bF71In            : BOOL := FALSE;
    s_bF71Q             : BOOL := FALSE;
    s_dF71Et            : DINT := 0;
    fb_tF72             : FB_TON;
    s_bF72In            : BOOL := FALSE;
    s_bF72Q             : BOOL := FALSE;
    s_dF72Et            : DINT := 0;
    fb_tF73             : FB_TON;
    s_bF73In            : BOOL := FALSE;
    s_bF73Q             : BOOL := FALSE;
    s_dF73Et            : DINT := 0;
    fb_tF74             : FB_TON;
    s_bF74In            : BOOL := FALSE;
    s_bF74Q             : BOOL := FALSE;
    s_dF74Et            : DINT := 0;
    fb_tF75             : FB_TON;
    s_bF75In            : BOOL := FALSE;
    s_bF75Q             : BOOL := FALSE;
    s_dF75Et            : DINT := 0;

    (* 步与轴命令状态 *)
    s_iStep             : INT := 0;         // 0 未激活, 20~25
    s_iPhase            : INT := 0;         // 子相
    s_iGroup             : INT := 1;         // 1 = 组 1 (2 根模式 3+4 层, 4 根模式 1~4 层), 2 = 组 2 (1+2 层)
    s_bZGo              : BOOL := FALSE;    // Z 绝对定位进行中
    s_bX1Go             : BOOL := FALSE;    // X1 绝对定位进行中
    s_rZTarget          : REAL := 0.0;      // Z 目标
    s_rX1Target         : REAL := 0.0;      // X1 目标
    s_bXStarted         : BOOL := FALSE;    // S20 中 X1 已出发 (不再算静止)
    s_bAxisOwned        : BOOL := FALSE;    // 本 FB 持有过轴命令, 离开自动时需撤销

    (* 派生量 *)
    s_bHold             : BOOL := FALSE;
    s_bAnyBusy          : BOOL := FALSE;    // 三轴任一在驱动
    s_bZAtStandby       : BOOL := FALSE;
    s_rZErr             : REAL := 0.0;
    s_bProdAll          : BOOL := FALSE;    // X60~X63 全亮
    s_bClampedAll       : BOOL := FALSE;    // 4 个夹紧位全亮
    s_bReleasedAll      : BOOL := FALSE;    // 4 个松开位全亮
    s_bAnyClamped       : BOOL := FALSE;    // 任一夹紧位亮
    s_bAnyReleased      : BOOL := FALSE;    // 任一松开位亮
    s_bGroupA           : BOOL := FALSE;    // 组 1 请求成立 (A 且组 1 各层请求)
    s_bGroupB           : BOOL := FALSE;    // 组 2 请求成立 (B 且 1、2 层请求; 4 根模式不用)
    s_bGroupReq         : BOOL := FALSE;    // 已选组的各层请求仍在
    s_bQuad             : BOOL := FALSE;    // 生效模式 = 一次 4 根
    s_bModeOk           : BOOL := FALSE;    // HMI 请求的模式本机支持 (4 根需要 4 个夹爪)
    s_bModeInit         : BOOL := TRUE;     // 上电第一扫描: 把请求值同步成生效模式 (防请求值没保持而改掉保持的模式)
    s_bGripShort        : BOOL := FALSE;    // 生效模式为 4 根但夹爪个数不足 4
    s_bModeSwitchOk     : BOOL := FALSE;    // 允许切换: 非自动、非回原点 / 准备、取放料静止、夹爪与小车无料
    s_bAnyProd          : BOOL := FALSE;    // 夹爪里任一产品检测亮
    s_bFeederAny        : BOOL := FALSE;    // 小车任一光电亮
END_VAR

VAR CONSTANT
    AX_Z                : INT := 1;     // Z 轴下标
    AX_X1               : INT := 2;     // X1 轴下标
    AX_X2               : INT := 3;     // X2 轴下标
    STEP_NONE           : INT := 0;
    STEP_S20            : INT := 20;    // 待料: Z 到待机点, X1 到取料点
    STEP_S21            : INT := 21;    // 取料准备: 升降缸上升, Z 升到取料高度
    STEP_S22            : INT := 22;    // 夹紧
    STEP_S23            : INT := 23;    // X1 横移到放料点
    STEP_S24            : INT := 24;    // 放料: 升降缸下降, Z 降到放料高度
    STEP_S25            : INT := 25;    // 松开
    PH_WINDOW           : INT := 0;     // 步入口窗口
    PH_MOVE             : INT := 1;     // 轴运动
    PH_WAIT             : INT := 2;     // 等待转移
END_VAR

BEGIN
    REGION 00_Timers 定时器统一调用 (顶部, 无条件)
    fb_tSettle(IN := s_bSettleIn, PT := io_stPP.dSettleMs, Q => s_bSettleQ, ET => s_dSettleEt);
    fb_tAB(IN := s_bABIn, PT := io_stPP.dSettleMs, Q => s_bABQ, ET => s_dABEt);
    fb_tClamp(IN := s_bClampIn, PT := io_stPP.dClampTimeoutMs, Q => s_bClampQ, ET => s_dClampEt);
    fb_tF30(IN := s_bF30In, PT := io_stPP.dCylTimeoutMs, Q => s_bF30Q, ET => s_dF30Et);
    fb_tF31(IN := s_bF31In, PT := io_stPP.dCylTimeoutMs, Q => s_bF31Q, ET => s_dF31Et);
    fb_tF32(IN := s_bF32In, PT := io_stPP.dCylTimeoutMs, Q => s_bF32Q, ET => s_dF32Et);
    fb_tF33(IN := s_bF33In, PT := io_stPP.dCylTimeoutMs, Q => s_bF33Q, ET => s_dF33Et);
    fb_tF66(IN := s_bF66In, PT := io_stPP.dCylTimeoutMs, Q => s_bF66Q, ET => s_dF66Et);
    fb_tF67(IN := s_bF67In, PT := io_stPP.dCylTimeoutMs, Q => s_bF67Q, ET => s_dF67Et);
    fb_tF68(IN := s_bF68In, PT := io_stPP.dCylTimeoutMs, Q => s_bF68Q, ET => s_dF68Et);
    fb_tF69(IN := s_bF69In, PT := io_stPP.dCylTimeoutMs, Q => s_bF69Q, ET => s_dF69Et);
    fb_tF70(IN := s_bF70In, PT := io_stPP.dCylTimeoutMs, Q => s_bF70Q, ET => s_dF70Et);
    fb_tF71(IN := s_bF71In, PT := io_stPP.dCylTimeoutMs, Q => s_bF71Q, ET => s_dF71Et);
    fb_tF72(IN := s_bF72In, PT := io_stPP.dCylTimeoutMs, Q => s_bF72Q, ET => s_dF72Et);
    fb_tF73(IN := s_bF73In, PT := io_stPP.dCylTimeoutMs, Q => s_bF73Q, ET => s_dF73Et);
    fb_tF74(IN := s_bF74In, PT := io_stPP.dCylTimeoutMs, Q => s_bF74Q, ET => s_dF74Et);
    fb_tF75(IN := s_bF75In, PT := io_stPP.dCylTimeoutMs, Q => s_bF75Q, ET => s_dF75Et);
    END_REGION

    REGION 01_Derived 派生量
    s_bHold := io_stBridge.bHoldPP;
    s_bAnyBusy := io_arrAxis[AX_Z].stAbs.Busy OR io_arrAxis[AX_Z].stJog.Busy OR io_arrAxis[AX_Z].stHome.Busy
                  OR io_arrAxis[AX_X1].stAbs.Busy OR io_arrAxis[AX_X1].stJog.Busy OR io_arrAxis[AX_X1].stHome.Busy
                  OR io_arrAxis[AX_X2].stAbs.Busy OR io_arrAxis[AX_X2].stJog.Busy OR io_arrAxis[AX_X2].stHome.Busy;
    s_rZErr := io_arrAxis[AX_Z].rCurrentPos - io_stPP.rZStandby;
    IF s_rZErr < 0.0 THEN
        s_rZErr := 0.0 - s_rZErr;
    END_IF;
    s_bZAtStandby := (s_rZErr <= io_stPP.rPosTol);
    s_bAnyProd := io_stIo.bPPFrontProd1 OR io_stIo.bPPFrontProd2 OR io_stIo.bPPRearProd1 OR io_stIo.bPPRearProd2
                  OR io_stIo.bPPG3Prod1 OR io_stIo.bPPG3Prod2 OR io_stIo.bPPG4Prod1 OR io_stIo.bPPG4Prod2;
    s_bFeederAny := io_stIo.bFeederFrontEye1 OR io_stIo.bFeederFrontEye2 OR io_stIo.bFeederRearEye1 OR io_stIo.bFeederRearEye2;

    // 取料模式: 请求的模式本机支持才算有效 (2 根恒支持, 4 根要 4 个夹爪); 无效只置提示位, 不占报警号
    IF s_bModeInit THEN
        io_stPP.iPickModeReq := io_stPP.iPickMode;
        s_bModeInit := FALSE;
    END_IF;
    s_bModeOk := (io_stPP.iPickModeReq = 2) OR ((io_stPP.iPickModeReq = 4) AND (io_stPP.iGripCount >= 4));
    s_bGripShort := (io_stPP.iPickMode = 4) AND (io_stPP.iGripCount < 4);
    io_stPP.bModeInvalid := (NOT s_bModeOk) OR s_bGripShort;
    // 切换只在: 非自动、非回原点 / 准备、取放料未激活、夹爪和小车都没料 (R-PP-13)
    s_bModeSwitchOk := (NOT io_stMachine.bAuto) AND (NOT io_stMachine.bHoming) AND (NOT io_stMachine.bPrepare)
                       AND (s_iStep = STEP_NONE) AND (NOT s_bAnyProd) AND (NOT s_bFeederAny);
    IF s_bGripShort AND s_bModeSwitchOk THEN
        // 夹爪个数配置变小: 能切时回到 2 根模式 (自动中不切, 提示位一直亮)
        io_stPP.iPickMode := 2;
    ELSIF s_bModeOk AND s_bModeSwitchOk THEN
        io_stPP.iPickMode := io_stPP.iPickModeReq;
    END_IF;
    s_bQuad := (io_stPP.iPickMode = 4);
    IF s_bQuad THEN
        io_stPP.iGroupCount := 1;
    ELSE
        io_stPP.iGroupCount := 2;
    END_IF;

    s_bProdAll := io_stIo.bPPFrontProd1 AND io_stIo.bPPFrontProd2 AND io_stIo.bPPRearProd1 AND io_stIo.bPPRearProd2;
    s_bClampedAll := io_stIo.bPPRearClamp1 AND io_stIo.bPPRearClamp2 AND io_stIo.bPPFrontClamp1 AND io_stIo.bPPFrontClamp2;
    s_bReleasedAll := io_stIo.bPPRearOpen1 AND io_stIo.bPPRearOpen2 AND io_stIo.bPPFrontOpen1 AND io_stIo.bPPFrontOpen2;
    s_bAnyClamped := io_stIo.bPPRearClamp1 OR io_stIo.bPPRearClamp2 OR io_stIo.bPPFrontClamp1 OR io_stIo.bPPFrontClamp2;
    s_bAnyReleased := io_stIo.bPPRearOpen1 OR io_stIo.bPPRearOpen2 OR io_stIo.bPPFrontOpen1 OR io_stIo.bPPFrontOpen2;
    IF s_bQuad THEN
        // 4 根模式: 夹爪 3、4 的检测并入 (预留信号, 005 无此夹爪, 不会进入本模式)
        s_bProdAll := s_bProdAll AND io_stIo.bPPG3Prod1 AND io_stIo.bPPG3Prod2 AND io_stIo.bPPG4Prod1 AND io_stIo.bPPG4Prod2;
        s_bClampedAll := s_bClampedAll AND io_stIo.bPPG3Clamp1 AND io_stIo.bPPG3Clamp2
                         AND io_stIo.bPPG4Clamp1 AND io_stIo.bPPG4Clamp2;
        s_bReleasedAll := s_bReleasedAll AND io_stIo.bPPG3Open1 AND io_stIo.bPPG3Open2
                          AND io_stIo.bPPG4Open1 AND io_stIo.bPPG4Open2;
        s_bAnyClamped := s_bAnyClamped OR io_stIo.bPPG3Clamp1 OR io_stIo.bPPG3Clamp2
                         OR io_stIo.bPPG4Clamp1 OR io_stIo.bPPG4Clamp2;
        s_bAnyReleased := s_bAnyReleased OR io_stIo.bPPG3Open1 OR io_stIo.bPPG3Open2
                          OR io_stIo.bPPG4Open1 OR io_stIo.bPPG4Open2;
    END_IF;
    // 取料组: 2 根模式 组 1 (A) = 3、4 层, 组 2 (B) = 1、2 层; 4 根模式只有组 1 = 1~4 层
    IF s_bQuad THEN
        s_bGroupA := io_stBridge.bReqA AND io_stBridge.abLayerReq[1] AND io_stBridge.abLayerReq[2]
                     AND io_stBridge.abLayerReq[3] AND io_stBridge.abLayerReq[4];
        s_bGroupB := FALSE;
        s_bGroupReq := io_stBridge.abLayerReq[1] AND io_stBridge.abLayerReq[2]
                       AND io_stBridge.abLayerReq[3] AND io_stBridge.abLayerReq[4];
    ELSE
        s_bGroupA := io_stBridge.bReqA AND io_stBridge.abLayerReq[3] AND io_stBridge.abLayerReq[4];
        s_bGroupB := io_stBridge.bReqB AND io_stBridge.abLayerReq[1] AND io_stBridge.abLayerReq[2];
        IF s_iGroup = 1 THEN
            s_bGroupReq := io_stBridge.abLayerReq[3] AND io_stBridge.abLayerReq[4];
        ELSE
            s_bGroupReq := io_stBridge.abLayerReq[1] AND io_stBridge.abLayerReq[2];
        END_IF;
    END_IF;

    (* 过程定时器 IN 每扫描先清零, 由所在步重新置位 (Hold / Reset 时即清零重算) *)
    s_bSettleIn := FALSE;
    s_bABIn := FALSE;
    s_bClampIn := FALSE;
    END_REGION

    REGION 02_ModuleRequests 其他机构对夹爪 / 升降缸的要求 (回原点 / 准备 / 手动)
    IF io_stPP.bGripOpenReq THEN
        io_stPP.bClampFront := FALSE;
        io_stPP.bClampRear := FALSE;
        io_stPP.bClampG3 := FALSE;
        io_stPP.bClampG4 := FALSE;
    END_IF;
    IF io_stPP.bLiftDownReq THEN
        io_stPP.bLiftDown := TRUE;
        io_stPP.bLiftUp := FALSE;
    ELSIF io_stPP.bLiftUpReq THEN
        io_stPP.bLiftUp := TRUE;
        io_stPP.bLiftDown := FALSE;
    END_IF;
    END_REGION

    REGION 03_Sequence 步序
    IF (NOT io_stMachine.bAuto) OR io_stMachine.bFault THEN
        // 非自动或异常停机: 步序回 0, 轴命令清除; 夹爪和升降缸不动 (R-PP-09)
        s_iStep := STEP_NONE;
        s_iPhase := PH_WINDOW;
        s_bZGo := FALSE;
        s_bX1Go := FALSE;
        s_bXStarted := FALSE;
    ELSIF NOT s_bHold THEN
        CASE s_iStep OF
            STEP_NONE:
                // 自动且三轴都不在驱动且无 Hold: 进入 S20
                IF NOT s_bAnyBusy THEN
                    s_iStep := STEP_S20;
                    s_iPhase := PH_WINDOW;
                END_IF;

            STEP_S20:
                IF s_iPhase = PH_WINDOW THEN
                    // 入口窗口: 松开全部夹爪, 清 4 个"取料完成"
                    io_stPP.bClampFront := FALSE;
                    io_stPP.bClampRear := FALSE;
                    io_stPP.bClampG3 := FALSE;
                    io_stPP.bClampG4 := FALSE;
                    io_stPP.abPickDone[1] := FALSE;
                    io_stPP.abPickDone[2] := FALSE;
                    io_stPP.abPickDone[3] := FALSE;
                    io_stPP.abPickDone[4] := FALSE;
                    s_bSettleIn := TRUE;
                    IF s_bSettleQ THEN
                        s_bSettleIn := FALSE;
                        s_iPhase := PH_MOVE;
                    END_IF;
                ELSE
                    IF NOT s_bZAtStandby THEN
                        // Z 先动: 到待机点
                        IF NOT s_bZGo THEN
                            s_rZTarget := io_stPP.rZStandby;
                            s_bZGo := TRUE;
                        END_IF;
                    ELSIF NOT s_bX1Go THEN
                        // Z 到位后: 组 1 (A) 或组 2 (B) 请求出现满 0.5 s, 且不在停止收尾中
                        s_bABIn := (s_bGroupA OR s_bGroupB) AND (NOT io_stMachine.bStopPending);
                        IF s_bABQ THEN
                            IF s_bGroupA THEN
                                s_iGroup := 1;
                            ELSE
                                s_iGroup := 2;
                            END_IF;
                            s_rX1Target := io_stPP.astGroup[s_iGroup].rXPick;
                            s_bX1Go := TRUE;
                            s_bXStarted := TRUE;
                            s_bABIn := FALSE;
                        END_IF;
                    END_IF;
                    IF s_bZGo AND io_arrAxis[AX_Z].stAbs.Done THEN
                        s_bZGo := FALSE;
                    END_IF;
                    IF s_bX1Go AND io_arrAxis[AX_X1].stAbs.Done THEN
                        s_bX1Go := FALSE;
                        s_bXStarted := FALSE;
                        s_iStep := STEP_S21;
                        s_iPhase := PH_WINDOW;
                    END_IF;
                END_IF;

            STEP_S21:
                // 升降缸上升
                io_stPP.bLiftUp := TRUE;
                io_stPP.bLiftDown := FALSE;
                IF s_iPhase = PH_WINDOW THEN
                    s_bSettleIn := TRUE;
                    IF s_bSettleQ THEN
                        s_bSettleIn := FALSE;
                        s_iPhase := PH_MOVE;
                    END_IF;
                ELSE
                    IF s_bZGo THEN
                        IF io_arrAxis[AX_Z].stAbs.Done THEN
                            s_bZGo := FALSE;
                            s_iStep := STEP_S22;
                            s_iPhase := PH_WAIT;
                        END_IF;
                    ELSIF s_bReleasedAll AND (NOT s_bAnyClamped) AND s_bGroupReq AND io_stIo.bPPLiftUp THEN
                        // 4 松开位亮, 4 夹紧位灭, 两层请求仍在, 升降缸已在上位: Z 升到取料高度
                        s_rZTarget := io_stPP.astGroup[s_iGroup].rZPick;
                        s_bZGo := TRUE;
                    END_IF;
                END_IF;

            STEP_S22:
                // 夹紧: 升降缸在上位才夹; 夹紧位 + 产品检测都到才转移; 5 s 不满足报 F106 并停在 S22
                IF io_stIo.bPPLiftUp THEN
                    io_stPP.bClampFront := TRUE;
                    io_stPP.bClampRear := TRUE;
                    IF s_bQuad THEN
                        io_stPP.bClampG3 := TRUE;
                        io_stPP.bClampG4 := TRUE;
                    END_IF;
                END_IF;
                s_bClampIn := io_stPP.bClampFront AND io_stPP.bClampRear;
                IF s_bQuad THEN
                    s_bClampIn := s_bClampIn AND io_stPP.bClampG3 AND io_stPP.bClampG4;
                END_IF;
                IF s_bClampedAll AND (NOT s_bAnyReleased) AND (s_bProdAll OR io_stMachine.bSimulate) THEN
                    s_bClampIn := FALSE;
                    s_iStep := STEP_S23;
                    s_iPhase := PH_WINDOW;
                END_IF;

            STEP_S23:
                // X1 横移到放料点; Z、夹爪、升降缸不动
                IF s_iPhase = PH_WINDOW THEN
                    s_bSettleIn := TRUE;
                    IF s_bSettleQ THEN
                        s_bSettleIn := FALSE;
                        s_iPhase := PH_MOVE;
                    END_IF;
                ELSE
                    IF s_bX1Go THEN
                        IF io_arrAxis[AX_X1].stAbs.Done THEN
                            s_bX1Go := FALSE;
                            s_iStep := STEP_S24;
                            s_iPhase := PH_WINDOW;
                        END_IF;
                    ELSE
                        s_rX1Target := io_stPP.astGroup[s_iGroup].rXPlace;
                        s_bX1Go := TRUE;
                    END_IF;
                END_IF;

            STEP_S24:
                // 放料: 一进步就命令升降缸下降; 窗口内置"取料完成", 清对应"X1 送料完成"
                io_stPP.bLiftDown := TRUE;
                io_stPP.bLiftUp := FALSE;
                IF s_iPhase = PH_WINDOW THEN
                    IF s_bQuad THEN
                        io_stPP.abPickDone[1] := TRUE;
                        io_stPP.abPickDone[2] := TRUE;
                        io_stPP.abPickDone[3] := TRUE;
                        io_stPP.abPickDone[4] := TRUE;
                    ELSIF s_iGroup = 1 THEN
                        io_stPP.abPickDone[4] := TRUE;
                        io_stPP.abPickDone[3] := TRUE;
                    ELSE
                        io_stPP.abPickDone[2] := TRUE;
                        io_stPP.abPickDone[1] := TRUE;
                    END_IF;
                    io_stPP.abFeedDone[s_iGroup] := FALSE;
                    s_bSettleIn := TRUE;
                    IF s_bSettleQ THEN
                        s_bSettleIn := FALSE;
                        s_iPhase := PH_MOVE;
                    END_IF;
                ELSE
                    IF s_bZGo THEN
                        IF io_arrAxis[AX_Z].stAbs.Done THEN
                            s_bZGo := FALSE;
                            s_iStep := STEP_S25;
                            s_iPhase := PH_WAIT;
                        END_IF;
                    ELSIF io_stIo.bPPLiftDown AND (NOT io_stIo.bPPLiftUp) THEN
                        // 升降缸下位亮且上位灭: Z 降到放料高度
                        s_rZTarget := io_stPP.rZPlace;
                        s_bZGo := TRUE;
                    END_IF;
                END_IF;

            STEP_S25:
                // 松开全部夹爪, 计时到且松开位全亮: 置该组"X1 送料完成", 回 S20
                io_stPP.bClampFront := FALSE;
                io_stPP.bClampRear := FALSE;
                io_stPP.bClampG3 := FALSE;
                io_stPP.bClampG4 := FALSE;
                s_bSettleIn := TRUE;
                IF s_bSettleQ AND s_bReleasedAll THEN
                    s_bSettleIn := FALSE;
                    io_stPP.abFeedDone[s_iGroup] := TRUE;
                    s_iStep := STEP_S20;
                    s_iPhase := PH_WINDOW;
                END_IF;

        ELSE
            // 步序异常值: 回安全步 0
            s_iStep := STEP_NONE;
            s_iPhase := PH_WINDOW;
            s_bZGo := FALSE;
            s_bX1Go := FALSE;
        END_CASE;
    END_IF;
    END_REGION

    REGION 04_AxisCommand 轴命令: 自动模式持有, Hold 时 Halt, 离开自动时撤销
    IF io_stMachine.bAuto AND (NOT io_stMachine.bFault) THEN
        s_bAxisOwned := TRUE;
        IF s_bZGo AND (NOT s_bHold) THEN
            io_arrAxis[AX_Z].stAbs.Position := s_rZTarget;
            io_arrAxis[AX_Z].stAbs.Velocity := io_stPP.rAutoSpeed;
            io_arrAxis[AX_Z].stAbs.Execute := TRUE;
            io_arrAxis[AX_Z].stHalt.Execute := FALSE;
        ELSE
            io_arrAxis[AX_Z].stAbs.Execute := FALSE;
            io_arrAxis[AX_Z].stHalt.Execute := s_bZGo AND s_bHold;
        END_IF;
        IF s_bX1Go AND (NOT s_bHold) THEN
            io_arrAxis[AX_X1].stAbs.Position := s_rX1Target;
            io_arrAxis[AX_X1].stAbs.Velocity := io_stPP.rAutoSpeed;
            io_arrAxis[AX_X1].stAbs.Execute := TRUE;
            io_arrAxis[AX_X1].stHalt.Execute := FALSE;
        ELSE
            io_arrAxis[AX_X1].stAbs.Execute := FALSE;
            io_arrAxis[AX_X1].stHalt.Execute := s_bX1Go AND s_bHold;
        END_IF;
        io_arrAxis[AX_Z].stStop.Execute := FALSE;
        io_arrAxis[AX_X1].stStop.Execute := FALSE;
    ELSIF s_bAxisOwned THEN
        // 离开自动: 撤销绝对定位; 异常停机给 Stop, 进手动时仍在动的轴给 Halt
        io_arrAxis[AX_Z].stAbs.Execute := FALSE;
        io_arrAxis[AX_X1].stAbs.Execute := FALSE;
        io_arrAxis[AX_Z].stStop.Execute := io_stMachine.bFault;
        io_arrAxis[AX_X1].stStop.Execute := io_stMachine.bFault;
        io_arrAxis[AX_Z].stHalt.Execute := io_arrAxis[AX_Z].stAbs.Busy;
        io_arrAxis[AX_X1].stHalt.Execute := io_arrAxis[AX_X1].stAbs.Busy;
        s_bAxisOwned := io_stMachine.bFault OR io_arrAxis[AX_Z].stAbs.Busy OR io_arrAxis[AX_X1].stAbs.Busy;
    END_IF;
    END_REGION

    REGION 05_GripperLiftOutput 夹爪 / 升降缸输出
    io_stIo.bQPPRearClamp := io_stPP.bClampRear;
    io_stIo.bQPPFrontClamp := io_stPP.bClampFront;
    io_stIo.bQPPG3Clamp := io_stPP.bClampG3;        // 预留, 005 未接线
    io_stIo.bQPPG4Clamp := io_stPP.bClampG4;        // 预留, 005 未接线
    io_stIo.bQPPLiftUp := io_stPP.bLiftUp;
    io_stIo.bQPPLiftDown := io_stPP.bLiftDown;
    END_REGION

    REGION 06_SafeZone 安全区 (R-CONV-03): 自动时不在 S22 / S23 其余模式 Z 不高于待机点
    IF io_stMachine.bAuto THEN
        io_stPP.bSafeZone := (s_iStep <> STEP_S22) AND (s_iStep <> STEP_S23);
    ELSE
        io_stPP.bSafeZone := (io_arrAxis[AX_Z].rCurrentPos <= (io_stPP.rZStandby + io_stPP.rPosTol));
    END_IF;
    END_REGION

    REGION 07_AlarmTrigger 报警触发
    // F30 / F31: 后夹爪夹紧命令 ON 但前夹料产品检测 1 / 2 灭 (原程序命名交叉, 保持); 本机模拟时不报
    s_bF30In := io_stPP.bClampRear AND (NOT io_stIo.bPPFrontProd1) AND (NOT io_stMachine.bSimulate);
    s_bF31In := io_stPP.bClampRear AND (NOT io_stIo.bPPFrontProd2) AND (NOT io_stMachine.bSimulate);
    // F32 / F33: 前夹爪夹紧命令 ON 但后夹料产品检测 1 / 2 灭
    s_bF32In := io_stPP.bClampFront AND (NOT io_stIo.bPPRearProd1) AND (NOT io_stMachine.bSimulate);
    s_bF33In := io_stPP.bClampFront AND (NOT io_stIo.bPPRearProd2) AND (NOT io_stMachine.bSimulate);
    // F66~F69: 后夹爪 夹紧位 1 / 2, 松开位 1 / 2 与命令不符
    s_bF66In := io_stPP.bClampRear AND (NOT io_stIo.bPPRearClamp1);
    s_bF67In := io_stPP.bClampRear AND (NOT io_stIo.bPPRearClamp2);
    s_bF68In := (NOT io_stPP.bClampRear) AND (NOT io_stIo.bPPRearOpen1);
    s_bF69In := (NOT io_stPP.bClampRear) AND (NOT io_stIo.bPPRearOpen2);
    // F70~F73: 前夹爪 夹紧位 1 / 2, 松开位 1 / 2 与命令不符
    s_bF70In := io_stPP.bClampFront AND (NOT io_stIo.bPPFrontClamp1);
    s_bF71In := io_stPP.bClampFront AND (NOT io_stIo.bPPFrontClamp2);
    s_bF72In := (NOT io_stPP.bClampFront) AND (NOT io_stIo.bPPFrontOpen1);
    s_bF73In := (NOT io_stPP.bClampFront) AND (NOT io_stIo.bPPFrontOpen2);
    // F74 / F75: 升降缸上升 / 下降命令后上位 / 下位未到
    s_bF74In := io_stPP.bLiftUp AND (NOT io_stIo.bPPLiftUp);
    s_bF75In := io_stPP.bLiftDown AND (NOT io_stIo.bPPLiftDown);
    io_stPP.arrTrig[1] := s_bF30Q;
    io_stPP.arrTrig[2] := s_bF31Q;
    io_stPP.arrTrig[3] := s_bF32Q;
    io_stPP.arrTrig[4] := s_bF33Q;
    io_stPP.arrTrig[5] := s_bF66Q;
    io_stPP.arrTrig[6] := s_bF67Q;
    io_stPP.arrTrig[7] := s_bF68Q;
    io_stPP.arrTrig[8] := s_bF69Q;
    io_stPP.arrTrig[9] := s_bF70Q;
    io_stPP.arrTrig[10] := s_bF71Q;
    io_stPP.arrTrig[11] := s_bF72Q;
    io_stPP.arrTrig[12] := s_bF73Q;
    io_stPP.arrTrig[13] := s_bF74Q;
    io_stPP.arrTrig[14] := s_bF75Q;
    io_stPP.arrTrig[15] := s_bClampQ;       // F106 夹紧超时 (只报警, 停在 S22 等待)
    END_REGION

    REGION 08_StatusOutput 状态输出
    io_stPP.iStep := s_iStep;
    io_stPP.iPhase := s_iPhase;
    io_stPP.iGroup := s_iGroup;
    io_stPP.bAtRest := (s_iStep = STEP_NONE) OR ((s_iStep = STEP_S20) AND (NOT s_bXStarted));
    END_REGION

END_FUNCTION_BLOCK
