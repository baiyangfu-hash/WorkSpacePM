(* ================================================================= *)
(*  类型名称：ST_PickGroup                                       *)
(*  功能描述：取料组的一组点位 (2 根模式 2 组, 4 根模式 1 组)                            *)
(*  版本号：V1.0.0 (2026-10-24, DJ-2026-005 新设计)                    *)
(*  依据：接口文档_INT.md                                              *)
(* ================================================================= *)

TYPE ST_PickGroup
STRUCT
    rXPick                  : REAL;     // X1 取料点 (A: D510, B: D540)
    rZPick                  : REAL;     // Z 取料高度 (A: D514, B: D544)
    rXPlace                 : REAL;     // X1 放料点 (A: D520, B: D550)
END_STRUCT
END_TYPE
