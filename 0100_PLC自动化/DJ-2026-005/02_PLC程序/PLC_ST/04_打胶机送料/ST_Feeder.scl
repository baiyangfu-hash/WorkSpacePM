(* ================================================================= *)
(*  类型名称：ST_Feeder                                               *)
(*  功能描述：X2 送料小车数据结构体 (FB_1004 通过 VAR_IN_OUT 传递)     *)
(*  版本号：V1.0.0 (2026-10-24, DJ-2026-005 新设计)                    *)
(*  依据：接口文档_INT.md 4.7; 光电与 X76 / X102 直接读 ST_Io          *)
(* ================================================================= *)

TYPE ST_Feeder
STRUCT
    (* ------------------ 状态 ------------------ *)
    iStep                   : INT;      // 0~3 (D760)
    bAtRest                 : BOOL;     // 静止点 (步 0 / 1)
    bReqA                   : BOOL;     // 组 1 请求 A
    bReqB                   : BOOL;     // 组 2 请求 B (4 根模式不用)
    bY44                    : BOOL;     // 抓料可 / 送框信号 (Y44)
    bY47                    : BOOL;     // 安全区信号: X2 在取料点 (Y47)
    bFeedPermit             : BOOL;     // 出发许可 (来自 FB_3001, 由 FB_2002 汇入)

    (* ------------------ 点位与时间 ------------------ *)
    rPosPick                : REAL := 0.0;          // D512 X2 取料点
    rPosFeed                : REAL := 0.0;          // D522 X2 送料点
    rAutoSpeed              : REAL := 10000.0;      // 自动速度 D600 (FB_2002 由取放料同步)
    rPosTol                 : REAL := 10.0;         // 位置判定容差 (脉冲, 待现场整定)
    dSettleMs               : DINT := 500;          // 步入口窗口
    dFeedFullMs             : DINT := 10000;        // 4 光电全亮计时 (步 1)
    dFeedEmptyMs            : DINT := 10000;        // 光电全灭持续超时, 与 X102 二选一返回
    dEyeAlarmMs             : DINT := 1000;         // 光电异常报警 (F90 / F91)

    (* ------------------ 报警触发 ------------------ *)
    // [0] F90 前光电异常, [1] F91 后光电异常, [2] F107 已取消 (恒 FALSE), [3..4] 预留
    // (F22 / F23 X2 极限由 FB_1001 直接写 stAlarm)
    arrTrig                 : ARRAY[0..4] OF BOOL;      // 报警触发: [0] F90, [1] F91, [2] F107 已取消, [3..4] 预留
END_STRUCT
END_TYPE
