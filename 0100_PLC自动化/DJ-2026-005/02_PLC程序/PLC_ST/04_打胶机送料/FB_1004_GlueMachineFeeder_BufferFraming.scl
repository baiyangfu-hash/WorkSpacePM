(* ================================================================= *)
(*  功能块名称: FB_1004_GlueMachineFeeder_BufferFraming               *)
(*  功能描述:   X2 送料小车 4 步 (D760) + 打胶机握手 (Y44 / Y47 / X102) *)
(*  版本号:     V15.0.0 (2026-10-24, 依据新设计重写, 取代 V14.x)      *)
(*                                                                   *)
(*  依据: 详细设计说明书_DSN.md 7; 接口文档_INT.md 4.7 / 5 / 8       *)
(*  遵循规范: LSP-905; 定时器用 SysLib FB_TON (毫秒)                 *)
(*  轴: X2 = io_astAxis[3]; Z = io_astAxis[1] 只读位置。             *)
(*                                                                   *)
(*  与 DSN 的差异 (评审请确认):                                      *)
(*    步 3 的 X102 上升沿先锁存, 光电全灭后即转步 0 (原程序要求      *)
(*    "光电全灭 ∧ X102 上升沿" 同一扫描成立, 若 X102 比光电灭得早      *)
(*    会永远转不回步 0)。                                             *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1004_GlueMachineFeeder_BufferFraming

VAR_IN_OUT
    io_stFeed           : ST_Feeder;        // 小车数据
    io_stBridge         : ST_Bridge;        // 站间中继 (读: X1 送料完成 / 取放料在 S20 / Z 待机点 / Hold)
    io_stExt            : ST_ExternalLink;  // 组框机链路 (读)
    io_stMachine        : ST_Machine;       // 模式
    io_stIo             : ST_Io;            // 物理输入输出
    io_stAlarm          : ST_Alarm;         // 报警 (本 FB 不直接写, 经 arrTrig 汇总)
    io_astAxis          : ARRAY[1..3] OF ST_ServoAxis;  // 轴: 1 = Z, 2 = X1, 3 = X2
END_VAR

VAR
    (* 过程定时器 *)
    fb_tSettle          : FB_TON;       // 步 0 / 步 2 入口窗口
    s_bSettleIn         : BOOL := FALSE;
    s_bSettleQ          : BOOL := FALSE;
    s_dSettleEt         : DINT := 0;
    fb_tFull            : FB_TON;       // 步 1: 4 光电全亮 10 s
    s_bFullIn           : BOOL := FALSE;
    s_bFullQ            : BOOL := FALSE;
    s_dFullEt           : DINT := 0;
    fb_tEmpty           : FB_TON;       // 步 3: 光电全灭后等 X102 超时 (F107)
    s_bEmptyIn          : BOOL := FALSE;
    s_bEmptyQ           : BOOL := FALSE;
    s_dEmptyEt          : DINT := 0;
    fb_tF90             : FB_TON;       // F90 前光电异常
    s_bF90In            : BOOL := FALSE;
    s_bF90Q             : BOOL := FALSE;
    s_dF90Et            : DINT := 0;
    fb_tF91             : FB_TON;       // F91 后光电异常
    s_bF91In            : BOOL := FALSE;
    s_bF91Q             : BOOL := FALSE;
    s_dF91Et            : DINT := 0;

    (* 边沿 *)
    fb_trPickDone       : FB_R_TRIG;    // X102 上升沿
    s_bPickDoneEdge     : BOOL := FALSE;
    s_bPickDoneLatch    : BOOL := FALSE;    // 步 3 内锁存的 X102 上升沿

    (* 步与轴命令状态 *)
    s_iStep             : INT := 0;
    s_iPhase            : INT := 0;
    s_bX2Go             : BOOL := FALSE;    // X2 绝对定位进行中
    s_rX2Target         : REAL := 0.0;
    s_bAxisOwned        : BOOL := FALSE;

    (* 派生量 *)
    s_bHold             : BOOL := FALSE;
    s_bBlock            : BOOL := FALSE;    // 组框机安全异常: 禁止 X2 定位与转移
    s_bAnyBusy          : BOOL := FALSE;    // 三轴任一在驱动
    s_bEyesAll          : BOOL := FALSE;    // 4 光电全亮
    s_bEyesNone         : BOOL := FALSE;    // 4 光电全灭
    s_rErr              : REAL := 0.0;
    s_bAtPick           : BOOL := FALSE;    // X2 在 D512
    s_bAtFeed           : BOOL := FALSE;    // X2 在 D522
    s_bZStandby         : BOOL := FALSE;    // Z 在待机点 D500
END_VAR

VAR CONSTANT
    AX_Z                : INT := 1;
    AX_X2               : INT := 3;
    STEP_HOME           : INT := 0;     // 回取料点 D512
    STEP_WAIT_FULL      : INT := 1;     // 在 D512 生成 A / B 请求
    STEP_TO_FEED        : INT := 2;     // 去打胶机放料点 D522
    STEP_SEND           : INT := 3;     // Y44 抓料可, 等打胶机取走
    PH_WINDOW           : INT := 0;
    PH_MOVE             : INT := 1;
END_VAR

BEGIN
    (* ============ 1. 定时器统一调用 ============ *)
    fb_tSettle(IN := s_bSettleIn, PT := io_stFeed.dSettleMs, Q => s_bSettleQ, ET => s_dSettleEt);
    fb_tFull(IN := s_bFullIn, PT := io_stFeed.dFeedFullMs, Q => s_bFullQ, ET => s_dFullEt);
    fb_tEmpty(IN := s_bEmptyIn, PT := io_stFeed.dFeedEmptyMs, Q => s_bEmptyQ, ET => s_dEmptyEt);
    fb_tF90(IN := s_bF90In, PT := io_stFeed.dEyeAlarmMs, Q => s_bF90Q, ET => s_dF90Et);
    fb_tF91(IN := s_bF91In, PT := io_stFeed.dEyeAlarmMs, Q => s_bF91Q, ET => s_dF91Et);
    fb_trPickDone(IN := io_stIo.bGluePickDone, Q => s_bPickDoneEdge);

    (* ============ 2. 派生量 ============ *)
    s_bHold := io_stBridge.bHoldFeeder;
    // 组框机安全异常 (联机 ∧ 通讯正常 ∧ 对方安全异常): 禁止 X2 定位与转移 (R-EXT-03)
    s_bBlock := io_stExt.bLinkMode AND (NOT io_stExt.bLinkFail) AND io_stExt.bPeerSafetyFault;
    s_bAnyBusy := io_astAxis[1].stAbs.Busy OR io_astAxis[1].stJog.Busy OR io_astAxis[1].stHome.Busy
                  OR io_astAxis[2].stAbs.Busy OR io_astAxis[2].stJog.Busy OR io_astAxis[2].stHome.Busy
                  OR io_astAxis[AX_X2].stAbs.Busy OR io_astAxis[AX_X2].stJog.Busy OR io_astAxis[AX_X2].stHome.Busy;
    s_bEyesAll := io_stIo.bFeederFrontEye1 AND io_stIo.bFeederFrontEye2
                  AND io_stIo.bFeederRearEye1 AND io_stIo.bFeederRearEye2;
    s_bEyesNone := (NOT io_stIo.bFeederFrontEye1) AND (NOT io_stIo.bFeederFrontEye2)
                   AND (NOT io_stIo.bFeederRearEye1) AND (NOT io_stIo.bFeederRearEye2);
    s_rErr := io_astAxis[AX_X2].rCurrentPos - io_stFeed.rPosPick;
    IF s_rErr < 0.0 THEN
        s_rErr := 0.0 - s_rErr;
    END_IF;
    s_bAtPick := (s_rErr <= io_stFeed.rPosTol);
    s_rErr := io_astAxis[AX_X2].rCurrentPos - io_stFeed.rPosFeed;
    IF s_rErr < 0.0 THEN
        s_rErr := 0.0 - s_rErr;
    END_IF;
    s_bAtFeed := (s_rErr <= io_stFeed.rPosTol);
    s_rErr := io_astAxis[AX_Z].rCurrentPos - io_stBridge.rZStandby;
    IF s_rErr < 0.0 THEN
        s_rErr := 0.0 - s_rErr;
    END_IF;
    s_bZStandby := (s_rErr <= io_stFeed.rPosTol);

    (* 过程定时器 IN 每扫描先清零, 由所在步重新置位 *)
    s_bSettleIn := FALSE;
    s_bFullIn := FALSE;
    s_bEmptyIn := FALSE;
    io_stBridge.bFeedDoneClr := FALSE;
    io_stFeed.bReqA := FALSE;
    io_stFeed.bReqB := FALSE;

    (* ============ 3. 步序 ============ *)
    IF (NOT io_stMachine.bAuto) OR io_stMachine.bFault THEN
        // 非自动或异常停机: 步序回 0, 清 Y44 / Y47 与轴命令
        s_iStep := STEP_HOME;
        s_iPhase := PH_WINDOW;
        s_bX2Go := FALSE;
        s_bPickDoneLatch := FALSE;
        io_stFeed.bY44 := FALSE;
    ELSIF (NOT s_bHold) AND (NOT s_bBlock) THEN
        CASE s_iStep OF
            STEP_HOME:
                // 步 0: 入口窗口装目标 D512; 出发联锁满足后 X2 定位到 D512 (已在则直接完成)
                io_stFeed.bY44 := FALSE;
                IF s_iPhase = PH_WINDOW THEN
                    s_bSettleIn := (NOT io_stMachine.bStopPending);
                    IF s_bSettleQ THEN
                        s_bSettleIn := FALSE;
                        s_iPhase := PH_MOVE;
                    END_IF;
                ELSE
                    IF s_bX2Go THEN
                        IF io_astAxis[AX_X2].stAbs.Done THEN
                            s_bX2Go := FALSE;
                            s_iStep := STEP_WAIT_FULL;
                            s_iPhase := PH_WINDOW;
                        END_IF;
                    ELSIF s_bAtPick AND (NOT s_bAnyBusy) THEN
                        s_iStep := STEP_WAIT_FULL;
                        s_iPhase := PH_WINDOW;
                    ELSIF io_stBridge.bPPAtS20 AND s_bZStandby AND (NOT s_bAnyBusy)
                          AND (NOT io_stMachine.bStopPending) THEN
                        s_rX2Target := io_stFeed.rPosPick;
                        s_bX2Go := TRUE;
                    END_IF;
                END_IF;

            STEP_WAIT_FULL:
                // 步 1: 仅当 X2 在 D512 才生成 A / B 请求; 停止收尾期间不再生成
                IF s_bAtPick AND (NOT io_stMachine.bStopPending) THEN
                    io_stFeed.bReqA := s_bEyesNone AND (NOT io_stBridge.abFeedDone[1]);
                    io_stFeed.bReqB := io_stIo.bFeederFrontEye1 AND io_stIo.bFeederFrontEye2
                                       AND (NOT io_stIo.bFeederRearEye1) AND (NOT io_stIo.bFeederRearEye2)
                                       AND (NOT io_stBridge.abFeedDone[2]);
                END_IF;
                s_bFullIn := s_bEyesAll;
                IF (io_stBridge.abFeedDone[1] AND io_stBridge.abFeedDone[2] OR s_bFullQ)
                   AND s_bZStandby AND s_bEyesAll AND (NOT s_bAnyBusy) AND (NOT io_stMachine.bStopPending) THEN
                    s_bFullIn := FALSE;
                    s_iStep := STEP_TO_FEED;
                    s_iPhase := PH_WINDOW;
                END_IF;

            STEP_TO_FEED:
                // 步 2: 入口窗口装目标 D522 并清两个"X1 送料完成"; 出发条件只在出发时判一次
                IF s_iPhase = PH_WINDOW THEN
                    io_stBridge.bFeedDoneClr := TRUE;
                    s_bSettleIn := TRUE;
                    IF s_bSettleQ THEN
                        s_bSettleIn := FALSE;
                        s_iPhase := PH_MOVE;
                    END_IF;
                ELSE
                    IF s_bX2Go THEN
                        IF io_astAxis[AX_X2].stAbs.Done THEN
                            s_bX2Go := FALSE;
                            s_iStep := STEP_SEND;
                            s_iPhase := PH_WINDOW;
                            s_bPickDoneLatch := FALSE;
                        END_IF;
                    ELSIF s_bAtFeed THEN
                        // D512 = D522 或已在送料点: 直接走完 (原程序此处卡死, 新增处理)
                        s_iStep := STEP_SEND;
                        s_iPhase := PH_WINDOW;
                        s_bPickDoneLatch := FALSE;
                    ELSIF s_bEyesAll AND io_stIo.bGlueAllowFeed AND io_stBridge.bFeedPermit AND (NOT s_bAnyBusy) THEN
                        s_rX2Target := io_stFeed.rPosFeed;
                        s_bX2Go := TRUE;
                    END_IF;
                END_IF;

            STEP_SEND:
                // 步 3: X2 在 D522 且 4 光电全亮 -> Y44 = 1 (任一光电灭即 0); 等打胶机取走
                io_stFeed.bY44 := s_bAtFeed AND s_bEyesAll;
                IF s_bPickDoneEdge THEN
                    s_bPickDoneLatch := TRUE;
                END_IF;
                s_bEmptyIn := s_bEyesNone;
                IF s_bEyesNone AND s_bPickDoneLatch THEN
                    s_bEmptyIn := FALSE;
                    s_bPickDoneLatch := FALSE;
                    io_stFeed.bY44 := FALSE;
                    s_iStep := STEP_HOME;
                    s_iPhase := PH_WINDOW;
                END_IF;

        ELSE
            // 步序异常值: 回安全步 0
            s_iStep := STEP_HOME;
            s_iPhase := PH_WINDOW;
            s_bX2Go := FALSE;
        END_CASE;
    END_IF;

    (* ============ 4. 轴命令: 自动模式持有, Hold / 组框机异常时 Halt, 离开自动时撤销 ============ *)
    IF io_stMachine.bAuto AND (NOT io_stMachine.bFault) THEN
        s_bAxisOwned := TRUE;
        IF s_bX2Go AND (NOT s_bHold) AND (NOT s_bBlock) THEN
            io_astAxis[AX_X2].stAbs.Position := s_rX2Target;
            io_astAxis[AX_X2].stAbs.Velocity := io_stFeed.rAutoSpeed;
            io_astAxis[AX_X2].stAbs.Execute := TRUE;
            io_astAxis[AX_X2].stHalt.Execute := FALSE;
        ELSE
            io_astAxis[AX_X2].stAbs.Execute := FALSE;
            io_astAxis[AX_X2].stHalt.Execute := s_bX2Go;
        END_IF;
        io_astAxis[AX_X2].stStop.Execute := FALSE;
    ELSIF s_bAxisOwned THEN
        io_astAxis[AX_X2].stAbs.Execute := FALSE;
        io_astAxis[AX_X2].stStop.Execute := io_stMachine.bFault;
        io_astAxis[AX_X2].stHalt.Execute := io_astAxis[AX_X2].stAbs.Busy;
        s_bAxisOwned := io_stMachine.bFault OR io_astAxis[AX_X2].stAbs.Busy;
    END_IF;

    (* ============ 5. Y47 安全区信号: X2 在 D512 且不在驱动且自动 (与步号无关) ============ *)
    io_stFeed.bY47 := s_bAtPick AND (NOT io_astAxis[AX_X2].stAbs.Busy) AND io_stMachine.bAuto
                      AND (NOT io_stMachine.bFault);
    io_stIo.bQGluePickAllowed := io_stFeed.bY44;
    io_stIo.bQGlueSafeZone := io_stFeed.bY47;

    (* ============ 6. 报警触发 ============ *)
    // F90 / F91: 光电异常 (该侧 X1 送料完成后光电却未全亮), 1 s
    s_bF90In := ((NOT io_stIo.bFeederFrontEye1) OR (NOT io_stIo.bFeederFrontEye2)) AND io_stBridge.abFeedDone[1];
    s_bF91In := ((NOT io_stIo.bFeederRearEye1) OR (NOT io_stIo.bFeederRearEye2)) AND io_stBridge.abFeedDone[2];
    io_stFeed.arrTrig[0] := s_bF90Q;
    io_stFeed.arrTrig[1] := s_bF91Q;
    io_stFeed.arrTrig[2] := s_bEmptyQ;      // F107 等 X102 超时 (提示类, 仍停在步 3)

    (* ============ 7. 状态输出 ============ *)
    io_stFeed.iStep := s_iStep;
    io_stFeed.bAtRest := (s_iStep = STEP_HOME) OR (s_iStep = STEP_WAIT_FULL);

END_FUNCTION_BLOCK
