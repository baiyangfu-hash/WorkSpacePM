    ASSERT GlobalVars.stHmi.rManualSpeed[1] = 5000.0;
    SET GlobalVars.stHmi.bSpeedUp[1] := FALSE;
    SET GlobalVars.stHmi.rManualSpeed[1] := 500.0;
    SET GlobalVars.stHmi.bSpeedDown[1] := TRUE;
    WAIT_CYCLES 6;
    ASSERT GlobalVars.stHmi.rManualSpeed[1] = 500.0;
