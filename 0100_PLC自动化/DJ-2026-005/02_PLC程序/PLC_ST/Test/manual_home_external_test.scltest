TEST_CASE "T_HOME_01_03_Sequence"
    // 测试目标: 回原点: 预处理(松夹爪 / 升降缸下)后 Z 回原点; Z 完成后 X1 X2 同时回; 都完成回原点结束

    // RESET: 急停恢复 -> 复位键清锁存 -> 进手动取消自动启动的回原点 -> 退出手动, 回到待机
    SET GlobalVars.stIo.bEStop := FALSE;
    WAIT_CYCLES 3;
    SET GlobalVars.stIo.bEStop := TRUE;
    SET GlobalVars.stIo.bDoorL1 := TRUE;
    SET GlobalVars.stIo.bDoorL2 := TRUE;
    SET GlobalVars.stIo.bDoorL3 := TRUE;
    SET GlobalVars.stIo.bDoorL4 := TRUE;
    SET GlobalVars.stIo.bDoorR1 := TRUE;
    SET GlobalVars.stIo.bDoorR2 := TRUE;
    SET GlobalVars.stIo.bDoorR3 := TRUE;
    SET GlobalVars.stIo.bDoorR4 := TRUE;
    SET GlobalVars.stIo.bX1ServoAlarm := TRUE;
    SET GlobalVars.stIo.bX2ServoAlarm := TRUE;
    SET GlobalVars.stIo.bZServoAlarm := TRUE;
    SET GlobalVars.stIo.bVfd1Alarm := TRUE;
