// manual_home_external_test.scltest - 手动、回原点、组框机链路、站间中继
// DJ-2026-005 新设计 (V15.0.0, 2026-10-24); 用例编号对应 00_程序方案/025_测试用例设计_TST.md
// 状态: 已写、未在本机运行 (云端没有 Siemens 语言服务插件); 由用户本机 plc test 跑通后才算通过
// 约定: 定时器用例不测内部计时, 只测接线与条件 (用户 10-23 确认); 每个用例开头 RESET 防状态污染
// 覆盖: T-MAN-01/03/04/05/06/07/08/11, T-HOME-01/02/03/04, T-EXT-01/02/04/05/06, T-FEED-10/14, 中继 Hold
// ============================================================================

TEST_CASE "T_MAN_01_Jog"
    // 测试目标: 手动按住 X1 / Z 点动方向键, 松开撤销

    // RESET: 急停恢复 -> 复位键清锁存 -> 进手动取消自动启动的回原点 -> 退出手动, 回到待机
    SET GlobalVars.stIo.bEStop := FALSE;
    WAIT_CYCLES 3;
    SET GlobalVars.stIo.bEStop := TRUE;
    SET GlobalVars.stIo.bDoorL1 := TRUE;
    SET GlobalVars.stIo.bDoorL2 := TRUE;
