    SET GlobalVars.stExt.bPeerPermit := FALSE;
    SET GlobalVars.stExt.bLinkFail := FALSE;
    SET GlobalVars.stMachine.bSimulate := FALSE;
    SET GlobalVars.astAxis[1].rCurrentPos := 0.0;
    SET GlobalVars.astAxis[1].stHome.Done := FALSE;
    SET GlobalVars.astAxis[1].stAbs.Done := FALSE;
    SET GlobalVars.astAxis[2].rCurrentPos := 0.0;
    SET GlobalVars.astAxis[2].stHome.Done := FALSE;
    SET GlobalVars.astAxis[2].stAbs.Done := FALSE;
    SET GlobalVars.astAxis[3].rCurrentPos := 0.0;
    SET GlobalVars.astAxis[3].stHome.Done := FALSE;
    SET GlobalVars.astAxis[3].stAbs.Done := FALSE;
    SET GlobalVars.stIo.bResetButton := TRUE;
    WAIT_CYCLES 3;
    SET GlobalVars.stIo.bResetButton := FALSE;
    SET GlobalVars.stHmi.bManual := TRUE;
    WAIT_CYCLES 3;
    SET GlobalVars.stHmi.bManual := FALSE;
    WAIT_CYCLES 3;

    SET GlobalVars.stHmi.bManual := TRUE;
    SET GlobalVars.stHmi.bJog[1] := TRUE;
    SET GlobalVars.stHmi.bJog[6] := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.astAxis[2].stJog.Forward = TRUE;
    ASSERT GlobalVars.astAxis[1].stJog.Backward = TRUE;
    ASSERT GlobalVars.astAxis[2].stJog.Backward = FALSE;
    SET GlobalVars.stHmi.bJog[1] := FALSE;
    SET GlobalVars.stHmi.bJog[6] := FALSE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.astAxis[2].stJog.Forward = FALSE;
    ASSERT GlobalVars.astAxis[1].stJog.Backward = FALSE;
END_TEST_CASE

