    SET GlobalVars.astAxis[3].stHome.Done := FALSE;
    SET GlobalVars.astAxis[3].stAbs.Done := FALSE;
    SET GlobalVars.stIo.bResetButton := TRUE;
    WAIT_CYCLES 3;
    SET GlobalVars.stIo.bResetButton := FALSE;
    SET GlobalVars.stHmi.bManual := TRUE;
    WAIT_CYCLES 3;
    SET GlobalVars.stHmi.bManual := FALSE;
    WAIT_CYCLES 3;

    SET GlobalVars.stMachine.bAuto := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stAlarm.bLampGreen = TRUE;
    ASSERT GlobalVars.stIo.bQLampGreen = TRUE;
    SET GlobalVars.stIo.bEStop := FALSE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stAlarm.bLampYellow = FALSE;
END_TEST_CASE

