    SET GlobalVars.stIo.bConv1SepDown1 := TRUE;
    SET GlobalVars.stIo.bConv1SepDown2 := TRUE;
    WAIT_CYCLES 2;
    ASSERT GlobalVars.stConv.astLayer[1].bPreBlock = TRUE;
    ASSERT GlobalVars.stConv.astLayer[1].bPick1 = TRUE;
    ASSERT GlobalVars.stConv.astLayer[1].bPick2 = TRUE;
    ASSERT GlobalVars.stConv.astLayer[1].bFull1 = TRUE;
    ASSERT GlobalVars.stConv.astLayer[1].bFull2 = TRUE;
    ASSERT GlobalVars.stConv.astLayer[1].bBlkUp1 = FALSE;
    ASSERT GlobalVars.stConv.astLayer[1].bBlkUp2 = FALSE;
    ASSERT GlobalVars.stConv.astLayer[1].bBlkDn1 = TRUE;
    ASSERT GlobalVars.stConv.astLayer[1].bBlkDn2 = TRUE;
    ASSERT GlobalVars.stConv.astLayer[1].bSepUp1 = FALSE;
    ASSERT GlobalVars.stConv.astLayer[1].bSepUp2 = FALSE;
    ASSERT GlobalVars.stConv.astLayer[1].bSepDn1 = TRUE;
    ASSERT GlobalVars.stConv.astLayer[1].bSepDn2 = TRUE;
END_TEST_CASE

