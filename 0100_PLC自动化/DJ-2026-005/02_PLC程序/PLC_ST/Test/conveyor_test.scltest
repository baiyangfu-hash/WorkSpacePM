TEST_CASE "T_PP_23_SwitchBlockedWithProduct"
    // 测试目标: ★ 夹爪里有料或小车上有料时不接受模式切换, 料取走后才切 (R-PP-13)

    // RESET: 急停恢复 -> 复位键清锁存 -> 进手动取消自动启动的回原点 -> 退出手动, 回到待机
    SET GlobalVars.stIo.bEStop := FALSE;
    WAIT_CYCLES 3;
    SET GlobalVars.stIo.bEStop := TRUE;
    SET GlobalVars.stIo.bDoorL1 := TRUE;
    SET GlobalVars.stIo.bDoorL2 := TRUE;
    SET GlobalVars.stIo.bDoorL3 := TRUE;
    SET GlobalVars.stIo.bDoorL4 := TRUE;
    SET GlobalVars.stIo.bDoorR1 := TRUE;
