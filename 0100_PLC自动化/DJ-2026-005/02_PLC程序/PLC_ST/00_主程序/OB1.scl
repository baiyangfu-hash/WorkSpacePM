// ============================================================================
// OB1.scl - 边框缓存机主组织块 (V15.0.0, 2026-10-24 新设计)
// ============================================================================
// 只做调用, 不含逻辑 (REQ R-NFR-05); 调用顺序见详细设计说明书 DSN 3.2。
// 站间信号经 FB_2002 中继, 一拍延迟; 报警最后汇总, 本扫描的 Hold / M8 下一扫描生效。
// ============================================================================
ORGANIZATION_BLOCK OB1

BEGIN
    GlobalVars.fbMode(io_stMachine := GlobalVars.stMachine, io_stHmi := GlobalVars.stHmi, io_stIo := GlobalVars.stIo, io_stAlarm := GlobalVars.stAlarm, io_stHome := GlobalVars.stHome);
    GlobalVars.fbHome(io_stHome := GlobalVars.stHome, io_stMachine := GlobalVars.stMachine, io_stIo := GlobalVars.stIo, io_stAlarm := GlobalVars.stAlarm, io_astAxis := GlobalVars.astAxis, io_stBridge := GlobalVars.stBridge, io_stPP := GlobalVars.stPP, io_stFeed := GlobalVars.stFeed, io_stConv := GlobalVars.stConv);
    GlobalVars.fbManual(io_stManual := GlobalVars.stManual, io_stMachine := GlobalVars.stMachine, io_stHmi := GlobalVars.stHmi, io_stIo := GlobalVars.stIo, io_stPP := GlobalVars.stPP, io_stFeed := GlobalVars.stFeed, io_stExt := GlobalVars.stExt, io_stBridge := GlobalVars.stBridge, io_astAxis := GlobalVars.astAxis);
    GlobalVars.fbExternal(io_stExt := GlobalVars.stExt, io_stMachine := GlobalVars.stMachine, io_stHmi := GlobalVars.stHmi, io_stIo := GlobalVars.stIo, io_stFeed := GlobalVars.stFeed, io_stAlarm := GlobalVars.stAlarm);
    GlobalVars.fbBridge(io_stBridge := GlobalVars.stBridge, io_stConv := GlobalVars.stConv, io_stPP := GlobalVars.stPP, io_stFeed := GlobalVars.stFeed, io_stHome := GlobalVars.stHome, io_stManual := GlobalVars.stManual, io_stExt := GlobalVars.stExt, io_stMachine := GlobalVars.stMachine, io_stAlarm := GlobalVars.stAlarm);
    GlobalVars.fbConv(io_stConv := GlobalVars.stConv, io_stBridge := GlobalVars.stBridge, io_stMachine := GlobalVars.stMachine, io_stIo := GlobalVars.stIo, io_stAlarm := GlobalVars.stAlarm, io_stHmi := GlobalVars.stHmi, io_stManual := GlobalVars.stManual);
    GlobalVars.fbPickPlace(io_stPP := GlobalVars.stPP, io_stBridge := GlobalVars.stBridge, io_stMachine := GlobalVars.stMachine, io_stIo := GlobalVars.stIo, io_stAlarm := GlobalVars.stAlarm, io_astAxis := GlobalVars.astAxis);
    GlobalVars.fbFeeder(io_stFeed := GlobalVars.stFeed, io_stBridge := GlobalVars.stBridge, io_stExt := GlobalVars.stExt, io_stMachine := GlobalVars.stMachine, io_stIo := GlobalVars.stIo, io_stAlarm := GlobalVars.stAlarm, io_astAxis := GlobalVars.astAxis);
    GlobalVars.fbAlarm(io_stAlarm := GlobalVars.stAlarm, io_stMachine := GlobalVars.stMachine, io_stIo := GlobalVars.stIo, io_stHmi := GlobalVars.stHmi);
END_ORGANIZATION_BLOCK
