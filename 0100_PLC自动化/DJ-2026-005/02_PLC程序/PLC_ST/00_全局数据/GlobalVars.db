// ============================================================================
// GlobalVars.scl - 边框缓存机全局变量数据块 (V15.1.0, 2026-11-15 TIA 实测整改)
// ============================================================================
// 功能说明:
//   DJ-2026-005 边框缓存机的全部全局数据 (不含功能块实例)。
//   V15.1.0: TIA 全局 DB 里不能放 FB 实例 (LSP-905 §4.11), 9 个功能块实例
//            改为各自的背景 DB (DB_<FB编号>_..._DJ005), 由 OB1 按原顺序调用;
//            文件改为 .scl, UTF-8 带 BOM (LSP-905 §4.10)。
//   各机构数据以结构体整块经 VAR_IN_OUT 传给功能块 (接口文档_INT.md 4.1 / 5)。
//   点位、时间参数在各结构体的参数段, HMI 可写, 掉电保持由平台侧设置 (TEC 7)。
//   stIo: 输入在 OB1 之前由平台硬件映射写入, 输出在 OB1 之后由平台读出
//         (平台适配另立任务, 见技术方案 6)。
// ============================================================================

DATA_BLOCK GlobalVars_DJ005
{ S7_Optimized_Block := 'TRUE' }
VERSION : 1.0

VAR
    // =========================================================================
    // 第一部分: 全局数据
    // =========================================================================
    stMachine   : ST_Machine;           // 模式、暂停、停止、状态字 (FB_1001 写)
    stHmi       : ST_Hmi;               // HMI 命令与设定值
    stIo        : ST_Io;                // 全部物理输入 / 输出映射
    stAlarm     : ST_Alarm;             // 报警触发、锁存、分级输出、声光
    stBridge    : ST_Bridge;            // 站间中继信号 (FB_2002 写)

    // =========================================================================
    // 第二部分: 各机构数据
    // =========================================================================
    stHome      : ST_HomePrepare;       // 回原点 / 准备序列
    stManual    : ST_Manual;            // 手动 / 示教
    stConv      : ST_ConveyorSystem;    // 4 层输送 (含 astLayer[1..4])
    stPP        : ST_PickPlace;         // 取放料
    stFeed      : ST_Feeder;            // X2 送料小车
    stExt       : ST_ExternalLink;      // 组框机链路 / 打胶机握手

    // =========================================================================
    // 第三部分: 伺服轴数组 (ST_ServoAxis V3.0, PLCopen MC Part 1)
    // 轴索引: [1] = Z (升降), [2] = X1 (取放料横移), [3] = X2 (打胶机送料)
    // =========================================================================
    astAxis     : ARRAY[1..3] OF ST_ServoAxis;      // 伺服轴: [1] Z, [2] X1, [3] X2
END_VAR

BEGIN
END_DATA_BLOCK
