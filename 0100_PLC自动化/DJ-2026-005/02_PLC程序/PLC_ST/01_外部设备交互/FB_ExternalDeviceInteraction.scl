(* ================================================================= *)
(*  功能块名称: FB_ExternalDeviceInteraction (FB_3001)                *)
(*  功能描述:   组框机链路: 联机 / 连续送框 / 单套送框许可,           *)
(*              本机 -> 组框机安全异常与暂停 / 急停输出 Y45 / Y46,    *)
(*              组框机安全异常 F104 (A 类)、通讯异常 F105 (提示)      *)
(*  版本号:     V15.0.0 (2026-10-24, 新设计, 取代 V1.x STD-820 全套)  *)
(*                                                                   *)
(*  依据: 详细设计说明书_DSN.md 8; 接口文档_INT.md 4.8 / 7.3;        *)
(*        需求 R-EXT-01~05                                           *)
(*  遵循规范: LSP-905                                                *)
(*                                                                   *)
(*  组框机的 R5010.0 / R5011.0 与通讯状态由平台适配写入 stExt        *)
(*  (bPeerSafetyFault / bPeerPermit / bLinkFail), 本 FB 只读。       *)
(*                                                                   *)
(*  与 DSN 的差异 (评审请确认):                                      *)
(*    1. X160 / X161 (组框机开门暂停 / 急停信号) 未并入"组框机安全    *)
(*       异常": 极性与含义图纸与原程序都没写清 (R-EXT-04, 待现场确认) *)
(*    2. Y45 与 Y46 目前同一条件 (DSN 8); 若现场需区分暂停与急停,    *)
(*       另行拆开                                                    *)
(* ================================================================= *)

FUNCTION_BLOCK FB_ExternalDeviceInteraction

VAR_IN_OUT
    io_stExt            : ST_ExternalLink;      // 组框机链路 (本 FB 写)
    io_stMachine        : ST_Machine;           // 模式 (保留, 本 FB 暂不读)
    io_stHmi            : ST_Hmi;               // 联机 M501 / 连续 M502 (读), 单套回读 M510 (写)
    io_stIo             : ST_Io;                // Y45 / Y46 输出
    io_stFeed           : ST_Feeder;            // 小车 Y44 (读, 消耗单套许可)
    io_stAlarm          : ST_Alarm;             // 报警 (读 F0~F8 锁存, 写 F104 / F105 触发)
END_VAR

VAR
    fb_trPermitUp       : FB_R_TRIG;            // 组框机允许送料 上升沿
    fb_tfPermitDn       : FB_F_TRIG;            // 组框机允许送料 下降沿
    s_bPermitUp         : BOOL := FALSE;
    s_bPermitDn         : BOOL := FALSE;
    s_iI                : INT := 0;
    s_bLocalSafety      : BOOL := FALSE;        // 本机 F0 或 F1~F8 锁存
    s_bPeerFault        : BOOL := FALSE;        // 组框机安全异常 (联机且通讯正常)
END_VAR

VAR CONSTANT
    IDX_F0              : INT := 0;
    IDX_F8              : INT := 8;
    IDX_F104            : INT := 104;
    IDX_F105            : INT := 105;
END_VAR

BEGIN
    (* ============ 1. 联机 / 连续送框: 取自 HMI ============ *)
    io_stExt.bLinkMode := io_stHmi.bLinkMode;
    io_stExt.bContinuous := io_stHmi.bContinuousSend;

    (* ============ 2. 边沿 ============ *)
    fb_trPermitUp(IN := io_stExt.bLinkMode AND io_stExt.bPeerPermit, Q => s_bPermitUp);
    fb_tfPermitDn(IN := io_stExt.bLinkMode AND io_stExt.bPeerPermit, Q => s_bPermitDn);

    (* ============ 3. 单套送框许可 M510 ============ *)
    // 联机且允许送料上升沿置位; 下降沿、小车 Y44 成立、不联机时复位 (复位优先)
    IF s_bPermitUp THEN
        io_stExt.bSingle := TRUE;
    END_IF;
    IF s_bPermitDn OR io_stFeed.bY44 OR (NOT io_stExt.bLinkMode) THEN
        io_stExt.bSingle := FALSE;
    END_IF;
    io_stHmi.bSingleSend := io_stExt.bSingle;

    (* ============ 4. 本机安全异常 -> 组框机 (R5000.0 / Y45 / Y46) ============ *)
    s_bLocalSafety := FALSE;
    FOR s_iI := IDX_F0 TO IDX_F8 DO
        IF io_stAlarm.arrLatch[s_iI] THEN
            s_bLocalSafety := TRUE;
        END_IF;
    END_FOR;
    io_stExt.bLinkSafetyOut := s_bLocalSafety;

    (* ============ 5. 组框机安全异常 / 通讯异常 ============ *)
    s_bPeerFault := io_stExt.bLinkMode AND (NOT io_stExt.bLinkFail) AND io_stExt.bPeerSafetyFault;
    io_stExt.arrTrig[0] := s_bPeerFault;                                    // F104 (A 类)
    io_stExt.arrTrig[1] := io_stExt.bLinkMode AND io_stExt.bLinkFail;       // F105 (提示)
    io_stAlarm.arrTrig[IDX_F104] := io_stExt.arrTrig[0];
    io_stAlarm.arrTrig[IDX_F105] := io_stExt.arrTrig[1];

    (* ============ 6. 输出 Y45 / Y46: 组框机安全异常 或 本机安全异常 ============ *)
    io_stExt.bY45 := s_bPeerFault OR s_bLocalSafety;
    io_stExt.bY46 := s_bPeerFault OR s_bLocalSafety;
    io_stIo.bQFramePause := io_stExt.bY45;
    io_stIo.bQFrameEStop := io_stExt.bY46;
END_FUNCTION_BLOCK
