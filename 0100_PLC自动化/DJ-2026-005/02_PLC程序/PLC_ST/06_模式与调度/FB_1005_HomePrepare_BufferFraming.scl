(* ================================================================= *)
(*  功能块名称: FB_1005_HomePrepare_BufferFraming                     *)
(*  功能描述:   回原点序列 (预处理 -> Z -> X1/X2) 与准备序列          *)
(*              (夹爪/升降缸 -> Z 待机点 -> X1 取料点 -> X2 取料点 -> *)
(*              等输送), 轴使能与错误复位, F80 / F81                  *)
(*  版本号:     V15.0.0 (2026-10-24, 新设计)                          *)
(*                                                                   *)
(*  依据: 详细设计说明书_DSN.md 4.2; 接口文档_INT.md 4.10 / 5 / 8;   *)
(*        原程序工艺说明 PRC 4                                       *)
(*  遵循规范: LSP-905; 定时器用 SysLib FB_TON (毫秒)                 *)
(*                                                                   *)
(*  轴: Z = io_astAxis[1], X1 = io_astAxis[2], X2 = io_astAxis[3]。  *)
(*                                                                   *)
(*  与 INT / DSN 的差异 (评审请确认):                                *)
(*    1. 增加 VAR_IN_OUT io_stPP / io_stFeed / io_stConv             *)
(*       (读待机点、取料点、自动速度; 读 4 层准备完成)                *)
(*    2. 回原点速度 rHomeSpeed 不在本程序: SysLib ST_SvHome 没有速度  *)
(*       字段, 回原点速度由轴 / 驱动器参数决定 (现场确认, R-HOME-06)  *)
(*    3. 本 FB 兼管三个轴的使能 (stPower.Enable) 和错误复位          *)
(*       (stReset.Execute = 复位键脉冲); 平台适配如已做请去掉          *)
(*    4. 准备步 20: 待机点 D500 <= 0 时写回默认 100 (DSN 4.2)         *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1005_HomePrepare_BufferFraming

VAR_IN_OUT
    io_stHome           : ST_HomePrepare;       // 回原点 / 准备状态 (本 FB 写)
    io_stMachine        : ST_Machine;           // 模式 (读)
    io_stIo             : ST_Io;                // 物理输入 (读)
    io_stAlarm          : ST_Alarm;             // 报警 (写 F80 / F81 触发, 读复位)
    io_astAxis          : ARRAY[1..3] OF ST_ServoAxis;  // 轴: 1 = Z, 2 = X1, 3 = X2
    io_stBridge         : ST_Bridge;            // 站间中继 (读 Hold)
    io_stPP             : ST_PickPlace;         // 取放料 (读点位 / 速度)
    io_stFeed           : ST_Feeder;            // 小车 (读点位)
    io_stConv           : ST_ConveyorSystem;    // 输送 (读 4 层准备完成)
END_VAR

VAR
    fb_tPrepZ           : FB_TON;       // 准备: Z 动作前延时
    s_bPrepZIn          : BOOL := FALSE;
    s_bPrepZQ           : BOOL := FALSE;
    s_dPrepZEt          : DINT := 0;
    fb_tPrepX1          : FB_TON;       // 准备: X1 动作前延时
    s_bPrepX1In         : BOOL := FALSE;
    s_bPrepX1Q          : BOOL := FALSE;
    s_dPrepX1Et         : DINT := 0;
    fb_tPrepX2          : FB_TON;       // 准备: X2 动作前延时
    s_bPrepX2In         : BOOL := FALSE;
    s_bPrepX2Q          : BOOL := FALSE;
    s_dPrepX2Et         : DINT := 0;

    s_bHold             : BOOL := FALSE;    // 回原点 / 准备 Hold (非提示类报警或暂停)
    s_bAnyProd          : BOOL := FALSE;    // 夹爪里有料 X60~X63
    s_bAnyEye           : BOOL := FALSE;    // 小车上有料 X72~X75
    s_bOpenAll          : BOOL := FALSE;    // 夹爪 4 个松开位全到
    s_bFrontOpen        : BOOL := FALSE;    // 前夹爪 2 个松开位到
    s_bGripReady        : BOOL := FALSE;    // 4 松开位 + 升降缸下位 (或本机模拟)
    s_bF80              : BOOL := FALSE;
    s_bF81              : BOOL := FALSE;
    s_bActive           : BOOL := FALSE;    // 回原点或准备进行中

    s_bHomeZ            : BOOL := FALSE;    // Z 回原点命令
    s_bHomeX1           : BOOL := FALSE;
    s_bHomeX2           : BOOL := FALSE;
    s_bZGo              : BOOL := FALSE;    // Z 定位命令
    s_bX1Go             : BOOL := FALSE;
    s_bX2Go             : BOOL := FALSE;
    s_rZTarget          : REAL := 0.0;
    s_rX1Target         : REAL := 0.0;
    s_rX2Target         : REAL := 0.0;
    s_bAxisOwned        : BOOL := FALSE;    // 本 FB 持有过轴命令, 离开时需撤销
    s_iAx               : INT := 0;
END_VAR

VAR CONSTANT
    AX_Z                : INT := 1;
    AX_X1               : INT := 2;
    AX_X2               : INT := 3;
    HM_IDLE             : INT := 0;
    HM_PRE              : INT := 10;
    HM_Z                : INT := 20;
    HM_XX               : INT := 30;
    HM_DONE             : INT := 40;
    PR_IDLE             : INT := 0;
    PR_GRIP             : INT := 10;
    PR_Z                : INT := 20;
    PR_X1               : INT := 30;
    PR_X2               : INT := 40;
    PR_WAIT_CONV        : INT := 50;
    PR_DONE             : INT := 60;
    DEFAULT_Z_STANDBY   : REAL := 100.0;    // 待机点缺省 (DSN 4.2)
END_VAR

BEGIN
    (* ============ 1. 定时器统一调用 (顶部, 无条件) ============ *)
    fb_tPrepZ(IN := s_bPrepZIn, PT := io_stHome.dPrepZDelayMs, Q => s_bPrepZQ, ET => s_dPrepZEt);
    fb_tPrepX1(IN := s_bPrepX1In, PT := io_stHome.dPrepX1DelayMs, Q => s_bPrepX1Q, ET => s_dPrepX1Et);
    fb_tPrepX2(IN := s_bPrepX2In, PT := io_stHome.dPrepX2DelayMs, Q => s_bPrepX2Q, ET => s_dPrepX2Et);

    (* ============ 2. 派生量 ============ *)
    s_bHold := io_stBridge.bHoldHome OR io_stAlarm.bAny;
    s_bAnyProd := io_stIo.bPPFrontProd1 OR io_stIo.bPPFrontProd2 OR io_stIo.bPPRearProd1 OR io_stIo.bPPRearProd2;
    s_bAnyEye := io_stIo.bFeederFrontEye1 OR io_stIo.bFeederFrontEye2 OR io_stIo.bFeederRearEye1 OR io_stIo.bFeederRearEye2;
    s_bFrontOpen := io_stIo.bPPFrontOpen1 AND io_stIo.bPPFrontOpen2;
    s_bOpenAll := s_bFrontOpen AND io_stIo.bPPRearOpen1 AND io_stIo.bPPRearOpen2;
    s_bGripReady := (s_bOpenAll AND io_stIo.bPPLiftDown) OR io_stMachine.bSimulate;
    s_bActive := io_stMachine.bHoming OR io_stMachine.bPrepare;

    s_bPrepZIn := FALSE;
    s_bPrepX1In := FALSE;
    s_bPrepX2In := FALSE;

    (* ============ 3. F80 / F81: 回原点时夹爪 / 小车有料 (不进 M8, 回原点 Hold) ============ *)
    s_bF80 := io_stMachine.bHoming AND s_bAnyProd;
    s_bF81 := io_stMachine.bHoming AND s_bAnyEye;
    io_stAlarm.arrTrig[80] := s_bF80;
    io_stAlarm.arrTrig[81] := s_bF81;
    io_stHome.bReleaseGripperLock := s_bF80;        // F80 期间禁止 Z 定位 (取放料读)

    (* ============ 4. 序列 ============ *)
    io_stHome.bGripOpenCmd := FALSE;
    io_stHome.bLiftDownCmd := FALSE;
    io_stHome.bPrepareDone := FALSE;
    io_stHome.bInitReqConv := io_stMachine.bHoming OR io_stMachine.bPrepare;
    s_bHomeZ := FALSE;
    s_bHomeX1 := FALSE;
    s_bHomeX2 := FALSE;
    s_bZGo := FALSE;
    s_bX1Go := FALSE;
    s_bX2Go := FALSE;

    (* ---- 4.1 回原点 ---- *)
    IF io_stMachine.bFault OR (NOT io_stMachine.bHoming) THEN
        io_stHome.iHomeStep := HM_IDLE;
    ELSE
        CASE io_stHome.iHomeStep OF
            HM_IDLE:
                io_stHome.bPreprocessDone := FALSE;
                io_stHome.bHomeDoneZ := FALSE;
                io_stHome.bHomeDoneX1 := FALSE;
                io_stHome.bHomeDoneX2 := FALSE;
                io_stHome.iHomeStep := HM_PRE;

            HM_PRE:
                // 预处理: 夹爪有料 -> F80, 不松夹爪, 等人工; 否则松夹爪, 前松开位到后升降缸下降
                IF NOT s_bF80 THEN
                    io_stHome.bGripOpenCmd := TRUE;
                    io_stHome.bLiftDownCmd := s_bFrontOpen;
                END_IF;
                IF (NOT s_bF80) AND (NOT s_bHold) AND s_bGripReady THEN
                    io_stHome.bPreprocessDone := TRUE;
                    io_stHome.iHomeStep := HM_Z;
                END_IF;

            HM_Z:
                // Z 回原点: 要求 4 松开位 + 升降缸下位; 有报警撤销命令, 清除后从头再回
                IF (NOT s_bF80) AND (NOT s_bHold) AND s_bGripReady THEN
                    s_bHomeZ := TRUE;
                    IF io_astAxis[AX_Z].stHome.Done THEN
                        io_stHome.bHomeDoneZ := TRUE;
                        s_bHomeZ := FALSE;
                        io_stHome.iHomeStep := HM_XX;
                    END_IF;
                END_IF;

            HM_XX:
                // X1、X2 同时回; X2 另要求小车无料 (F81)
                IF NOT s_bHold THEN
                    IF NOT io_stHome.bHomeDoneX1 THEN
                        s_bHomeX1 := TRUE;
                        IF io_astAxis[AX_X1].stHome.Done THEN
                            io_stHome.bHomeDoneX1 := TRUE;
                            s_bHomeX1 := FALSE;
                        END_IF;
                    END_IF;
                    IF (NOT io_stHome.bHomeDoneX2) AND (NOT s_bF81) THEN
                        s_bHomeX2 := TRUE;
                        IF io_astAxis[AX_X2].stHome.Done THEN
                            io_stHome.bHomeDoneX2 := TRUE;
                            s_bHomeX2 := FALSE;
                        END_IF;
                    END_IF;
                END_IF;
                IF io_stHome.bHomeDoneX1 AND io_stHome.bHomeDoneX2 THEN
                    io_stHome.iHomeStep := HM_DONE;
                END_IF;

            HM_DONE:
                // 保持到 FB_1001 看到并退出回原点模式 (退出后上面的分支回 HM_IDLE)
                s_bHomeZ := FALSE;

        ELSE
            io_stHome.iHomeStep := HM_IDLE;
        END_CASE;
    END_IF;

    (* ---- 4.2 准备 ---- *)
    IF io_stMachine.bFault OR (NOT io_stMachine.bPrepare) THEN
        io_stHome.iPrepStep := PR_IDLE;
        io_stHome.bAxisInitDone := FALSE;
    ELSE
        CASE io_stHome.iPrepStep OF
            PR_IDLE:
                io_stHome.bAxisInitDone := FALSE;
                io_stHome.iPrepStep := PR_GRIP;

            PR_GRIP:
                // 松开夹爪, 升降缸下降 (无条件, 沿用)
                io_stHome.bGripOpenCmd := TRUE;
                io_stHome.bLiftDownCmd := TRUE;
                io_stHome.iPrepStep := PR_Z;

            PR_Z:
                // 夹爪松开 + 升降缸下位持续 dPrepZDelayMs 后, Z 定位到待机点
                io_stHome.bGripOpenCmd := TRUE;
                io_stHome.bLiftDownCmd := TRUE;
                IF io_stPP.rZStandby <= 0.0 THEN
                    io_stPP.rZStandby := DEFAULT_Z_STANDBY;
                END_IF;
                s_bPrepZIn := s_bGripReady AND (NOT s_bHold);
                IF s_bPrepZQ THEN
                    s_bZGo := TRUE;
                    s_rZTarget := io_stPP.rZStandby;
                    IF io_astAxis[AX_Z].stAbs.Done THEN
                        s_bZGo := FALSE;
                        io_stHome.iPrepStep := PR_X1;
                    END_IF;
                END_IF;

            PR_X1:
                // Z 到位后延时, X1 定位到 D510 (前位对取料点)
                s_bPrepX1In := NOT s_bHold;
                IF s_bPrepX1Q THEN
                    s_bX1Go := TRUE;
                    s_rX1Target := io_stPP.astPair[1].rXPick;
                    IF io_astAxis[AX_X1].stAbs.Done THEN
                        s_bX1Go := FALSE;
                        io_stHome.iPrepStep := PR_X2;
                    END_IF;
                END_IF;

            PR_X2:
                // X1、Z 都到位后延时, X2 定位到 D512
                s_bPrepX2In := NOT s_bHold;
                IF s_bPrepX2Q THEN
                    s_bX2Go := TRUE;
                    s_rX2Target := io_stFeed.rPosPick;
                    IF io_astAxis[AX_X2].stAbs.Done THEN
                        s_bX2Go := FALSE;
                        io_stHome.iPrepStep := PR_WAIT_CONV;
                    END_IF;
                END_IF;

            PR_WAIT_CONV:
                // 三轴到位完成; 等 4 层输送"准备完成"
                io_stHome.bAxisInitDone := TRUE;
                IF io_stConv.bAllReady THEN
                    io_stHome.iPrepStep := PR_DONE;
                END_IF;

            PR_DONE:
                // 完成一拍: FB_1001 看到后退出准备模式并进自动
                io_stHome.bPrepareDone := TRUE;

        ELSE
            io_stHome.iPrepStep := PR_IDLE;
        END_CASE;
    END_IF;

    (* ============ 5. 轴命令: 回原点 / 准备期间持有, 离开时撤销 ============ *)
    FOR s_iAx := AX_Z TO AX_X2 DO
        io_astAxis[s_iAx].stPower.Enable := NOT io_stMachine.bFault;
        io_astAxis[s_iAx].stReset.Execute := io_stAlarm.bReset;
    END_FOR;

    IF s_bActive AND (NOT io_stMachine.bFault) THEN
        s_bAxisOwned := TRUE;
        io_astAxis[AX_Z].stHome.Execute := s_bHomeZ;
        io_astAxis[AX_X1].stHome.Execute := s_bHomeX1;
        io_astAxis[AX_X2].stHome.Execute := s_bHomeX2;

        // 准备定位: Hold / 暂停时 Halt, 恢复后重发 Execute (目标不变)
        IF s_bZGo AND (NOT s_bHold) THEN
            io_astAxis[AX_Z].stAbs.Position := s_rZTarget;
            io_astAxis[AX_Z].stAbs.Velocity := io_stPP.rAutoSpeed;
            io_astAxis[AX_Z].stAbs.Execute := TRUE;
            io_astAxis[AX_Z].stHalt.Execute := FALSE;
        ELSE
            io_astAxis[AX_Z].stAbs.Execute := FALSE;
            io_astAxis[AX_Z].stHalt.Execute := s_bZGo;
        END_IF;
        IF s_bX1Go AND (NOT s_bHold) THEN
            io_astAxis[AX_X1].stAbs.Position := s_rX1Target;
            io_astAxis[AX_X1].stAbs.Velocity := io_stPP.rAutoSpeed;
            io_astAxis[AX_X1].stAbs.Execute := TRUE;
            io_astAxis[AX_X1].stHalt.Execute := FALSE;
        ELSE
            io_astAxis[AX_X1].stAbs.Execute := FALSE;
            io_astAxis[AX_X1].stHalt.Execute := s_bX1Go;
        END_IF;
        IF s_bX2Go AND (NOT s_bHold) THEN
            io_astAxis[AX_X2].stAbs.Position := s_rX2Target;
            io_astAxis[AX_X2].stAbs.Velocity := io_stPP.rAutoSpeed;
            io_astAxis[AX_X2].stAbs.Execute := TRUE;
            io_astAxis[AX_X2].stHalt.Execute := FALSE;
        ELSE
            io_astAxis[AX_X2].stAbs.Execute := FALSE;
            io_astAxis[AX_X2].stHalt.Execute := s_bX2Go;
        END_IF;
        io_astAxis[AX_Z].stStop.Execute := FALSE;
        io_astAxis[AX_X1].stStop.Execute := FALSE;
        io_astAxis[AX_X2].stStop.Execute := FALSE;
    ELSIF s_bAxisOwned THEN
        FOR s_iAx := AX_Z TO AX_X2 DO
            io_astAxis[s_iAx].stHome.Execute := FALSE;
            io_astAxis[s_iAx].stAbs.Execute := FALSE;
            io_astAxis[s_iAx].stStop.Execute := io_stMachine.bFault;
            io_astAxis[s_iAx].stHalt.Execute := io_astAxis[s_iAx].stAbs.Busy OR io_astAxis[s_iAx].stHome.Busy;
        END_FOR;
        s_bAxisOwned := io_stMachine.bFault OR io_astAxis[AX_Z].stAbs.Busy OR io_astAxis[AX_X1].stAbs.Busy
                        OR io_astAxis[AX_X2].stAbs.Busy OR io_astAxis[AX_Z].stHome.Busy
                        OR io_astAxis[AX_X1].stHome.Busy OR io_astAxis[AX_X2].stHome.Busy;
    END_IF;
END_FUNCTION_BLOCK
