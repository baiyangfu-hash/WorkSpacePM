(* ================================================================= *)
(*  功能块名称: FB_1006_ManualTeach_BufferFraming                     *)
(*  功能描述:   手动: 速度加减、三轴点动、X1/X2 手动定位、示教、      *)
(*              夹爪松开 / 升降缸、输送强制位放行                      *)
(*  版本号:     V15.0.0 (2026-10-24, 新设计)                          *)
(*                                                                   *)
(*  依据: 详细设计说明书_DSN.md 4.3; 接口文档_INT.md 4.10 / 5 / 7;   *)
(*        需求 R-MAN-01~08; 原程序工艺说明 PRC 3                     *)
(*  遵循规范: LSP-905; 定时器用 SysLib FB_TON (毫秒)                 *)
(*                                                                   *)
(*  轴: Z = io_arrAxis[1], X1 = io_arrAxis[2], X2 = io_arrAxis[3];    *)
(*  HMI 数组的轴序: [1] = X1, [2] = X2, [3] = Z (沿用原 M150~M161)。 *)
(*                                                                   *)
(*  与 INT / DSN 的差异 (评审请确认):                                *)
(*    1. 增加 VAR_IN_OUT io_stExt (X2 手动定位要看组框机安全异常)    *)
(*       和 io_stBridge (输送强制的电机位要在安全区才放行)           *)
(*    2. 输送强制位的电机三位 (正转 / 反转 / 慢速) 不在安全区时不放行 *)
(*       (原程序无此限制, 属安全相关新增, 需安全签字)                *)
(*    3. X1 手动定位的 Z 联锁取"Z <= 待机点 + 容差"(REQ 的"待机点以下"), *)
(*       DSN 写的"Z <= 0"与 REQ 不一致, 待用户确认                   *)
(*    4. X2 手动定位要求 X130 且 X131 (沿用 DSN, 含义待确认 Q-F)     *)
(*    5. 速度加减: 带上升沿 + 100 ms 重复, 每次 +/-5; 自动速度每次     *)
(*       +/-500 (步长为新设, 待确认)                                  *)
(*    6. 点动轴禁止 bJogLock*: 本 FB 取"该轴伺服报警"                *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1006_ManualTeach_BufferFraming

VAR_IN_OUT
    io_stManual         : ST_Manual;            // 手动 / 示教状态 (本 FB 写)
    io_stMachine        : ST_Machine;           // 模式 (读)
    io_stHmi            : ST_Hmi;               // HMI 命令 (读); 速度设定 (写回)
    io_stIo             : ST_Io;                // 物理输入 (读)
    io_stPP             : ST_PickPlace;         // 取放料 (示教写点位, 读待机点)
    io_stFeed           : ST_Feeder;            // 小车 (示教写点位)
    io_stExt            : ST_ExternalLink;      // 组框机链路 (读安全异常)
    io_stBridge         : ST_Bridge;            // 站间中继 (读安全区)
    io_arrAxis          : ARRAY[1..3] OF ST_ServoAxis;  // 轴: 1 = Z, 2 = X1, 3 = X2
END_VAR

VAR
    fb_tRep             : FB_TON;       // 速度加减 100 ms 重复
    s_bRepIn            : BOOL := FALSE;
    s_bRepQ             : BOOL := FALSE;
    s_dRepEt            : DINT := 0;
    s_bTick             : BOOL := FALSE;    // 重复脉冲 (一拍)
    s_bAnySpdBtn        : BOOL := FALSE;

    s_arrPrevUp          : ARRAY[1..3] OF BOOL;
    s_arrPrevDn          : ARRAY[1..3] OF BOOL;
    s_bPrevAutoUp       : BOOL := FALSE;
    s_bPrevAutoDn       : BOOL := FALSE;
    s_arrPrevTeach       : ARRAY[1..6] OF BOOL;
    s_arrPrevPosX1       : ARRAY[1..4] OF BOOL;
    s_arrPrevPosX2       : ARRAY[1..2] OF BOOL;

    s_iX1Req            : INT := 0;         // X1 手动定位请求: 0 无, 1~4 = D510 / D520 / D540 / D550
    s_iX2Req            : INT := 0;         // X2 手动定位请求: 0 无, 1~2 = D512 / D522
    s_rX1Target         : REAL := 0.0;
    s_rX2Target         : REAL := 0.0;
    s_bAxisOwned        : BOOL := FALSE;    // 本 FB 持有过轴命令, 离开手动时需撤销
    s_bManualOk         : BOOL := FALSE;    // 手动 且 无 M8
    s_bZLow             : BOOL := FALSE;    // Z 在待机点以下
    s_bX1PosOk          : BOOL := FALSE;    // X1 手动定位联锁
    s_bX2PosOk          : BOOL := FALSE;    // X2 手动定位联锁
    s_bTeachOk          : BOOL := FALSE;    // 示教联锁
    s_iI                : INT := 0;
    s_iR                : INT := 0;         // 强制位在组内的位置
    s_bStep             : BOOL := FALSE;    // 本扫描触发一次加减
END_VAR

VAR CONSTANT
    AX_Z                : INT := 1;
    AX_X1               : INT := 2;
    AX_X2               : INT := 3;
    HMI_X1              : INT := 1;         // HMI 数组下标
    HMI_X2              : INT := 2;
    HMI_Z               : INT := 3;
    REPEAT_MS           : DINT := 100;
    SPD_MIN             : REAL := 500.0;
    SPD_MAX             : REAL := 5000.0;
    SPD_STEP            : REAL := 5.0;
    SPD_DEFAULT         : REAL := 2000.0;
    AUTO_MIN            : REAL := 10000.0;
    AUTO_MAX            : REAL := 100000.0;
    AUTO_STEP           : REAL := 500.0;
    LAST_FORCE          : INT := 20;
    FORCE_SKIP          : INT := 10;        // M80 不使用
END_VAR

BEGIN
    (* ============ 1. 定时器统一调用 (顶部) ============ *)
    fb_tRep(IN := s_bRepIn, PT := REPEAT_MS, Q => s_bRepQ, ET => s_dRepEt);
    s_bTick := s_bRepQ;

    (* ============ 2. 派生量 ============ *)
    s_bManualOk := io_stMachine.bManual AND (NOT io_stMachine.bFault);
    s_bZLow := (io_arrAxis[AX_Z].rCurrentPos <= (io_stPP.rZStandby + io_stPP.rPosTol));
    s_bTeachOk := s_bManualOk AND io_stMachine.bHomeDone;
    s_bX1PosOk := s_bTeachOk AND s_bZLow AND io_stIo.bPPLiftDown AND (NOT io_stManual.bJogLockX1);
    s_bX2PosOk := s_bTeachOk AND io_stIo.bFrameDropEye1 AND io_stIo.bFrameDropEye2
                  AND (NOT (io_stExt.bLinkMode AND (NOT io_stExt.bLinkFail) AND io_stExt.bPeerSafetyFault))
                  AND (NOT io_stManual.bJogLockX2);
    io_stManual.bJogLockZ := NOT io_stIo.bZServoAlarm;
    io_stManual.bJogLockX1 := NOT io_stIo.bX1ServoAlarm;
    io_stManual.bJogLockX2 := NOT io_stIo.bX2ServoAlarm;

    (* ============ 3. 速度加减 (带边沿 + 100 ms 重复, 夹在上下限) ============ *)
    FOR s_iI := 1 TO 3 DO
        IF io_stHmi.rManualSpeed[s_iI] = 0.0 THEN
            io_stHmi.rManualSpeed[s_iI] := SPD_DEFAULT;
        END_IF;
        IF s_bManualOk THEN
            s_bStep := io_stHmi.bSpeedUp[s_iI] AND ((NOT s_arrPrevUp[s_iI]) OR s_bTick);
            IF s_bStep THEN
                io_stHmi.rManualSpeed[s_iI] := io_stHmi.rManualSpeed[s_iI] + SPD_STEP;
            END_IF;
            s_bStep := io_stHmi.bSpeedDown[s_iI] AND ((NOT s_arrPrevDn[s_iI]) OR s_bTick);
            IF s_bStep THEN
                io_stHmi.rManualSpeed[s_iI] := io_stHmi.rManualSpeed[s_iI] - SPD_STEP;
            END_IF;
        END_IF;
        IF io_stHmi.rManualSpeed[s_iI] > SPD_MAX THEN
            io_stHmi.rManualSpeed[s_iI] := SPD_MAX;
        ELSIF io_stHmi.rManualSpeed[s_iI] < SPD_MIN THEN
            io_stHmi.rManualSpeed[s_iI] := SPD_MIN;
        END_IF;
        s_arrPrevUp[s_iI] := io_stHmi.bSpeedUp[s_iI];
        s_arrPrevDn[s_iI] := io_stHmi.bSpeedDown[s_iI];
    END_FOR;

    // 自动速度 D600 (任何模式可调), 同步给取放料
    IF io_stHmi.rAutoSpeed = 0.0 THEN
        io_stHmi.rAutoSpeed := io_stPP.rAutoSpeed;
    END_IF;
    s_bStep := io_stHmi.bAutoSpeedUp AND ((NOT s_bPrevAutoUp) OR s_bTick);
    IF s_bStep THEN
        io_stHmi.rAutoSpeed := io_stHmi.rAutoSpeed + AUTO_STEP;
    END_IF;
    s_bStep := io_stHmi.bAutoSpeedDown AND ((NOT s_bPrevAutoDn) OR s_bTick);
    IF s_bStep THEN
        io_stHmi.rAutoSpeed := io_stHmi.rAutoSpeed - AUTO_STEP;
    END_IF;
    IF io_stHmi.rAutoSpeed > AUTO_MAX THEN
        io_stHmi.rAutoSpeed := AUTO_MAX;
    ELSIF io_stHmi.rAutoSpeed < AUTO_MIN THEN
        io_stHmi.rAutoSpeed := AUTO_MIN;
    END_IF;
    io_stPP.rAutoSpeed := io_stHmi.rAutoSpeed;
    s_bPrevAutoUp := io_stHmi.bAutoSpeedUp;
    s_bPrevAutoDn := io_stHmi.bAutoSpeedDown;

    s_bAnySpdBtn := io_stHmi.bAutoSpeedUp OR io_stHmi.bAutoSpeedDown;
    FOR s_iI := 1 TO 3 DO
        s_bAnySpdBtn := s_bAnySpdBtn OR io_stHmi.bSpeedUp[s_iI] OR io_stHmi.bSpeedDown[s_iI];
    END_FOR;
    s_bRepIn := s_bAnySpdBtn AND (NOT s_bTick);

    (* ============ 4. 示教: 手动 + 已回原点, 上升沿写当前位置 ============ *)
    FOR s_iI := 1 TO 6 DO
        io_stManual.bTeachWrite[s_iI] := s_bTeachOk AND io_stHmi.bTeach[s_iI] AND (NOT s_arrPrevTeach[s_iI]);
        s_arrPrevTeach[s_iI] := io_stHmi.bTeach[s_iI];
    END_FOR;
    IF io_stManual.bTeachWrite[1] THEN
        io_stPP.astGroup[1].rXPick := io_arrAxis[AX_X1].rCurrentPos;     // M61 -> D510, D514
        io_stPP.astGroup[1].rZPick := io_arrAxis[AX_Z].rCurrentPos;
    END_IF;
    IF io_stManual.bTeachWrite[2] THEN
        io_stPP.astGroup[1].rXPlace := io_arrAxis[AX_X1].rCurrentPos;    // M62 -> D520, D524
        io_stPP.rZPlace := io_arrAxis[AX_Z].rCurrentPos;
    END_IF;
    IF io_stManual.bTeachWrite[3] THEN
        io_stPP.astGroup[2].rXPick := io_arrAxis[AX_X1].rCurrentPos;     // M63 -> D540, D544
        io_stPP.astGroup[2].rZPick := io_arrAxis[AX_Z].rCurrentPos;
    END_IF;
    IF io_stManual.bTeachWrite[4] THEN
        io_stPP.astGroup[2].rXPlace := io_arrAxis[AX_X1].rCurrentPos;    // M64 -> D550
    END_IF;
    IF io_stManual.bTeachWrite[5] THEN
        io_stFeed.rPosPick := io_arrAxis[AX_X2].rCurrentPos;            // M65 -> D512
    END_IF;
    IF io_stManual.bTeachWrite[6] THEN
        io_stFeed.rPosFeed := io_arrAxis[AX_X2].rCurrentPos;            // M66 -> D522
    END_IF;

    (* ============ 5. 夹爪松开 / 升降缸 (新增 R-MAN-07) ============ *)
    io_stManual.bGripOpenCmd := s_bManualOk AND io_stHmi.bGripRelease;
    io_stManual.bLiftUpCmd := s_bManualOk AND io_stHmi.bLiftUp AND (NOT io_stHmi.bLiftDown);
    io_stManual.bLiftDownCmd := s_bManualOk AND io_stHmi.bLiftDown AND (NOT io_stHmi.bLiftUp);

    (* ============ 6. 输送强制位放行: 手动 + 无 M8; 电机位另要求在安全区 ============ *)
    FOR s_iI := 0 TO LAST_FORCE DO
        IF s_iI = FORCE_SKIP THEN
            s_iR := 0;
            io_stManual.abForce[s_iI] := FALSE;
        ELSE
            IF s_iI < FORCE_SKIP THEN
                s_iR := s_iI MOD 5;
            ELSE
                s_iR := (s_iI - FORCE_SKIP - 1) MOD 5;
            END_IF;
            io_stManual.abForce[s_iI] := s_bManualOk AND io_stHmi.bConvForce[s_iI]
                                         AND ((s_iR < 2) OR io_stBridge.bSafeZone);
        END_IF;
    END_FOR;

    (* ============ 7. 轴命令: 手动持有, 离开手动撤销 ============ *)
    // 定位请求: 上升沿锁入, 联锁不满足不接收; 点动或离开手动取消
    FOR s_iI := 1 TO 4 DO
        IF io_stHmi.bPosX1[s_iI] AND (NOT s_arrPrevPosX1[s_iI]) AND s_bX1PosOk THEN
            s_iX1Req := s_iI;
        END_IF;
        s_arrPrevPosX1[s_iI] := io_stHmi.bPosX1[s_iI];
    END_FOR;
    FOR s_iI := 1 TO 2 DO
        IF io_stHmi.bPosX2[s_iI] AND (NOT s_arrPrevPosX2[s_iI]) AND s_bX2PosOk THEN
            s_iX2Req := s_iI;
        END_IF;
        s_arrPrevPosX2[s_iI] := io_stHmi.bPosX2[s_iI];
    END_FOR;
    IF (NOT s_bManualOk) OR io_stHmi.bJog[1] OR io_stHmi.bJog[2] OR (NOT s_bX1PosOk)
       OR io_arrAxis[AX_X1].stAbs.Done THEN
        s_iX1Req := 0;
    END_IF;
    IF (NOT s_bManualOk) OR io_stHmi.bJog[3] OR io_stHmi.bJog[4] OR (NOT s_bX2PosOk)
       OR io_arrAxis[AX_X2].stAbs.Done THEN
        s_iX2Req := 0;
    END_IF;
    CASE s_iX1Req OF
        1:
            s_rX1Target := io_stPP.astGroup[1].rXPick;
        2:
            s_rX1Target := io_stPP.astGroup[1].rXPlace;
        3:
            s_rX1Target := io_stPP.astGroup[2].rXPick;
        4:
            s_rX1Target := io_stPP.astGroup[2].rXPlace;
    ELSE
        s_rX1Target := io_arrAxis[AX_X1].rCurrentPos;
    END_CASE;
    CASE s_iX2Req OF
        1:
            s_rX2Target := io_stFeed.rPosPick;
        2:
            s_rX2Target := io_stFeed.rPosFeed;
    ELSE
        s_rX2Target := io_arrAxis[AX_X2].rCurrentPos;
    END_CASE;

    IF s_bManualOk THEN
        s_bAxisOwned := TRUE;
        // 点动: 按住运动, 松开 Forward / Backward 撤销 (减速停); 正反速度相同
        io_arrAxis[AX_X1].stJog.Forward := io_stHmi.bJog[1] AND (NOT io_stHmi.bJog[2]) AND (NOT io_stManual.bJogLockX1);
        io_arrAxis[AX_X1].stJog.Backward := io_stHmi.bJog[2] AND (NOT io_stHmi.bJog[1]) AND (NOT io_stManual.bJogLockX1);
        io_arrAxis[AX_X1].stJog.Velocity := io_stHmi.rManualSpeed[HMI_X1];
        io_arrAxis[AX_X2].stJog.Forward := io_stHmi.bJog[3] AND (NOT io_stHmi.bJog[4]) AND (NOT io_stManual.bJogLockX2);
        io_arrAxis[AX_X2].stJog.Backward := io_stHmi.bJog[4] AND (NOT io_stHmi.bJog[3]) AND (NOT io_stManual.bJogLockX2);
        io_arrAxis[AX_X2].stJog.Velocity := io_stHmi.rManualSpeed[HMI_X2];
        io_arrAxis[AX_Z].stJog.Forward := io_stHmi.bJog[5] AND (NOT io_stHmi.bJog[6]) AND (NOT io_stManual.bJogLockZ);
        io_arrAxis[AX_Z].stJog.Backward := io_stHmi.bJog[6] AND (NOT io_stHmi.bJog[5]) AND (NOT io_stManual.bJogLockZ);
        io_arrAxis[AX_Z].stJog.Velocity := io_stHmi.rManualSpeed[HMI_Z];
        // 手动定位
        io_arrAxis[AX_X1].stAbs.Position := s_rX1Target;
        io_arrAxis[AX_X1].stAbs.Velocity := io_stHmi.rManualSpeed[HMI_X1];
        io_arrAxis[AX_X1].stAbs.Execute := (s_iX1Req > 0);
        io_arrAxis[AX_X2].stAbs.Position := s_rX2Target;
        io_arrAxis[AX_X2].stAbs.Velocity := io_stHmi.rManualSpeed[HMI_X2];
        io_arrAxis[AX_X2].stAbs.Execute := (s_iX2Req > 0);
        io_arrAxis[AX_Z].stAbs.Execute := FALSE;
    ELSIF s_bAxisOwned THEN
        FOR s_iI := AX_Z TO AX_X2 DO
            io_arrAxis[s_iI].stJog.Forward := FALSE;
            io_arrAxis[s_iI].stJog.Backward := FALSE;
            io_arrAxis[s_iI].stAbs.Execute := FALSE;
            io_arrAxis[s_iI].stStop.Execute := io_stMachine.bFault;
            io_arrAxis[s_iI].stHalt.Execute := io_arrAxis[s_iI].stAbs.Busy OR io_arrAxis[s_iI].stJog.Busy;
        END_FOR;
        s_bAxisOwned := io_stMachine.bFault OR io_arrAxis[AX_Z].stAbs.Busy OR io_arrAxis[AX_X1].stAbs.Busy
                        OR io_arrAxis[AX_X2].stAbs.Busy OR io_arrAxis[AX_Z].stJog.Busy
                        OR io_arrAxis[AX_X1].stJog.Busy OR io_arrAxis[AX_X2].stJog.Busy;
    END_IF;
END_FUNCTION_BLOCK
