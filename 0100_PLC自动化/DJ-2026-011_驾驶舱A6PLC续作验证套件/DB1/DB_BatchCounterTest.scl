// ============================================================================
// DB_BatchCounterTest: 批量计数功能块测试实例数据块
// 描述: 只放测试激励/结果变量 (TIA 全局 DB 不能放 FB 实例, 实例在 FB_9001 测试台里),
//       激励由 .scltest 写入, 结果供 .scltest 断言与上位机读取。
// ============================================================================

DATA_BLOCK DB_BatchCounterTest
{ S7_Optimized_Block := 'TRUE' }
VERSION : 1.0

VAR
    s_bPhotoSensor   : BOOL := FALSE;                  // 测试激励: 光电传感器信号
    s_dBatchTarget   : DINT := 5;                      // 测试激励: 批次设定数量
    s_bReset         : BOOL := FALSE;                  // 测试激励: 复位按钮
    s_dBatchCount    : DINT;                           // 结果: 当前批次已计工件数
    s_bBatchComplete : BOOL;                           // 结果: 批次完成
END_VAR

BEGIN
END_DATA_BLOCK
