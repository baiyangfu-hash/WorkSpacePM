// ============================================================================
// FB_1091_TwoHandStart_DJ2026011: 双手启动功能块
// 描述: 两个启动按钮须在 0.5 秒(默认 500ms, 可调)内先后按下并一直按住才输出启动;
//       任一松开立即停止; 两个都松开后才允许下一次启动;
//       同一扫描周期双手同步按下视为满足同步窗口。
// 遵守规范: Siemens LSP (LSP-903 三段式 / LSP-905 命名与 CASE-ELSE / LSP-906 DINT 定时器)
// ============================================================================

FUNCTION_BLOCK FB_1091_TwoHandStart_DJ2026011
VAR_INPUT
    i_bStartLeft    : BOOL;   // 左启动按钮 (按下=TRUE)
    i_bStartRight   : BOOL;   // 右启动按钮 (按下=TRUE)
    i_dSyncWindowMs : DINT;   // 双手同步窗口毫秒值, 500 = 0.5s
END_VAR
VAR_OUTPUT
    o_bStartOutput  : BOOL;   // 双手启动输出, 双手按住时保持 TRUE
    o_bSyncFault    : BOOL;   // 同步故障: 单手持按超过同步窗口
END_VAR
VAR
    fb_tSyncWindow  : FB_TON; // 同步窗口定时器 (DINT 毫秒三段式)
    s_iStep         : INT := 0; // 状态机当前步序
    s_bAnyPressed   : BOOL;   // 任一按钮按下
    s_bBothPressed  : BOOL;   // 双手同时按下
END_VAR

BEGIN
    // ------------------------------------------------------------------
    // 定时器三段式 Step 1: 预赋值 (单手持按且处于等待第二只手步序时计时)
    // ------------------------------------------------------------------
    s_bAnyPressed  := i_bStartLeft OR i_bStartRight;
    s_bBothPressed := i_bStartLeft AND i_bStartRight;

    fb_tSyncWindow.IN := s_bAnyPressed AND NOT s_bBothPressed AND (s_iStep = 10);
    fb_tSyncWindow.PT := i_dSyncWindowMs;

    // ------------------------------------------------------------------
    // 定时器三段式 Step 2: 全参数调用 (FB 顶部无条件批量调用区)
    // ------------------------------------------------------------------
    fb_tSyncWindow(IN := fb_tSyncWindow.IN,
                   PT := fb_tSyncWindow.PT,
                   Q => fb_tSyncWindow.Q,
                   ET => fb_tSyncWindow.ET);

    // ------------------------------------------------------------------
    // CASE 状态机 (带 ELSE 防死锁容错分支)
    //   0  空闲: 双手都松开才清故障; 单手按下进入等待; 双手同扫按下直接运行
    //   10 等待第二只手: 窗口内双手按下进入运行; 中途全松开回空闲; 超窗置故障
    //   20 运行: 任一松开立即退出运行
    //   30 等待释放: 双手都松开后才允许回空闲再启动
    // ------------------------------------------------------------------
    CASE s_iStep OF
        0:
            o_bSyncFault := FALSE;
            IF s_bBothPressed THEN
                s_iStep := 20;
            ELSIF s_bAnyPressed THEN
                s_iStep := 10;
            END_IF;
        10:
            IF s_bBothPressed THEN
                s_iStep := 20;
            ELSIF NOT s_bAnyPressed THEN
                s_iStep := 0;
            ELSIF fb_tSyncWindow.Q THEN
                o_bSyncFault := TRUE;
                s_iStep := 30;
            END_IF;
        20:
            IF NOT s_bBothPressed THEN
                s_iStep := 30;
            END_IF;
        30:
            IF NOT s_bAnyPressed THEN
                s_iStep := 0;
            END_IF;
    ELSE
        s_iStep := 0;
    END_CASE;

    // ------------------------------------------------------------------
    // 定时器三段式 Step 3: 读输出已在 CASE 中完成 (fb_tSyncWindow.Q)
    // 最终输出: 仅运行态且双手按住, 任一松开当扫描即断开
    // ------------------------------------------------------------------
    o_bStartOutput := (s_iStep = 20) AND s_bBothPressed;

END_FUNCTION_BLOCK
