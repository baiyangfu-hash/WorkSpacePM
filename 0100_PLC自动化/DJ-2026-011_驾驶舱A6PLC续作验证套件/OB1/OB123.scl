// ==============================================================================
// 模块名称: OB123 (程序循环 OB, 测试用)
// 项目: DJ-2026-011 驾驶舱A6PLC续作验证套件
// 模块功能: 每个扫描周期调用一次测试台 FB_9001 (背景 DB "DB_TestBench"),
//           测试台再调度双手启动 / 报警汇总 / 批量计数三个功能块
// 说明: S7-1200 的程序循环 OB 编号只能是 1 或 123 以上; 本文件默认用 OB123,
//       避免与用户项目里已有的 OB1 "Main" 冲突。导入后可在 TIA 里改名或改号,
//       也可以只把下面那一行调用复制进已有的 Main。
// 遵守规范: Siemens LSP (LSP-903/905/906)
// ==============================================================================

ORGANIZATION_BLOCK "DJ011_TestMain"
{ S7_Optimized_Block := 'TRUE' }
VERSION : 1.0

VAR_TEMP
END_VAR

BEGIN
    "DB_TestBench"();
END_ORGANIZATION_BLOCK
