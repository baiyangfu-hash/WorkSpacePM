// ============================================================================
// two_hand_start_test.scltest - FB_1091_TwoHandStart_DJ2026011 功能测试
// ============================================================================
// 被测对象: FB_0001/FB_1091_TwoHandStart_DJ2026011 (实例在 DB_TwoHandStartTest)
// 同步窗口: s_dSyncWindowMs = 500 (0.5 秒, DINT 毫秒/扫描周期计数)
//
// 测试覆盖 (LSP-905 §4.8 四标段):
//   test1 - 基本: 双手同步按下立即输出
//   test2 - 状态转移: 先后按下间隔小于窗口 -> 输出
//   test3 - 边界/超时: 单手持按超窗 -> 不输出 + 同步故障
//   test4 - 异常防错: 运行中松开任一 -> 立即停止
//   test5 - 异常防错: 未全松开 -> 不允许再次启动
//   test6 - 基本: 双手全松后 -> 允许下一次启动
// ============================================================================

// ============================================================================
// test1: 双手同步按下 (同一扫描周期) -> 视为满足窗口, 立即输出
// ============================================================================
TEST_CASE "test1_both_pressed_simultaneous"
    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 2;

    SET DB_TwoHandStartTest.s_bStartLeft := TRUE;
    SET DB_TwoHandStartTest.s_bStartRight := TRUE;
    WAIT_CYCLES 2;

    ASSERT DB_TwoHandStartTest.s_bStartOutput = TRUE;
    ASSERT DB_TwoHandStartTest.s_bSyncFault = FALSE;
END_TEST_CASE

// ============================================================================
// test2: 先左后右, 间隔 100 周期 (< 500 窗口) -> 输出启动
// ============================================================================
TEST_CASE "test2_sequential_within_window"
    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 2;

    SET DB_TwoHandStartTest.s_bStartLeft := TRUE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 100;

    SET DB_TwoHandStartTest.s_bStartRight := TRUE;
    WAIT_CYCLES 2;

    ASSERT DB_TwoHandStartTest.s_bStartOutput = TRUE;
    ASSERT DB_TwoHandStartTest.s_bSyncFault = FALSE;
END_TEST_CASE

// ============================================================================
// test3: 单手持按 600 周期 (> 500 窗口) 再按另一只 -> 不输出, 置同步故障
// ============================================================================
TEST_CASE "test3_single_hold_timeout"
    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 2;

    SET DB_TwoHandStartTest.s_bStartLeft := TRUE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 600;

    SET DB_TwoHandStartTest.s_bStartRight := TRUE;
    WAIT_CYCLES 2;

    ASSERT DB_TwoHandStartTest.s_bStartOutput = FALSE;
    ASSERT DB_TwoHandStartTest.s_bSyncFault = TRUE;
END_TEST_CASE

// ============================================================================
// test4: 运行中松开任一按钮 -> 立即停止输出
// ============================================================================
TEST_CASE "test4_release_stops_immediately"
    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 2;

    SET DB_TwoHandStartTest.s_bStartLeft := TRUE;
    SET DB_TwoHandStartTest.s_bStartRight := TRUE;
    WAIT_CYCLES 2;
    ASSERT DB_TwoHandStartTest.s_bStartOutput = TRUE;

    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    WAIT_CYCLES 2;

    ASSERT DB_TwoHandStartTest.s_bStartOutput = FALSE;
END_TEST_CASE

// ============================================================================
// test5: 一只手保持按住不放, 另一只手重按 -> 不允许再次启动
// ============================================================================
TEST_CASE "test5_no_restart_until_both_released"
    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 2;

    SET DB_TwoHandStartTest.s_bStartLeft := TRUE;
    SET DB_TwoHandStartTest.s_bStartRight := TRUE;
    WAIT_CYCLES 2;

    // 松开左手, 右手保持
    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    WAIT_CYCLES 2;
    ASSERT DB_TwoHandStartTest.s_bStartOutput = FALSE;

    // 右手未松开时重按左手 -> 仍不得输出
    SET DB_TwoHandStartTest.s_bStartLeft := TRUE;
    WAIT_CYCLES 2;

    ASSERT DB_TwoHandStartTest.s_bStartOutput = FALSE;
END_TEST_CASE

// ============================================================================
// test6: 双手都松开后 -> 允许下一次启动
// ============================================================================
TEST_CASE "test6_restart_after_full_release"
    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 2;

    SET DB_TwoHandStartTest.s_bStartLeft := TRUE;
    SET DB_TwoHandStartTest.s_bStartRight := TRUE;
    WAIT_CYCLES 2;

    // 双手全松开 -> 回到空闲
    SET DB_TwoHandStartTest.s_bStartLeft := FALSE;
    SET DB_TwoHandStartTest.s_bStartRight := FALSE;
    WAIT_CYCLES 2;

    // 再次双手按下 -> 允许启动
    SET DB_TwoHandStartTest.s_bStartLeft := TRUE;
    SET DB_TwoHandStartTest.s_bStartRight := TRUE;
    WAIT_CYCLES 2;

    ASSERT DB_TwoHandStartTest.s_bStartOutput = TRUE;
    ASSERT DB_TwoHandStartTest.s_bSyncFault = FALSE;
END_TEST_CASE
