    "DB_1006_ManualTeach_DJ005"(io_stManual := GlobalVars_DJ005.stManual, io_stMachine := GlobalVars_DJ005.stMachine, io_stHmi := GlobalVars_DJ005.stHmi, io_stIo := GlobalVars_DJ005.stIo, io_stPP := GlobalVars_DJ005.stPP, io_stFeed := GlobalVars_DJ005.stFeed, io_stExt := GlobalVars_DJ005.stExt, io_stBridge := GlobalVars_DJ005.stBridge, io_arrAxis := GlobalVars_DJ005.astAxis);
    "DB_3001_ExternalDevice_DJ005"(io_stExt := GlobalVars_DJ005.stExt, io_stMachine := GlobalVars_DJ005.stMachine, io_stHmi := GlobalVars_DJ005.stHmi, io_stIo := GlobalVars_DJ005.stIo, io_stFeed := GlobalVars_DJ005.stFeed, io_stAlarm := GlobalVars_DJ005.stAlarm);
    "DB_2002_StationBridge_DJ005"(io_stBridge := GlobalVars_DJ005.stBridge, io_stConv := GlobalVars_DJ005.stConv, io_stPP := GlobalVars_DJ005.stPP, io_stFeed := GlobalVars_DJ005.stFeed, io_stHome := GlobalVars_DJ005.stHome, io_stManual := GlobalVars_DJ005.stManual, io_stExt := GlobalVars_DJ005.stExt, io_stMachine := GlobalVars_DJ005.stMachine, io_stAlarm := GlobalVars_DJ005.stAlarm);
    "DB_1007_ConveyorSystem_DJ005"(io_stConv := GlobalVars_DJ005.stConv, io_stBridge := GlobalVars_DJ005.stBridge, io_stMachine := GlobalVars_DJ005.stMachine, io_stIo := GlobalVars_DJ005.stIo, io_stAlarm := GlobalVars_DJ005.stAlarm, io_stHmi := GlobalVars_DJ005.stHmi, io_stManual := GlobalVars_DJ005.stManual);
    "DB_1003_PickPlace_DJ005"(io_stPP := GlobalVars_DJ005.stPP, io_stBridge := GlobalVars_DJ005.stBridge, io_stMachine := GlobalVars_DJ005.stMachine, io_stIo := GlobalVars_DJ005.stIo, io_stAlarm := GlobalVars_DJ005.stAlarm, io_arrAxis := GlobalVars_DJ005.astAxis);
    "DB_1004_GlueMachineFeeder_DJ005"(io_stFeed := GlobalVars_DJ005.stFeed, io_stBridge := GlobalVars_DJ005.stBridge, io_stExt := GlobalVars_DJ005.stExt, io_stMachine := GlobalVars_DJ005.stMachine, io_stIo := GlobalVars_DJ005.stIo, io_stAlarm := GlobalVars_DJ005.stAlarm, io_arrAxis := GlobalVars_DJ005.astAxis);
    "DB_2001_CommonAlarm_DJ005"(io_stAlarm := GlobalVars_DJ005.stAlarm, io_stMachine := GlobalVars_DJ005.stMachine, io_stIo := GlobalVars_DJ005.stIo, io_stHmi := GlobalVars_DJ005.stHmi);
