// ============================================================================
// OB1.scl - {{ project_name }} 主组织块 (全工站结构体整块传递架构)
// ============================================================================
// 描述:
//   {{ project_id }} {{ project_name }} PLC 控制系统主循环调度程序.
//   全工站通过 VAR_IN_OUT 结构体整块传递 (Struct Chunk Passing), 遵循 LSP-905 规范.
//   每个功能块通过自己的背景 DB 单实例调用 (TIA 全局 DB 不能放 FB 实例, LSP-905 §4.11);
//   VAR_IN_OUT 按引用传递, 调用后不需要再把结构体写回 GlobalVars.
// ============================================================================
ORGANIZATION_BLOCK OB1

BEGIN
    // ============================================================================
    // 第1部分：外部设备交互 (ST_ExternalDevice)
    // ============================================================================
    "DB_3001_ExternalInteraction"(io_stExternal := GlobalVars.stExternal);

    // ============================================================================
    // 第2部分：工位1 动作机构 (ST_Station1)
    // ============================================================================
    "DB_1001_Station1"(io_stStation := GlobalVars.stStation1);

    // ============================================================================
    // 第3部分：公共报警与 OMAC 状态机 (ST_CommonAlarm)
    // ============================================================================
    "DB_2001_CommonAlarm"(io_stGlobal := GlobalVars.stGlobal);

END_ORGANIZATION_BLOCK
