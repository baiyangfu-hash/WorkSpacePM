// ============================================================================
// OB123.scl - {{ project_name }} 主组织块 (全工站结构体整块传递架构)
// ============================================================================
// 描述:
//   {{ project_id }} {{ project_name }} PLC 控制系统主循环调度程序.
//   全工站通过 VAR_IN_OUT 结构体整块传递 (Struct Chunk Passing), 遵循 LSP-905 规范.
//   每个功能块通过自己的背景 DB 单实例调用 (TIA 全局 DB 不能放 FB 实例, LSP-905 §4.11);
//   VAR_IN_OUT 按引用传递, 调用后不需要再把结构体写回 GlobalVars_{{ project_tag }}.
//
// 块名与编号 (LSP-905 §3.4/§4.11):
//   块名带项目标记 {{ project_tag }}, 不叫 Main/OB1, 导入时不会覆盖你项目里已有的同名块.
//   程序循环 OB 用 123 及以上; TIA 从源生成块时自己分配块号, 导入后可在 TIA 里改号.
//   如果你的项目已有主程序, 也可以不导入本 OB, 只把下面三行调用复制进你自己的主程序.
// ============================================================================
ORGANIZATION_BLOCK "{{ project_tag }}_Main"

BEGIN
    // ============================================================================
    // 第1部分：外部设备交互 (ST_ExternalDevice{{ udt_suffix }})
    // ============================================================================
    "DB_3001_ExternalInteraction_{{ project_tag }}"(io_stExternal := GlobalVars_{{ project_tag }}.stExternal);

    // ============================================================================
    // 第2部分：工位1 动作机构 (ST_Station1{{ udt_suffix }})
    // ============================================================================
    "DB_1001_Station1_{{ project_tag }}"(io_stStation := GlobalVars_{{ project_tag }}.stStation1);

    // ============================================================================
    // 第3部分：公共报警与 OMAC 状态机 (ST_CommonAlarm{{ udt_suffix }})
    // ============================================================================
    "DB_2001_CommonAlarm_{{ project_tag }}"(io_stGlobal := GlobalVars_{{ project_tag }}.stGlobal);

END_ORGANIZATION_BLOCK
