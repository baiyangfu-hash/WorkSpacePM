// ============================================================================
// GlobalVars.db - {{ project_name }} 全局变量数据块
// ============================================================================
// 功能说明:
//   定义 {{ project_id }} {{ project_name }} PLC 控制系统的全局变量总线.
//   作为 OB123 主程序与各工位功能块之间的数据交换中心, 实现统一的结构体整块传递.
//
// 数据组织:
//   采用结构化分组方式 (STRUCT), 严格遵循 LSP-905 与 STD-901 架构规范.
//   - stGlobal:     全局控制信号和系统状态 (来自 FB_2001_CommonAlarm_AllStation_{{ project_tag }} / OMAC 状态机)
//   - stExternal:   外部设备交互信号 (ST_ExternalDevice{{ udt_suffix }})
//   - stStation1:   工位1 动作机构控制与状态 (ST_Station1{{ udt_suffix }})
// ============================================================================

DATA_BLOCK GlobalVars_{{ project_tag }}
{ S7_Optimized_Block := 'TRUE' }
VERSION : 1.0

VAR
    // =========================================================================
    // 第一部分: 全局控制信号与系统状态 (OMAC 8模式与首出报警)
    // =========================================================================
    stGlobal        : ST_CommonAlarm{{ udt_suffix }};  // 全局控制与报警数据

    // =========================================================================
    // 第二部分: 外部设备交互信号 (STD-820 通用总线)
    // =========================================================================
    stExternal      : ST_ExternalDevice{{ udt_suffix }};  // 外部设备交互信号

    // =========================================================================
    // 第三部分: 工位1 动作机构数据结构
    // =========================================================================
    stStation1      : ST_Station1{{ udt_suffix }};  // 工位1全局交互结构体

    // 伺服轴不放在模板里 (D-245): 模板没有伺服 FB, 轴结构体 ST_ServoAxis 在 SysLib 里,
    // 只导入本项目的源文件时 TIA 找不到它. 要用伺服轴时, 先导入 SysLib/types/ST_ServoAxis.scl,
    // 再在这里声明伺服轴数组 astServoAxis (元素类型 ST_ServoAxis).

    // 功能块实例不放在本全局 DB 里 (TIA 全局 DB 不能放 FB 实例, LSP-905 §4.11):
    // 每个功能块有自己的背景 DB, 见本目录 DB_3001/DB_1001/DB_2001_*.scl
END_VAR

BEGIN
END_DATA_BLOCK
