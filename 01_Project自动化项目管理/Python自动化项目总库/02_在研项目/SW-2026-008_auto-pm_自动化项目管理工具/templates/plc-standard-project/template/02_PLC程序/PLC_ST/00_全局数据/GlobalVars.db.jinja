// ============================================================================
// GlobalVars.db - {{ project_name }} 全局变量数据块
// ============================================================================
// 功能说明:
//   定义 {{ project_id }} {{ project_name }} PLC 控制系统的全局变量总线.
//   作为 OB1 主程序与各工位功能块之间的数据交换中心, 实现统一的结构体整块传递.
//
// 数据组织:
//   采用结构化分组方式 (STRUCT), 严格遵循 LSP-905 与 STD-901 架构规范.
//   - stGlobal:     全局控制信号和系统状态 (来自 FB_2001_CommonAlarm / OMAC 状态机)
//   - stExternal:   外部设备交互信号 (ST_ExternalDevice)
//   - stStation1:   工位1 动作机构控制与状态 (ST_Station1)
//   - astServoAxis: 伺服驱动轴数组 (ST_ServoAxis - PLCopen MC Part 1)
// ============================================================================

DATA_BLOCK GlobalVars

VAR
    // =========================================================================
    // 第一部分: 全局控制信号与系统状态 (OMAC 8模式与首出报警)
    // =========================================================================
    stGlobal        : ST_CommonAlarm;  // 全局控制与报警数据

    // =========================================================================
    // 第二部分: 外部设备交互信号 (STD-820 通用总线)
    // =========================================================================
    stExternal      : ST_ExternalDevice;  // 外部设备交互信号

    // =========================================================================
    // 第三部分: 工位1 动作机构数据结构
    // =========================================================================
    stStation1      : ST_Station1;  // 工位1全局交互结构体

    // =========================================================================
    // 第四部分: 伺服轴数组 (STD-840 / PLCopen 伺服定位)
    // =========================================================================
    astServoAxis    : ARRAY[1..4] OF ST_ServoAxis;  // 伺服轴数组

    // =========================================================================
    // 第五部分: 功能块全局调度实例
    // =========================================================================
    fbExternalDevice: FB_3001_ExternalInteraction;  // 外部设备交互功能块实例
    fbStation1      : FB_1001_Station1;  // 工位1功能块实例
    fbCommonAlarm   : FB_2001_CommonAlarm_AllStation;  // 公共报警功能块实例
END_VAR

END_DATA_BLOCK
