TEST_CASE "TC_Interlock_AlarmPriority"
    SET GlobalVars_{{ project_tag }}.stGlobal.i_iConveyorAlarm := 5;
    SET GlobalVars_{{ project_tag }}.stGlobal.i_iPickPlaceAlarm := 2;
    WAIT_CYCLES 2;
