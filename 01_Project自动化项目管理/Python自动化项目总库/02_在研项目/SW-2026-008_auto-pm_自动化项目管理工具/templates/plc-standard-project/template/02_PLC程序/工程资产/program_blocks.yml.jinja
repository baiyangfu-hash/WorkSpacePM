project_id: "{{ project_id }}"
project_name: "{{ project_name }}"
plc_program_root: "02_PLC程序/PLC_ST"
blocks:
  - name: "{{ project_tag }}_Main"
    type: "OB"
    path: "02_PLC程序/PLC_ST/00_主程序/OB123.scl"
    responsibility: "主循环与调用编排（导入后手工改块号为 123）"
  - name: "GlobalVars_{{ project_tag }}"
    type: "DB"
    path: "02_PLC程序/PLC_ST/00_全局数据/GlobalVars.db"
    responsibility: "全局变量与 IO 映射（不含 FB 实例）"
  - name: "FB_3001_ExternalInteraction_{{ project_tag }}"
    type: "FB"
    path: "02_PLC程序/PLC_ST/01_外部设备交互/FB_3001_ExternalInteraction.scl"
    responsibility: "外部设备交互（上游/下游握手、心跳）"
  - name: "FB_1001_Station1_{{ project_tag }}"
    type: "FB"
    path: "02_PLC程序/PLC_ST/02_工位_动作机构/FB_1001_Station1.scl"
    responsibility: "工位动作机构（各工位共用，每个工位一个背景 DB：{{ station_instances | join('、') }}）"
  - name: "FB_2001_CommonAlarm_AllStation_{{ project_tag }}"
    type: "FB"
    path: "02_PLC程序/PLC_ST/05_公共报警/FB_2001_CommonAlarm_AllStation.scl"
    responsibility: "公共报警汇总与 OMAC 状态机"
  - name: "FC_4001_ScaleAnalog"
    type: "FC"
    path: "02_PLC程序/PLC_ST/06_公共函数/FC_4001_ScaleAnalog.scl"
    responsibility: "模拟量换算"
