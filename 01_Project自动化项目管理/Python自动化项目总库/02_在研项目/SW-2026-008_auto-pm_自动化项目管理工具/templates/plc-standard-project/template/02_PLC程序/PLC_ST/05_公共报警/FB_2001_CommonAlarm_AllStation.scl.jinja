(* ================================================================= *)
(*  功能块名称:FB_2001_CommonAlarm_AllStation_{{ project_tag }}                        *)
(*  功能描述:公共报警管理功能块 - 汇总所有工站报警信息                *)
(*  版本号:V3.0.0 (结构体整块传递架构)                               *)
(* ================================================================= *)
FUNCTION_BLOCK FB_2001_CommonAlarm_AllStation_{{ project_tag }}

VAR_IN_OUT
    io_stGlobal                : ST_2001_CommonAlarm{{ udt_suffix }}; // 公共报警工站全量数据结构体
END_VAR

VAR
    // 局部解包/封包变量 (白盒兼容内部逻辑); 是本块的静态变量, 按 LSP-905 用 s_ 前缀, s_In* 解包自 io_stGlobal, s_Out* 封包回 io_stGlobal
    s_iInConveyorAlarm           : INT;
    s_iInPickPlaceAlarm          : INT;
    s_iInFeederAlarm             : INT;
    s_bInReset                   : BOOL;

    s_wOutGlobalAlarmWord         : WORD;
    s_iOutCurrentAlarmCode        : INT;
    s_bOutAnyAlarmActive          : BOOL;
    s_iOutMesAlarmCount           : INT;
    s_arrMesAlarmQueue           : ARRAY[1..10] OF INT;   // 下标从 1 起: 与 Siemens 语言服务插件一致 (移植到实际 PLC 时按平台适配)
    s_bOutNewAlarmFlag            : BOOL;
    s_arrStationAlarmStatus      : ARRAY[1..3] OF INT;
    s_bOutConveyorAlarmActive     : BOOL;
    s_bOutPickPlaceAlarmActive    : BOOL;
    s_bOutFeederAlarmActive       : BOOL;

    s_iPrevConveyorAlarm       : INT;
    s_iPrevPickPlaceAlarm      : INT;
    s_iPrevFeederAlarm         : INT;
    s_wPrevGlobalAlarmWord     : WORD;
    s_bConveyorAlarmActive     : BOOL;
    s_bPickPlaceAlarmActive    : BOOL;
    s_bFeederAlarmActive       : BOOL;
    s_iMinAlarmCode            : INT;
    s_iQueueTailIndex          : INT := 1;   // 队尾下标: 队列从 1 起, 声明处给初值, 首周期不复位也不越界 (D-232)
    s_bAlarmExistsInQueue      : BOOL;
    s_iQueueScanIndex          : INT;
    s_iAlarmCount              : INT;
    s_bNewAlarmDetected        : BOOL;
    s_bQueueFull               : BOOL;
END_VAR

VAR CONSTANT
    QUEUE_SIZE     : INT := 10;     // 报警队列大小
    ALM_NONE       : INT := 0;      // 无报警值
    ALM_WORD_ZERO  : WORD := 0;     // 报警字零值
END_VAR

BEGIN
(* ==================== 结构体解包 (输入映射) ==================== *)
s_iInConveyorAlarm               := io_stGlobal.i_iConveyorAlarm;
s_iInPickPlaceAlarm              := io_stGlobal.i_iPickPlaceAlarm;
s_iInFeederAlarm                 := io_stGlobal.i_iFeederAlarm;
s_bInReset                       := io_stGlobal.i_bReset;

(* -------------------------------------------------------------------------- *)
(* 1. 保存当前输入状态用于下一周期比较                                          *)
(* -------------------------------------------------------------------------- *)
s_iPrevConveyorAlarm := s_iInConveyorAlarm;
s_iPrevPickPlaceAlarm := s_iInPickPlaceAlarm;
s_iPrevFeederAlarm := s_iInFeederAlarm;

(* -------------------------------------------------------------------------- *)
(* 2. 复位处理                                                                *)
(* -------------------------------------------------------------------------- *)
IF s_bInReset THEN
    s_wOutGlobalAlarmWord := ALM_WORD_ZERO;
    s_iOutCurrentAlarmCode := ALM_NONE;
    s_bOutAnyAlarmActive := FALSE;
    s_bOutNewAlarmFlag := FALSE;
    s_iOutMesAlarmCount := ALM_NONE;
    s_iAlarmCount := ALM_NONE;
    FOR s_iQueueScanIndex := 1 TO QUEUE_SIZE DO
        s_arrMesAlarmQueue[s_iQueueScanIndex] := ALM_NONE;
    END_FOR;
    s_iQueueTailIndex := 1;
    s_bNewAlarmDetected := FALSE;
    s_iMinAlarmCode := ALM_NONE;
    s_wPrevGlobalAlarmWord := ALM_WORD_ZERO;
    s_bQueueFull := FALSE;
    (* 复位周期同样要把输出写回结构体，否则上位机读到的是复位前的旧值 *)
    io_stGlobal.o_wGlobalAlarmWord       := s_wOutGlobalAlarmWord;
    io_stGlobal.o_iCurrentAlarmCode      := s_iOutCurrentAlarmCode;
    io_stGlobal.o_bAnyAlarmActive        := s_bOutAnyAlarmActive;
    io_stGlobal.o_iMESAlarmCount         := s_iOutMesAlarmCount;
    io_stGlobal.o_bNewAlarmFlag          := s_bOutNewAlarmFlag;
    io_stGlobal.o_bConveyorAlarmActive   := s_bOutConveyorAlarmActive;
    io_stGlobal.o_bPickPlaceAlarmActive  := s_bOutPickPlaceAlarmActive;
    io_stGlobal.o_bFeederAlarmActive     := s_bOutFeederAlarmActive;
    RETURN;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 3. 各工站报警激活状态检测                                                    *)
(* -------------------------------------------------------------------------- *)
s_bConveyorAlarmActive := (s_iInConveyorAlarm <> ALM_NONE);
s_bPickPlaceAlarmActive := (s_iInPickPlaceAlarm <> ALM_NONE);
s_bFeederAlarmActive := (s_iInFeederAlarm <> ALM_NONE);

(* -------------------------------------------------------------------------- *)
(* 4. 全局报警字生成                                                          *)
(*    将各工站报警码按位或组合成全局报警字                                      *)
(* -------------------------------------------------------------------------- *)
s_wOutGlobalAlarmWord := ALM_WORD_ZERO;

IF s_bConveyorAlarmActive THEN
    s_wOutGlobalAlarmWord := s_wOutGlobalAlarmWord OR INT_TO_WORD(s_iInConveyorAlarm);
END_IF;

IF s_bPickPlaceAlarmActive THEN
    s_wOutGlobalAlarmWord := s_wOutGlobalAlarmWord OR INT_TO_WORD(s_iInPickPlaceAlarm);
END_IF;

IF s_bFeederAlarmActive THEN
    s_wOutGlobalAlarmWord := s_wOutGlobalAlarmWord OR INT_TO_WORD(s_iInFeederAlarm);
END_IF;

(* -------------------------------------------------------------------------- *)
(* 5. 最高优先级报警码选择                                                      *)
(*    选择最小报警码作为当前最高优先级报警(报警码越小优先级越高)                *)
(* -------------------------------------------------------------------------- *)
s_iMinAlarmCode := ALM_NONE;

IF s_bConveyorAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := s_iInConveyorAlarm;
    ELSIF s_iInConveyorAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := s_iInConveyorAlarm;
    END_IF;
END_IF;

IF s_bPickPlaceAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := s_iInPickPlaceAlarm;
    ELSIF s_iInPickPlaceAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := s_iInPickPlaceAlarm;
    END_IF;
END_IF;

IF s_bFeederAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := s_iInFeederAlarm;
    ELSIF s_iInFeederAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := s_iInFeederAlarm;
    END_IF;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 6. 输出状态赋值                                                            *)
(* -------------------------------------------------------------------------- *)
s_iOutCurrentAlarmCode := s_iMinAlarmCode;
s_bOutAnyAlarmActive := s_bConveyorAlarmActive OR s_bPickPlaceAlarmActive OR s_bFeederAlarmActive;

s_arrStationAlarmStatus[1] := s_iInConveyorAlarm;
s_arrStationAlarmStatus[2] := s_iInPickPlaceAlarm;
s_arrStationAlarmStatus[3] := s_iInFeederAlarm;

s_bOutConveyorAlarmActive := s_bConveyorAlarmActive;
s_bOutPickPlaceAlarmActive := s_bPickPlaceAlarmActive;
s_bOutFeederAlarmActive := s_bFeederAlarmActive;

(* -------------------------------------------------------------------------- *)
(* 7. 新报警检测(上升沿检测)                                                  *)
(*    只检测报警从无到有的变化,避免报警解除时误触发                            *)
(* -------------------------------------------------------------------------- *)
s_bNewAlarmDetected := FALSE;

IF (s_iInConveyorAlarm <> ALM_NONE AND s_iPrevConveyorAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;
IF (s_iInPickPlaceAlarm <> ALM_NONE AND s_iPrevPickPlaceAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;
IF (s_iInFeederAlarm <> ALM_NONE AND s_iPrevFeederAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;

s_bOutNewAlarmFlag := s_bNewAlarmDetected AND s_bOutAnyAlarmActive;

(* -------------------------------------------------------------------------- *)
(* 8. MES报警队列管理                                                          *)
(*    维护最近10条报警记录,支持去重存储,队列满时自动覆盖最旧记录              *)
(* -------------------------------------------------------------------------- *)
(* 8.1 报警计数: 仅在新报警(上升沿)时递增, 避免每周期重复计数 *)
	IF s_bNewAlarmDetected THEN
	    s_iAlarmCount := s_iAlarmCount + 1;
	    s_iOutMesAlarmCount := s_iAlarmCount;
	END_IF;

	(* 8.2 报警队列管理: 报警激活时维护 *)
	IF s_bOutAnyAlarmActive THEN
	    s_bAlarmExistsInQueue := FALSE;
    
    (* 检查报警码是否已存在于队列中(去重) *)
    FOR s_iQueueScanIndex := 1 TO QUEUE_SIZE DO
        IF s_arrMesAlarmQueue[s_iQueueScanIndex] = s_iOutCurrentAlarmCode THEN
            s_bAlarmExistsInQueue := TRUE;
            EXIT;
        END_IF;
    END_FOR;
    
    (* 如果报警码不存在于队列中,则加入队列 *)
    IF NOT s_bAlarmExistsInQueue THEN
        (* 写入前再保护一次下标范围, 防止下标被意外改写后越界 *)
        IF s_iQueueTailIndex < 1 OR s_iQueueTailIndex > QUEUE_SIZE THEN
            s_iQueueTailIndex := 1;
        END_IF;
        s_arrMesAlarmQueue[s_iQueueTailIndex] := s_iOutCurrentAlarmCode;
        s_iQueueTailIndex := s_iQueueTailIndex + 1;
        
        (* 循环队列处理 *)
        IF s_iQueueTailIndex > QUEUE_SIZE THEN
            s_iQueueTailIndex := 1;
            s_bQueueFull := TRUE;
        ELSE
            s_bQueueFull := FALSE;
        END_IF;
    END_IF;
END_IF;


(* -------------------------------------------------------------------------- *)
(* 9. 保存当前状态用于下一周期比较                                              *)
(*    注意:必须在功能块末尾保存,确保读取的是当前周期计算后的有效值            *)
(* -------------------------------------------------------------------------- *)
s_wPrevGlobalAlarmWord := s_wOutGlobalAlarmWord;

(* ==================== 结构体封包 (输出映射) ==================== *)
io_stGlobal.o_wGlobalAlarmWord       := s_wOutGlobalAlarmWord;
io_stGlobal.o_iCurrentAlarmCode      := s_iOutCurrentAlarmCode;
io_stGlobal.o_bAnyAlarmActive        := s_bOutAnyAlarmActive;
io_stGlobal.o_iMESAlarmCount         := s_iOutMesAlarmCount;
io_stGlobal.o_bNewAlarmFlag          := s_bOutNewAlarmFlag;
io_stGlobal.o_bConveyorAlarmActive   := s_bOutConveyorAlarmActive;
io_stGlobal.o_bPickPlaceAlarmActive  := s_bOutPickPlaceAlarmActive;
io_stGlobal.o_bFeederAlarmActive     := s_bOutFeederAlarmActive;

END_FUNCTION_BLOCK