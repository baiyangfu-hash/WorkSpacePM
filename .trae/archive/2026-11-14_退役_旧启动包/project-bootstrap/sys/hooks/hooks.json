{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/scripts/session-start.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/scripts/agent-stop.ps1",
        "cwd": ".",
        "timeoutSec": 10,
        "env": {
          "PROJECT_TYPE": "sys",
          "VERIFY_HINT": "SYS治理项目：结束前确认 PM_SESSION 已回写，并补充风险、边界与下一步。"
        }
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/scripts/session-end.ps1",
        "cwd": ".",
        "timeoutSec": 10,
        "env": {
          "PROJECT_TYPE": "sys",
          "VERIFY_HINT": "SYS治理项目：优先补写 verification_log，并确认风险台账与准入规则是否更新。",
          "DRAFT_SUBDIR": ".trae/handoffs"
        }
      }
    ]
  }
}
