{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/scripts/session-start.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/scripts/agent-stop.ps1",
        "cwd": ".",
        "timeoutSec": 10,
        "env": {
          "PROJECT_TYPE": "plc",
          "VERIFY_HINT": "PLC 项目：结束前确认 PM_SESSION 已回写，并明确哪些内容仅完成文档/源码核对，哪些仍需编译、现场和人工复核。"
        }
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/scripts/session-end.ps1",
        "cwd": ".",
        "timeoutSec": 10,
        "env": {
          "PROJECT_TYPE": "plc",
          "VERIFY_HINT": "PLC 项目：优先补写 verification_log，并明确 TIA 编译、LSP 诊断、现场验证和安全相关人工复核状态。",
          "DRAFT_SUBDIR": ".trae/handoffs"
        }
      }
    ]
  }
}
